---
interface Props {
  quote: string;
  attribution?: string | null;
}

const { quote, attribution } = Astro.props;
---

{/*
  `<figure>` with a `<figcaption>` rather than putting the attribution inside the blockquote:
  the citation is about the quote, not part of what was said.
*/}
<figure class="quote">
  <blockquote>
    <p>{quote}</p>
  </blockquote>
  {attribution && <figcaption>— {attribution}</figcaption>}
</figure>

<style>
  .quote {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 4px solid var(--accent);
  }
  .quote blockquote {
    margin: 0;
  }
  .quote p {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .quote figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
