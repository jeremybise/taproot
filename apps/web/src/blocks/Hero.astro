---
import { getTaproot } from '@taproot/studio/runtime/guards';
import { TaprootImage } from '@taproot/studio/components';

/**
 * A block template.
 *
 * Taproot stores what a block *is* — a type name and validated field values — and has no opinion
 * about what it looks like. The props are the block type's fields, by `api_id`, exactly as an
 * editor filled them in.
 */
interface Props {
  heading: string;
  lead?: string | null;
  /** A media id, resolved to a row here because the storage adapter only exists on the server. */
  image?: string | null;
}

const { heading, lead, image } = Astro.props;
const taproot = getTaproot(Astro.locals);

/**
 * The crop columns come back too, not just the storage key.
 *
 * This used to select only `storage_key` and `alt_text` and render a plain `<img>` under
 * `object-fit: cover`, which centre-crops — so the focal point an editor had set was discarded at
 * exactly the shape it was set for. `TaprootImage` needs the dimensions and the hotspot to resolve
 * the rectangle.
 */
const asset = image
  ? await taproot.db.db
      .selectFrom('media')
      .select([
        'storage_key',
        'alt_text',
        'width',
        'height',
        'hotspot_x',
        'hotspot_y',
        'crop_top',
        'crop_right',
        'crop_bottom',
        'crop_left',
      ])
      .where('id', '=', image)
      .executeTakeFirst()
  : undefined;
---

<section class="hero">
  {
    asset && (
      /* Decorative: the heading beside it carries the meaning, and repeating it as alt text would
         make a screen reader announce the same words twice. A hero image that genuinely conveyed
         something would want its alt text instead. */
      <TaprootImage asset={asset} ratio={16 / 5} alt="" class="hero-image" />
    )
  }
  <div>
    {/* h2, not h1: the page title is the h1, and a second one breaks the document outline. */}
    <h2>{heading}</h2>
    {lead && <p>{lead}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-radius: 0.5rem;
    overflow: hidden;
    margin: 2rem 0;
    background: color-mix(in oklch, var(--accent) 12%, transparent);
  }
  /*
    The height comes from the aspect ratio now rather than a fixed 14rem. A fixed height plus a
    resolved crop would fight each other: the crop is computed for a shape, so the box has to be
    that shape or the image is letterboxed inside its own frame.
  */
  .hero :global(.hero-image) {
    display: block;
    width: 100%;
  }
  .hero div {
    padding: 1.25rem 1.5rem;
  }
  .hero h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .hero p {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }
</style>
