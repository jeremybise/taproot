---
import { TaprootImage } from '@taproot/astro/components';
import type { DeliveryMedia } from '@taproot/astro';

/**
 * A block template.
 *
 * Taproot stores what a block *is* — a type name and validated field values — and has no opinion
 * about what it looks like. The props are the block type's fields, by `api_id`, exactly as an
 * editor filled them in.
 */
interface Props {
  heading: string;
  lead?: string | null;
  /** A media id. The asset itself arrives in the delivery response's `media` map. */
  image?: string | null;
  media?: Record<string, DeliveryMedia>;
}

const { heading, lead, image, media = {} } = Astro.props;

/**
 * Looked up, not queried.
 *
 * This used to reach into the database for the storage key and the crop columns, which a site on
 * another origin cannot do and should never be able to. The delivery API resolves every asset the
 * page references — including the ones inside blocks — into one map, so this is a lookup with no
 * request behind it.
 */
const asset = image ? media[image] : undefined;
---

<section class="hero">
  {
    asset && (
      /* Decorative: the heading beside it carries the meaning, and repeating it as alt text would
         make a screen reader announce the same words twice. A hero image that genuinely conveyed
         something would want its alt text instead. */
      <TaprootImage asset={asset} ratio={16 / 5} alt="" class="hero-image" />
    )
  }
  <div>
    {/* h2, not h1: the page title is the h1, and a second one breaks the document outline. */}
    <h2>{heading}</h2>
    {lead && <p>{lead}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-radius: 0.5rem;
    overflow: hidden;
    margin: 2rem 0;
    background: color-mix(in oklch, var(--accent) 12%, transparent);
  }
  /*
    The height comes from the aspect ratio rather than a fixed one. A fixed height plus a resolved
    crop would fight each other: the crop is computed for a shape, so the box has to be that shape
    or the image is letterboxed inside its own frame.
  */
  .hero :global(.hero-image) {
    display: block;
    width: 100%;
  }
  .hero div {
    padding: 1.25rem 1.5rem;
  }
  .hero h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .hero p {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }
</style>
