---
import { getTaproot } from '@taproot/astro/runtime/guards';
import { TaprootImage } from '@taproot/astro/components';

/**
 * A block template.
 *
 * Taproot stores what a block *is* — a type name and validated field values — and has no opinion
 * about what it looks like. The props are the block type's fields, by `api_id`.
 */
interface Props {
  /** Media ids in the order the editor arranged them. */
  images?: string[] | null;
  caption?: string | null;
}

const { images, caption } = Astro.props;
const taproot = getTaproot(Astro.locals);

const ids = Array.isArray(images) ? images : [];

// One query for the whole gallery, and it selects the crop columns because `TaprootImage` resolves
// the focal point per image rather than centre-cropping all of them alike.
const rows = ids.length
  ? await taproot.db.db
      .selectFrom('media')
      .select([
        'id',
        'storage_key',
        'alt_text',
        'width',
        'height',
        'hotspot_x',
        'hotspot_y',
        'crop_top',
        'crop_right',
        'crop_bottom',
        'crop_left',
      ])
      .where('id', 'in', ids)
      .execute()
  : [];

/**
 * Ordered by the stored list, not by whatever order the database returned.
 *
 * `where in` gives no ordering guarantee, and the editor's arrangement is the whole point of the
 * field's move buttons — losing it here would make them look broken.
 */
const assets = ids
  .map((id) => rows.find((row) => row.id === id))
  .filter((row): row is (typeof rows)[number] => Boolean(row));
---

{
  assets.length > 0 && (
    <figure class="gallery">
      <ul>
        {assets.map((asset) => (
          <li>
            {/* Alt text comes from the media library, where it is authored once and reused
                everywhere the asset appears — `TaprootImage` reads it from the row unless a call
                site overrides it, and an empty string stays an empty string. */}
            <TaprootImage asset={asset} ratio={4 / 3} class="gallery-image" />
          </li>
        ))}
      </ul>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .gallery {
    margin: 2rem 0;
  }
  .gallery ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /*
    The 4:3 box is the component's, from the ratio it was given — the same number that resolved the
    crop. Setting `aspect-ratio` here as well would let the two drift, and the image would be
    letterboxed inside a frame of a shape it was not cropped for.
  */
  .gallery :global(.gallery-image) {
    border-radius: 0.375rem;
  }
  .gallery figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
