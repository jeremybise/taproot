---
import { TaprootImage } from '@taproot/astro/components';
import type { DeliveryMedia } from '@taproot/astro';

/**
 * A block template.
 *
 * Taproot stores what a block *is* — a type name and validated field values — and has no opinion
 * about what it looks like. The props are the block type's fields, by `api_id`.
 */
interface Props {
  /** Media ids in the order the editor arranged them. */
  images?: string[] | null;
  caption?: string | null;
  media?: Record<string, DeliveryMedia>;
}

const { images, caption, media = {} } = Astro.props;

const ids = Array.isArray(images) ? images : [];

/**
 * Mapped in the stored order, which is the editor's arrangement.
 *
 * That order is the whole point of the field's move buttons, and it survives here for free now:
 * the ids come back in order and the map is keyed by id, where the old database query needed an
 * explicit re-sort because `where in` gives no ordering guarantee.
 */
const assets = ids
  .map((id) => media[id])
  .filter((asset): asset is DeliveryMedia => Boolean(asset));
---

{
  assets.length > 0 && (
    <figure class="gallery">
      <ul>
        {assets.map((asset) => (
          <li>
            {/* Alt text comes from the media library, where it is authored once and reused
                everywhere the asset appears — `TaprootImage` reads it from the asset unless a call
                site overrides it, and an empty string stays an empty string. */}
            <TaprootImage asset={asset} ratio={4 / 3} class="gallery-image" />
          </li>
        ))}
      </ul>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .gallery {
    margin: 2rem 0;
  }
  .gallery ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /*
    The 4:3 box is the component's, from the ratio it was given — the same number that resolved the
    crop. Setting `aspect-ratio` here as well would let the two drift, and the image would be
    letterboxed inside a frame of a shape it was not cropped for.
  */
  .gallery :global(.gallery-image) {
    border-radius: 0.375rem;
  }
  .gallery figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
