---
import { getTaproot } from '@taproot/astro/runtime/guards';

/**
 * A block template.
 *
 * Taproot stores what a block *is* — a type name and validated field values — and has no opinion
 * about what it looks like. The props are the block type's fields, by `api_id`.
 */
interface Props {
  /** Media ids in the order the editor arranged them. */
  images?: string[] | null;
  caption?: string | null;
}

const { images, caption } = Astro.props;
const taproot = getTaproot(Astro.locals);

const ids = Array.isArray(images) ? images : [];

const rows = ids.length
  ? await taproot.db.db
      .selectFrom('media')
      .select(['id', 'storage_key', 'alt_text'])
      .where('id', 'in', ids)
      .execute()
  : [];

/**
 * Ordered by the stored list, not by whatever order the database returned.
 *
 * `where in` gives no ordering guarantee, and the editor's arrangement is the whole point of the
 * field's move buttons — losing it here would make them look broken.
 */
const assets = ids
  .map((id) => rows.find((row) => row.id === id))
  .filter((row): row is (typeof rows)[number] => Boolean(row));
---

{
  assets.length > 0 && (
    <figure class="gallery">
      <ul>
        {assets.map((asset) => (
          <li>
            {/* Alt text comes from the media library, where it is authored once and reused
                everywhere the asset appears. An empty string is the correct value for an image
                the editor marked decorative, so it is passed through rather than defaulted. */}
            <img
              src={taproot.storage.publicUrl(asset.storage_key)}
              alt={asset.alt_text ?? ''}
              loading="lazy"
            />
          </li>
        ))}
      </ul>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .gallery {
    margin: 2rem 0;
  }
  .gallery ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.375rem;
  }
  .gallery figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
