---
import { TaprootEmbed } from '@taprootcms/astro/components';
import type { EmbedValue } from '@taprootcms/astro';

/**
 * A block template for a video.
 *
 * The frame's `sandbox`, `title` and `referrerpolicy` come from `TaprootEmbed` rather than from
 * here, which is the whole reason the component exists: a site that hand-wrote `<iframe src={…}>`
 * would get the storage safety and none of the rendering safety.
 */
interface Props {
  video?: EmbedValue | null;
  caption?: string | null;
}

const { video, caption } = Astro.props;
---

{
  video?.url && (
    <figure class="video">
      {/*
        The ratio is stated here because this template is what decides the shape a video takes on
        this site — the field's `sizing` records what the admin configured, and a template is free
        to be more specific. 16:9 is what the block type is for.
      */}
      <TaprootEmbed
        embed={video}
        sizing={{ mode: 'ratio', ratio: 16 / 9 }}
        allow="encrypted-media; picture-in-picture"
        class="video-frame"
      />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .video {
    margin: 2rem 0;
  }
  .video :global(.video-frame) {
    border-radius: 0.375rem;
    overflow: hidden;
  }
  .video figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
