---
interface Props {
  text: string;
  link_label: string;
  link_href: string;
}

const { text, link_label, link_href } = Astro.props;

/**
 * External links open in a new tab and say so.
 *
 * `rel="noopener"` because a target without it hands the opened page a reference back through
 * `window.opener`, and the visually hidden suffix because a link that changes context without
 * warning is a WCAG 3.2.5 problem.
 */
const isExternal = /^https?:\/\//i.test(link_href);
---

<aside class="cta">
  <p>{text}</p>
  <a href={link_href} {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}>
    {link_label}
    {isExternal && <span class="skip"> (opens in a new tab)</span>}
  </a>
</aside>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
  }
  .cta p {
    margin: 0;
    font-weight: 600;
  }
  .cta a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    background: var(--accent);
    color: var(--paper);
    text-decoration: none;
    font-weight: 600;
  }
</style>
