---
import { resolveMenu, termArchivePath } from '@taproot/core';
import { getTaproot } from '@taproot/astro/runtime/guards';
import { PUBLIC_TERM_TAXONOMIES } from '../site.ts';

interface Props {
  title: string;
  description?: string | null;
  breadcrumbs?: { label: string; href: string }[];
}

const { title, description, breadcrumbs = [] } = Astro.props;

/**
 * The site navigation, resolved from the `main` menu on every request.
 *
 * Published-only by default, so an unpublished page leaves the navigation without anyone editing
 * the menu, and a moved page keeps its place because the menu stores a reference rather than a
 * URL. An empty or missing menu renders no nav at all rather than an empty landmark.
 */
const taproot = getTaproot(Astro.locals);
const nav = await resolveMenu(taproot.db.db, 'main', {
  // This site's answer to "which terms have a public page". Taproot has no opinion — see site.ts.
  termHref: (term) =>
    PUBLIC_TERM_TAXONOMIES.has(term.taxonomyApiId)
      ? termArchivePath(term.taxonomyApiId, term.slug)
      : null,
});

const path = Astro.url.pathname;
const isCurrent = (href: string | null) => href !== null && path === href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Riverbend College</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      :root {
        --ink: #1a1d1b;
        --paper: #fbfaf8;
        --muted: #5c625e;
        --rule: #e0ded9;
        --accent: #2f6b4f;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #eceae6;
          --paper: #16181a;
          --muted: #a2a8a4;
          --rule: #2e3234;
          --accent: #7fc9a2;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      .wrap {
        max-width: 46rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      a {
        color: var(--accent);
      }
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .skip:not(:focus) {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }
      header.site {
        border-bottom: 1px solid var(--rule);
        padding: 1.25rem 0;
      }
      header.site a.brand {
        font-weight: 600;
        text-decoration: none;
        color: var(--ink);
      }
      nav.primary {
        margin-top: 0.75rem;
      }
      nav.primary ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        margin: 0;
        padding: 0;
        font-size: 0.9375rem;
      }
      nav.primary ul.sub {
        gap: 0 0.875rem;
        margin-top: 0.125rem;
        font-size: 0.8125rem;
      }
      nav.primary a {
        text-decoration: none;
      }
      nav.primary a:hover {
        text-decoration: underline;
      }
      nav.primary a[aria-current='page'] {
        color: var(--ink);
        font-weight: 600;
      }
      nav.crumbs {
        font-size: 0.875rem;
        color: var(--muted);
        margin: 1.5rem 0 0;
      }
      nav.crumbs ol {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
      }
      main {
        padding: 0 0 4rem;
      }
      h1 {
        font-size: 2rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin: 1.5rem 0 0.5rem;
      }
      footer.site {
        border-top: 1px solid var(--rule);
        padding: 1.5rem 0;
        font-size: 0.875rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip">Skip to main content</a>

    <header class="site">
      <div class="wrap">
        <a href="/" class="brand">Riverbend College</a>

        {
          nav.length > 0 && (
            <nav class="primary" aria-label="Main">
              <ul>
                {nav.map((entry) => (
                  <li>
                    <a
                      href={entry.href!}
                      aria-current={isCurrent(entry.href) ? 'page' : undefined}
                      {...(entry.openInNewTab ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      {entry.label}
                      {entry.openInNewTab && (
                        <span class="skip"> (opens in a new tab)</span>
                      )}
                    </a>
                    {/*
                      Nested entries render as a plain sublist rather than a hover dropdown.
                      A dropdown needs real keyboard and focus handling to meet AA, and a menu
                      that is simply visible needs none of it.
                    */}
                    {entry.children.length > 0 && (
                      <ul class="sub">
                        {entry.children.map((child) => (
                          <li>
                            <a
                              href={child.href!}
                              aria-current={isCurrent(child.href) ? 'page' : undefined}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    <div class="wrap">
      {
        breadcrumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              {breadcrumbs.map((crumb, index) => (
                <li>
                  {index > 0 && <span aria-hidden="true">/ </span>}
                  <a href={crumb.href}>{crumb.label}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="site">
      <div class="wrap">
        Demo site for Taproot · <a href="/admin">Admin</a>
      </div>
    </footer>
  </body>
</html>
