---
import type { MenuLink } from '@taprootcms/astro';

interface Props {
  title: string;
  description?: string | null;
  /**
   * The site navigation, fetched by the **page** and passed in.
   *
   * This layout used to fetch it itself, which read better and cost every visitor a serial round
   * trip. Astro runs a page's frontmatter to completion before the layout's, so `await taproot.menu()`
   * here could not start until `await taproot.resolve()` up there had finished — two hops to the CMS
   * one after the other, on every page view, for two requests that have nothing to do with each
   * other. Fetching in the page lets them go out together under one `Promise.all`.
   *
   * Required rather than optional-with-a-fallback. An optional prop would leave the serial path in
   * place for anyone who omitted it, and it would be omitted exactly by whoever had not read this
   * comment — the same argument as there being one preview control rather than two.
   */
  nav: MenuLink[];
  breadcrumbs?: { label: string; href: string }[];
  /** Absolute URL of the social card image. Relative URLs are ignored by every crawler. */
  ogImage?: string | null;
  ogImageAlt?: string | null;
  /** Absolute URL this page should be indexed under. */
  canonical?: string | null;
  noIndex?: boolean;
}

const {
  title,
  description,
  nav,
  breadcrumbs = [],
  ogImage = null,
  ogImageAlt = null,
  canonical = null,
  noIndex = false,
} = Astro.props;

const siteName = 'Riverbend College';
// The `<title>` carries the site name; `og:title` does not, because platforms render the site name
// separately underneath and would otherwise show it twice.
const pageTitle = `${title} · ${siteName}`;

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      /*
        `noindex` also carries `nofollow`, which is the pair that stops a hidden page leaking its
        links into an index. This is a request crawlers honour, not access control — the page is
        still served to anyone who asks for it, and the admin says so where the box is ticked.
      */
      noIndex && <meta name="robots" content="noindex, nofollow" />
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          {/* Alt travels with the card: a shared link is an image in someone's timeline, and it
              needs a text alternative there exactly as it would on the page. */}
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }
    {/* Twitter reads the og:* tags for everything except the card shape. */}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <style is:global>
      :root {
        --ink: #1a1d1b;
        --paper: #fbfaf8;
        --muted: #5c625e;
        --rule: #e0ded9;
        --accent: #2f6b4f;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #eceae6;
          --paper: #16181a;
          --muted: #a2a8a4;
          --rule: #2e3234;
          --accent: #7fc9a2;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      .wrap {
        max-width: 46rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      a {
        color: var(--accent);
      }
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .skip:not(:focus) {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }
      header.site {
        border-bottom: 1px solid var(--rule);
        padding: 1.25rem 0;
      }
      header.site a.brand {
        font-weight: 600;
        text-decoration: none;
        color: var(--ink);
      }
      header.site .wrap {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1rem;
      }
      .site-links {
        display: flex;
        gap: 1rem;
        font-size: 0.9375rem;
      }
      .site-links a {
        text-decoration: none;
      }
      .site-links a:hover {
        text-decoration: underline;
      }
      nav.primary {
        margin-top: 0.75rem;
        /* The nav takes the whole second row, so the brand and the search link share the first. */
        flex-basis: 100%;
      }
      nav.primary ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        margin: 0;
        padding: 0;
        font-size: 0.9375rem;
      }
      nav.primary ul.sub {
        gap: 0 0.875rem;
        margin-top: 0.125rem;
        font-size: 0.8125rem;
      }
      nav.primary a {
        text-decoration: none;
      }
      nav.primary a:hover {
        text-decoration: underline;
      }
      nav.primary a[aria-current='page'] {
        color: var(--ink);
        font-weight: 600;
      }
      nav.crumbs {
        font-size: 0.875rem;
        color: var(--muted);
        margin: 1.5rem 0 0;
      }
      nav.crumbs ol {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
      }
      main {
        padding: 0 0 4rem;
      }
      h1 {
        font-size: 2rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin: 1.5rem 0 0.5rem;
      }
      footer.site {
        border-top: 1px solid var(--rule);
        padding: 1.5rem 0;
        font-size: 0.875rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip">Skip to main content</a>

    <header class="site">
      <div class="wrap">
        <a href="/" class="brand">Riverbend College</a>
        {
          /*
            Beside the navigation rather than in it. The menu's entries come from the CMS and
            reference content items; `/search` and `/directory` are routes this site serves itself,
            so putting them in the menu would mean an editor could remove the only way to reach a
            page the CMS does not know exists — and could not put it back, because there is nothing
            there to point at.
          */
        }
        <span class="site-links">
          <a href="/directory">Directory</a>
          <a href="/search">Search</a>
        </span>

        {
          nav.length > 0 && (
            <nav class="primary" aria-label="Main">
              <ul>
                {nav.map((entry) => (
                  <li>
                    <a
                      href={entry.href}
                      aria-current={isCurrent(entry.href) ? 'page' : undefined}
                      {...(entry.openInNewTab ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      {entry.label}
                      {entry.openInNewTab && (
                        <span class="skip"> (opens in a new tab)</span>
                      )}
                    </a>
                    {/*
                      Nested entries render as a plain sublist rather than a hover dropdown.
                      A dropdown needs real keyboard and focus handling to meet AA, and a menu
                      that is simply visible needs none of it.
                    */}
                    {entry.children.length > 0 && (
                      <ul class="sub">
                        {entry.children.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              aria-current={isCurrent(child.href) ? 'page' : undefined}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    <div class="wrap">
      {
        breadcrumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              {breadcrumbs.map((crumb, index) => (
                <li>
                  {index > 0 && <span aria-hidden="true">/ </span>}
                  <a href={crumb.href}>{crumb.label}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="site">
      <div class="wrap">
        Demo site for Taproot — a reference consumer reading content over HTTP
      </div>
    </footer>
  </body>
</html>
