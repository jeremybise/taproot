---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  ancestorPaths,
  canonicalUrl,
  getContentType,
  getItemByPath,
  getRedirect,
  getChildren,
  getTaxonomyByApiId,
  itemIdsInTermBranch,
  listItems,
  normalizePath,
  resolveItemBlocks,
  resolveSeo,
} from '@taproot/core';
import { getTaproot, canEditContent } from '@taproot/astro/runtime/guards';
import { BlockRenderer } from '@taproot/astro/components';
import { PUBLIC_TERM_TAXONOMIES } from '../site.ts';
import { BLOCK_COMPONENTS } from '../blocks/index.ts';

export const prerender = false;

/**
 * The public catch-all route.
 *
 * Resolution order matters:
 *   1. One indexed lookup on `content_items.path`.
 *   2. A term archive at `/{taxonomy}/{term}` — see `termArchivePath` in core, which is what menu
 *      links to terms are built from.
 *   3. If nothing matches, check the redirect table — this is what makes moved pages keep working.
 *   4. Otherwise 404.
 *
 * A term archive beats a redirect deliberately. A redirect exists because content moved *away*
 * from a path; a live page now occupying it should win, which is the same rule that makes a
 * cascading move delete redirects leaving from a path it has just filled.
 *
 * Because content is served from the database rather than a static build, publishing takes effect
 * on the next request; there is no rebuild step between an editor saving and a visitor seeing it.
 */
const taproot = getTaproot(Astro.locals);
const path = normalizePath(`/${Astro.params.path ?? ''}`);

/**
 * Preview mode.
 *
 * `?preview=1` renders unpublished content, but only for a signed-in user who could edit it
 * anyway — the check is on the session, not on the query parameter, so the URL is not a way for
 * anyone else to read drafts. Anonymous visitors get the published item or a 404 as usual.
 */
const previewRequested = Astro.url.searchParams.get('preview') === '1';
const isPreview = previewRequested && canEditContent(taproot.user);

const item = await getItemByPath(taproot.db.db, path, { publishedOnly: !isPreview });

/**
 * Term archive: everything filed under a term, including its descendants.
 *
 * This site's choice, not Taproot's — only the taxonomies in `PUBLIC_TERM_TAXONOMIES` get pages,
 * and the menu resolver in SiteLayout reads the same set so a link can never point somewhere this
 * route declines to serve.
 *
 * Only attempted when no content item claims the path, so a real page always wins — which is what
 * keeps this from being a reserved prefix nobody may use.
 */
let archive: { title: string; description: string | null; items: { title: string; path: string }[] } | null =
  null;

if (!item) {
  const segments = path.split('/').filter(Boolean);
  if (segments.length === 2 && PUBLIC_TERM_TAXONOMIES.has(segments[0]!)) {
    const taxonomy = await getTaxonomyByApiId(taproot.db.db, segments[0]!);
    if (taxonomy) {
      const term = await taproot.db.db
        .selectFrom('terms')
        .selectAll()
        .where('taxonomy_id', '=', taxonomy.id)
        .where('slug', '=', segments[1]!)
        .executeTakeFirst();

      if (term) {
        const taggedIds = new Set(await itemIdsInTermBranch(taproot.db.db, term.id));
        // Filtered rather than queried by id so status and ordering stay the service's business.
        const { items: published } = await listItems(taproot.db.db, {
          status: 'published',
          limit: 200,
        });

        archive = {
          title: term.name,
          description: term.description,
          items: published
            .filter((candidate) => taggedIds.has(candidate.id))
            .map((candidate) => ({ title: candidate.title, path: candidate.path })),
        };
      }
    }
  }
}

if (!item && !archive) {
  const redirect = await getRedirect(taproot.db.db, path);
  if (redirect) {
    return Astro.redirect(redirect.to, redirect.status === 302 ? 302 : 301);
  }
  return new Response('Not found', { status: 404 });
}

// Drafts must never be cached or indexed, even briefly.
if (isPreview) {
  Astro.response.headers.set('cache-control', 'no-store');
  Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
}

// Everything below is item-specific. An archive request has no content item, so the reads are
// skipped rather than guarded one by one further down.
const contentType = item ? await getContentType(taproot.db.db, item.content_type_id) : undefined;
const children = item ? await getChildren(taproot.db.db, item.id) : [];
const publishedChildren = children.filter((child) => child.status === 'published');

// Build breadcrumbs from the materialised path — no extra tree walk needed.
const crumbs = item
  ? await Promise.all(
      ancestorPaths(item.path).map(async (ancestorPath) => {
        const ancestor = await getItemByPath(taproot.db.db, ancestorPath);
        return ancestor ? { label: ancestor.title, href: ancestor.path } : null;
      }),
    )
  : [];

const breadcrumbs = [{ label: 'Home', href: '/' }, ...crumbs.filter((c) => c !== null)];

// Render fields in the order the content type defines them, so the page follows the schema rather
// than JSON key order.
const renderable = (contentType?.fields ?? [])
  .filter((field) => ['text', 'richtext', 'number', 'date', 'select', 'boolean'].includes(field.type))
  .map((field) => ({ field, value: item?.data[field.api_id] }))
  .filter((entry) => entry.value !== undefined && entry.value !== null && entry.value !== '');

/**
 * Block fields, rendered through the site's own templates.
 *
 * The map is the whole contract between Taproot and this site: the CMS stores a block's type and
 * its validated field values, and the site decides what each type looks like. A block type with no
 * entry here renders nothing in production and a visible note in development.
 */
const blockFields = (contentType?.fields ?? []).filter((field) => field.type === 'block');

/**
 * Reusable blocks are resolved here, not stored on the page.
 *
 * A page that references a library entry stores only the reference, so its content has to be
 * fetched at render. Doing it in core rather than in this template means the admin editor resolves
 * the same way — a preview showing different shared content from the live page would be a preview
 * of something that does not exist.
 */
const blockData = item
  ? await resolveItemBlocks(taproot.db.db, contentType?.fields ?? [], item.data)
  : {};

if (!isPreview) {
  Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
}

/**
 * SEO, resolved through the same core function the admin's preview calls.
 *
 * That shared call is the whole point: a preview that resolved its own fallbacks would be a
 * preview of a page that does not exist, and the mismatch would only surface weeks later in
 * someone's shared link.
 */
const seo = item ? resolveSeo(item, contentType) : null;

// The social image needs an absolute URL — a relative one is ignored by every crawler — and the
// storage adapter is the only thing that knows how to build one.
const ogAsset = seo?.ogImageId
  ? await taproot.db.db
      .selectFrom('media')
      .select(['storage_key', 'alt_text'])
      .where('id', '=', seo.ogImageId)
      .executeTakeFirst()
  : undefined;

const ogImage = ogAsset
  ? new URL(taproot.storage.publicUrl(ogAsset.storage_key), Astro.url.origin).toString()
  : null;

/**
 * A preview is never canonical and never indexed.
 *
 * Without this, `?preview=1` would emit a canonical pointing at the live URL of content that is
 * not live — telling a crawler that a draft is the authoritative version of a page.
 */
const canonical = isPreview ? null : canonicalUrl(Astro.url.origin, item ? item.path : path);
const noIndex = isPreview || seo?.noIndex === true;
---

<SiteLayout
  title={seo ? seo.title : archive!.title}
  description={seo ? seo.description : archive!.description}
  breadcrumbs={breadcrumbs}
  ogImage={ogImage}
  ogImageAlt={ogAsset?.alt_text ?? null}
  canonical={canonical}
  noIndex={noIndex}
>
  {
    archive && (
      <article>
        <h1>{archive.title}</h1>
        {archive.description && <p>{archive.description}</p>}

        {archive.items.length === 0 ? (
          <p>Nothing is filed under this yet.</p>
        ) : (
          <ul>
            {archive.items.map((entry) => (
              <li>
                <a href={entry.path}>{entry.title}</a>
              </li>
            ))}
          </ul>
        )}
      </article>
    )
  }

  {
    item && isPreview && item.status !== 'published' && (
      <p
        style="border:1px solid var(--accent);background:color-mix(in oklch, var(--accent) 12%, transparent);padding:0.75rem 1rem;border-radius:0.375rem;margin:1.5rem 0 0"
        role="status"
      >
        <strong>Preview.</strong> This {item.status.replace('_', ' ')} content is not visible to
        visitors.
      </p>
    )
  }

  {item && (
  <article>
    <h1>{item.title}</h1>

    {
      renderable.map(({ field, value }) => (
        <section>
          {field.type === 'richtext' ? (
            <div set:html={String(value)} />
          ) : field.type === 'boolean' ? (
            <p>
              <strong>{field.label}:</strong> {value ? 'Yes' : 'No'}
            </p>
          ) : field.type === 'text' && field.api_id === 'body' ? (
            <p style="white-space:pre-wrap">{String(value)}</p>
          ) : (
            <p>
              <strong>{field.label}:</strong> {String(value)}
            </p>
          )}
        </section>
      ))
    }

    {
      blockFields.map((field) => (
        <BlockRenderer blocks={blockData[field.api_id]} components={BLOCK_COMPONENTS} />
      ))
    }

    {
      publishedChildren.length > 0 && (
        <nav aria-labelledby="subpages">
          <h2 id="subpages">In this section</h2>
          <ul>
            {publishedChildren.map((child) => (
              <li>
                <a href={child.path}>{child.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
  )}
</SiteLayout>
