---
import SiteLayout from '../layouts/SiteLayout.astro';
import { BlockRenderer, TaprootImage, TaprootPreviewBridge } from '@taprootcms/astro/components';
import { PREVIEW_PARAM } from '@taprootcms/astro';
import { taproot, PUBLIC_TERM_TAXONOMIES } from '../taproot.ts';
import { BLOCK_COMPONENTS } from '../blocks/index.ts';

export const prerender = false;

/**
 * The public catch-all route.
 *
 * **One HTTP request.** This used to make twelve-plus database queries per page — the item, its
 * type, its children, one lookup per ancestor for breadcrumbs, the blocks, an og:image row, the
 * redirect fallback — which was fine against a local database and would have been indefensible as
 * twelve round trips to another origin. `resolve` answers all of it at once.
 *
 * Resolution order is the CMS's, not this site's: an item wins over a redirect, because a redirect
 * exists to say content moved *away* from a path and a live page now occupying it should be served.
 * What remains this site's decision is the term archive below, and only because Taproot has no
 * opinion about whether a taxonomy's terms have public pages.
 */
const path = `/${Astro.params.path ?? ''}`.replace(/\/{2,}/g, '/').replace(/(.)\/$/, '$1');

/**
 * A preview token, forwarded to the CMS untouched.
 *
 * This site cannot judge it — it has no session and no database — so it hands it back and lets the
 * CMS decide. That is the whole shape of cross-origin preview: the capability lives in the token,
 * and the token is only ever issued by the admin to somebody already allowed to see the content.
 */
const previewToken = Astro.url.searchParams.get(PREVIEW_PARAM);

const result = await taproot.resolve(path, { previewToken });

/**
 * A redirect arrives as data rather than as a 30x, and is reissued here.
 *
 * The CMS cannot redirect this site's visitor — it is answering a server-side fetch, and a real 30x
 * would have been followed by that fetch and returned the wrong page's content under the requested
 * URL. So the status travels in the payload and the redirect happens on this origin.
 */
if (result.kind === 'redirect') {
  return Astro.redirect(result.to, result.status === 302 ? 302 : 301);
}

/**
 * Term archives: everything filed under a term, including its descendants.
 *
 * This site's feature, not Taproot's. Only taxonomies in `PUBLIC_TERM_TAXONOMIES` get pages, and
 * the menu resolver reads the same set, so a link can never point somewhere this route declines to
 * serve. Attempted only when no content item claims the path, so a real page always wins — which is
 * what keeps this from being a reserved prefix nobody may use.
 */
let archive: { title: string; items: { title: string; path: string }[] } | null = null;

if (result.kind === 'not_found') {
  const segments = path.split('/').filter(Boolean);
  if (segments.length === 2 && PUBLIC_TERM_TAXONOMIES.has(segments[0]!)) {
    /**
     * The slug from the URL, resolved by the CMS along with the listing.
     *
     * `taxonomy` is what lets `term` be a slug rather than an id — a URL carries the former and the
     * database keys on the latter, and translating it here would cost a second round trip on the
     * endpoint that exists to avoid them. The response carries the term's real name back, so the
     * heading is "Student Services" rather than an un-slugified "student services".
     *
     * The filter expands to the whole branch server-side, so filing something under "Biology" finds
     * it when a visitor browses "Sciences".
     */
    const found = await taproot
      .items({ taxonomy: segments[0]!, term: segments[1]!, limit: 200 })
      .catch(() => null);

    // An empty archive is still a page: the term exists, nothing is filed under it yet, and saying
    // so is more useful than a 404 that suggests the URL is wrong.
    if (found?.term) {
      archive = {
        title: found.term.name,
        items: found.items.map((entry) => ({ title: entry.title, path: entry.path })),
      };
    }
  }

  if (!archive) return new Response('Not found', { status: 404 });
}

const item = result.kind === 'item' ? result.item : null;
const media = result.kind === 'item' ? result.media : {};
const breadcrumbTrail = result.kind === 'item' ? result.breadcrumbs : [];
const children = result.kind === 'item' ? result.children : [];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  ...breadcrumbTrail.map((crumb) => ({ label: crumb.title, href: crumb.path })),
];

// Render fields in the order the content type defines them, so the page follows the schema rather
// than JSON key order.
const renderable = (item?.fields ?? [])
  .filter((field) => ['text', 'richtext', 'number', 'date', 'select', 'boolean'].includes(field.type))
  .map((field) => ({ field, value: item?.data[field.apiId] }))
  .filter((entry) => entry.value !== undefined && entry.value !== null && entry.value !== '');

const blockFields = (item?.fields ?? []).filter((field) => field.type === 'block');

/**
 * The social image, already absolute.
 *
 * A relative URL is ignored by every crawler, and this site no longer knows where the CMS keeps its
 * files — so the delivery API resolves it. `ogImageId` is looked up in the media map rather than
 * inlined into the payload, which is what stops an image used twice being serialised twice.
 */
const ogAsset = item?.seo.ogImageId ? media[item.seo.ogImageId] : undefined;

/**
 * A preview is never canonical.
 *
 * Without this, a preview would emit a canonical pointing at the live URL of content that is not
 * live — telling a crawler that a draft is the authoritative version of the page.
 */
const canonical = item && !previewToken ? new URL(item.path, Astro.url.origin).toString() : null;

/**
 * A preview is never cached and never indexed.
 *
 * The CMS already says so on its own response, but this is a different origin serving a different
 * document — a shared cache in front of *this* site would otherwise hold a draft and serve it to
 * somebody with no token at all.
 */
if (previewToken) {
  Astro.response.headers.set('cache-control', 'no-store');
  Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

  /**
   * Framable by the CMS, and by nothing else.
   *
   * Nothing here needs this to *work* — Astro sends no framing headers and neither does Cloudflare,
   * so the split-view pane already frames this page. It is set anyway because "no header" and "only
   * the CMS" are different promises, and the second is the one worth making about a document
   * showing unpublished content.
   *
   * `frame-ancestors` rather than `X-Frame-Options`, which has no origin-list form at all:
   * `ALLOW-FROM` was never implemented in Chrome and is gone from the rest. Note the direction that
   * runs in — if a WAF or CDN in front of this app adds `X-Frame-Options`, it has to be removed
   * *there*, because a CSP here cannot loosen it. That is the usual reason a preview pane is blank.
   *
   * A site with a CSP of its own should add this directive to it rather than replacing the header;
   * `set` is right here only because this app sends none.
   */
  const cms = import.meta.env.TAPROOT_API_URL ?? process.env.TAPROOT_API_URL;
  if (cms) {
    Astro.response.headers.set(
      'content-security-policy',
      `frame-ancestors 'self' ${new URL(cms).origin}`,
    );
  }
} else {
  Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
}
---

<SiteLayout
  title={item ? item.seo.title : archive!.title}
  description={item?.seo.description ?? null}
  breadcrumbs={breadcrumbs}
  ogImage={ogAsset?.url ?? null}
  ogImageAlt={ogAsset?.alt ?? null}
  canonical={canonical}
  noIndex={Boolean(previewToken) || item?.seo.noIndex === true}
>
  {
    /*
      Two lines, and entirely optional.

      Without it the CMS's split-view pane still updates — it remounts the iframe — but a remount
      reloads from the outside and starts the page at the top. This lets the pane ask *this* page to
      reload itself, which keeps the scroll position. Conditional on the token, so a visitor never
      ships a message listener for a handshake that cannot happen.
    */
    previewToken && <TaprootPreviewBridge />
  }
  {
    previewToken && item && item.status !== 'published' && (
      <p class="preview-note" role="status">
        <strong>Preview.</strong> This {item.status.replace('_', ' ')} content is not visible to
        visitors.
      </p>
    )
  }
  {
    archive && (
      <article>
        <h1>{archive.title}</h1>
        {archive.items.length === 0 ? (
          <p>Nothing is filed under this yet.</p>
        ) : (
          <ul>
            {archive.items.map((entry) => (
              <li>
                <a href={entry.path}>{entry.title}</a>
              </li>
            ))}
          </ul>
        )}
      </article>
    )
  }

  {
    item && (
      <article>
        <h1>{item.title}</h1>

        {renderable.map(({ field, value }) => (
          <section>
            {field.type === 'richtext' ? (
              <div set:html={String(value)} />
            ) : field.type === 'boolean' ? (
              <p>
                <strong>{field.label}:</strong> {value ? 'Yes' : 'No'}
              </p>
            ) : field.type === 'text' && field.apiId === 'body' ? (
              <p style="white-space:pre-wrap">{String(value)}</p>
            ) : (
              <p>
                <strong>{field.label}:</strong> {String(value)}
              </p>
            )}
          </section>
        ))}

        {/*
          Blocks arrive already dereferenced — a reusable block's content is filled in by the CMS at
          read time, so this site never makes a second request for it.

          The component map is the whole contract between Taproot and this site: the CMS stores a
          block's type and its validated values, and the site decides what each looks like. `media`
          is passed down so a block holding an image can resolve it from the same map.
        */}
        {blockFields.map((field) => (
          <BlockRenderer
            blocks={item.data[field.apiId]}
            components={BLOCK_COMPONENTS}
            media={media}
          />
        ))}

        {children.length > 0 && (
          <nav aria-labelledby="subpages">
            <h2 id="subpages">In this section</h2>
            <ul>
              {children.map((child) => (
                <li>
                  <a href={child.path}>{child.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </article>
    )
  }
</SiteLayout>
