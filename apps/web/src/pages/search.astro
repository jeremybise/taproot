---
import SiteLayout from '../layouts/SiteLayout.astro';
import { applyTermHrefs } from '@taprootcms/astro';
import { TaprootExcerpt } from '@taprootcms/astro/components';
import { taproot, termHref } from '../taproot.ts';

export const prerender = false;

/**
 * Site search — the worked example for `taproot.searchPage` and `<TaprootExcerpt>`.
 *
 * A static route, so it wins over `[...path].astro` and this site keeps `/search` for itself. Worth
 * knowing that it *is* a claim on the URL: a content item at `/search` would be unreachable, which
 * is the ordinary trade for any route a site serves itself, and the same one the term archives make
 * from inside the catch-all.
 *
 * **A plain form with no JavaScript.** `method="get"` means the query lives in the URL, which is
 * what makes a result page linkable, bookmarkable and reloadable, and what lets the back button
 * work. An as-you-type box would be a request per keystroke and would leave a visitor with no way to
 * share what they found — `createTaprootSearchHandler` is there for a site that wants one anyway,
 * and it exists because the alternative is putting an API key in a script bundle.
 *
 * **`searchPage` reads the URL so this file does not.** It takes `?q=` and `?page=`, clamps a page
 * number that a visitor may have typed, converts it to an offset, and builds the pager's links from
 * this route's own path — keeping any parameter it does not recognise, so adding a facet later does
 * not silently reset it on page two. That was a dozen lines of arithmetic here, untested, in every
 * site that has a search page.
 */
const [found, nav] = await Promise.all([
  /**
   * Both requests together, for the reason `[...path].astro` spells out: a layout's frontmatter
   * cannot start until the page's has finished, so fetching the menu after the results would be a
   * serial round trip on every search.
   *
   * A blank query is answered by the CMS with no results rather than with everything, so this needs
   * no guard of its own — the form simply renders empty, which is what a visitor who has typed
   * nothing should see.
   */
  taproot.searchPage(Astro.url, { perPage: 10 }),
  taproot.menu('main').then((entries) => applyTermHrefs(entries, termHref)),
]);

/**
 * Report the search, for the CMS's Settings → Search report.
 *
 * `source: 'page'` — somebody submitted this, which is the least ambiguous intent there is. Awaited
 * rather than fired and forgotten, because a Worker may be torn down the moment the response is
 * returned and a floating promise would be cancelled somewhere between "usually works" and
 * "usually does not". It never throws and never blocks on an error, so the cost is one request the
 * visitor does not wait on the *result* of.
 *
 * Only when a term was actually searched. Logging the blank render would put an empty row at the
 * top of every report.
 */
if (found.query) {
  await taproot.logSearch({
    query: found.query,
    resultCount: found.total,
    source: 'page',
  });
}

/**
 * Search results are never indexed.
 *
 * An infinite space of URLs holding other pages' content, which every search engine's guidance asks
 * sites not to publish — and a crawler following them is also a crawler running a text query per
 * request. Nothing about this is Taproot's rule; it is what a site does with a search page.
 */
Astro.response.headers.set('x-robots-tag', 'noindex, follow');
/**
 * **Not cached, and the search log is why.**
 *
 * This used to carry `PAGE_CACHE_CONTROL` like every other route. That is a day at the edge, so the
 * second person to search "nursing" would be served a stored copy and this frontmatter — and the
 * `logSearch` call in it — would never run. The report would then undercount in proportion to how
 * *popular* a term is, ranking the terms nobody repeats as the most searched, and looking entirely
 * plausible while doing it.
 *
 * Cheap to give up. A results page is per-query and low-volume, so caching it saves a fraction of
 * the traffic a content page does; and a page of other pages' content, already `noindex`, is not
 * one there is much reason to keep in a shared cache anyway.
 */
Astro.response.headers.set('cache-control', 'private, no-store');
---

<SiteLayout title={found.query ? `Search: ${found.query}` : 'Search'} nav={nav} noIndex={true}>
  <h1>Search</h1>

  <form method="get" action="/search" role="search">
    {
      /*
        A real `<label>`, not a placeholder. A placeholder disappears the moment somebody types, is
        not announced as a name by every screen reader, and fails contrast in most designs — WCAG
        3.3.2 asks for a label, and this is the smallest form on the site to get it right on.

        A JSX-style comment rather than an HTML one, which Astro would emit into the page: every
        visitor would download this paragraph, and the reasoning belongs to whoever reads the source.
      */
    }
    <label for="q">Search this site</label>
    <input id="q" type="search" name="q" value={found.query} autocomplete="off" />
    <button type="submit">Search</button>
  </form>

  {
    found.query && (
      <p role="status">
        {found.total === 0
          ? `No results for “${found.query}”.`
          : `${found.total} ${found.total === 1 ? 'result' : 'results'} for “${found.query}”.`}
      </p>
    )
  }

  {
    found.results.length > 0 && (
      <ol class="results">
        {found.results.map((result) => (
          <li>
            <h2>
              <a href={result.path}>{result.title}</a>
            </h2>
            {/*
              `<TaprootExcerpt>` marks the matched words and renders the rest as text.

              The excerpt is plain text by design, so highlighting it is the site's job — and the
              way that gets written by hand is a `replace` into `set:html`, on a string built from
              `?q=`, which is a reflected XSS. This emits text nodes and `<mark>` elements from
              segments, so there is no string being trusted, and it marks exactly what FTS5 matched
              rather than what a second tokenizer here would have guessed.
            */}
            {result.excerpt && (
              <p>
                <TaprootExcerpt text={result.excerpt} query={found.query} />
              </p>
            )}
            <p class="result-path">{result.path}</p>
          </li>
        ))}
      </ol>
    )
  }

  {
    found.pageCount > 1 && (
      <nav aria-label="Search results pages">
        <ul class="pager">
          {found.prevHref && (
            <li>
              <a href={found.prevHref} rel="prev">
                Previous
              </a>
            </li>
          )}
          <li>
            Page {found.page} of {found.pageCount}
          </li>
          {found.nextHref && (
            <li>
              <a href={found.nextHref} rel="next">
                Next
              </a>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</SiteLayout>

<style>
  form[role='search'] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: end;
    margin-block: 1.5rem;
  }

  form[role='search'] label {
    flex-basis: 100%;
  }

  .results {
    list-style: none;
    padding: 0;
  }

  .results li + li {
    margin-block-start: 1.5rem;
  }

  .results h2 {
    margin-block-end: 0.25rem;
    font-size: 1.1rem;
  }

  /*
    The site styles the highlight, because `<TaprootExcerpt>` ships no wrapper and no CSS — it
    guarantees the markup is safe and has no opinion about what it looks like. The browser default
    is a yellow background, which is legible here and would not be on a dark theme.
  */
  .results mark {
    background: highlight;
    color: highlighttext;
  }

  .result-path {
    margin-block-start: 0.25rem;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .pager {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
</style>
