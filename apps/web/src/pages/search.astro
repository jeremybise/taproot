---
import SiteLayout from '../layouts/SiteLayout.astro';
import { applyTermHrefs } from '@taprootcms/astro';
import { taproot, termHref } from '../taproot.ts';

export const prerender = false;

/**
 * Site search — the worked example for `taproot.search`.
 *
 * A static route, so it wins over `[...path].astro` and this site keeps `/search` for itself. Worth
 * knowing that it *is* a claim on the URL: a content item at `/search` would be unreachable, which
 * is the ordinary trade for any route a site serves itself, and the same one the term archives make
 * from inside the catch-all.
 *
 * **A plain form with no JavaScript.** `method="get"` means the query lives in the URL, which is
 * what makes a result page linkable, bookmarkable and reloadable, and what lets the back button
 * work. An as-you-type box would be a request per keystroke against an endpoint that scans text,
 * and would leave a visitor with no way to share what they found.
 */
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const page = Math.max(Number(Astro.url.searchParams.get('page') ?? 1) || 1, 1);
const PER_PAGE = 10;

/**
 * Both requests together, for the reason `[...path].astro` spells out: a layout's frontmatter
 * cannot start until the page's has finished, so fetching the menu after the results would be a
 * serial round trip on every search.
 *
 * A blank query is answered by the CMS with no results rather than with everything, so this needs no
 * guard of its own — the form simply renders empty, which is what a visitor who has typed nothing
 * should see.
 */
const [found, nav] = await Promise.all([
  taproot.search(query, { limit: PER_PAGE, offset: (page - 1) * PER_PAGE }),
  taproot.menu('main').then((entries) => applyTermHrefs(entries, termHref)),
]);

const pageCount = Math.ceil(found.total / PER_PAGE);

function pageHref(target: number): string {
  const params = new URLSearchParams({ q: query });
  if (target > 1) params.set('page', String(target));
  return `/search?${params}`;
}

/**
 * Search results are never indexed.
 *
 * An infinite space of URLs holding other pages' content, which every search engine's guidance asks
 * sites not to publish — and a crawler following them is also a crawler running a text scan per
 * request. Nothing about this is Taproot's rule; it is what a site does with a search page.
 */
Astro.response.headers.set('x-robots-tag', 'noindex, follow');
/**
 * Cached briefly and per URL, like every other route here — the query is in the URL, so two
 * visitors searching for different things cannot be served each other's results.
 */
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
---

<SiteLayout title={query ? `Search: ${query}` : 'Search'} nav={nav} noIndex={true}>
  <h1>Search</h1>

  <form method="get" action="/search" role="search">
    {
      /*
        A real `<label>`, not a placeholder. A placeholder disappears the moment somebody types, is
        not announced as a name by every screen reader, and fails contrast in most designs — WCAG
        3.3.2 asks for a label, and this is the smallest form on the site to get it right on.

        A JSX-style comment rather than an HTML one, which Astro would emit into the page: every
        visitor would download this paragraph, and the reasoning belongs to whoever reads the source.
      */
    }
    <label for="q">Search this site</label>
    <input id="q" type="search" name="q" value={query} autocomplete="off" />
    <button type="submit">Search</button>
  </form>

  {
    query && (
      <p role="status">
        {found.total === 0
          ? `No results for “${found.query}”.`
          : `${found.total} ${found.total === 1 ? 'result' : 'results'} for “${found.query}”.`}
      </p>
    )
  }

  {
    found.results.length > 0 && (
      <ol class="results">
        {found.results.map((result) => (
          <li>
            <h2>
              <a href={result.path}>{result.title}</a>
            </h2>
            {/*
              Rendered as text, deliberately. The excerpt is assembled from stored content and
              carries no markup by design — putting it through `set:html` would be the one place
              this site trusted a string it never had to.
            */}
            {result.excerpt && <p>{result.excerpt}</p>}
            <p class="result-path">{result.path}</p>
          </li>
        ))}
      </ol>
    )
  }

  {
    pageCount > 1 && (
      <nav aria-label="Search results pages">
        <ul class="pager">
          {page > 1 && (
            <li>
              <a href={pageHref(page - 1)} rel="prev">
                Previous
              </a>
            </li>
          )}
          <li>
            Page {page} of {pageCount}
          </li>
          {page < pageCount && (
            <li>
              <a href={pageHref(page + 1)} rel="next">
                Next
              </a>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</SiteLayout>

<style>
  form[role='search'] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: end;
    margin-block: 1.5rem;
  }

  form[role='search'] label {
    flex-basis: 100%;
  }

  .results {
    list-style: none;
    padding: 0;
  }

  .results li + li {
    margin-block-start: 1.5rem;
  }

  .results h2 {
    margin-block-end: 0.25rem;
    font-size: 1.1rem;
  }

  .result-path {
    margin-block-start: 0.25rem;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .pager {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
</style>
