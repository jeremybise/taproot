---
import SiteLayout from '../layouts/SiteLayout.astro';
import { taproot } from '../taproot.ts';

export const prerender = false;

/**
 * The front page.
 *
 * `depth` and `parent_id` are gone from the delivered summary — they are the CMS's tree bookkeeping
 * rather than anything a site needs — so "top level" is read off the path, which is the property a
 * visitor can see anyway. One segment means one level down from the root.
 */
const { items } = await taproot.items({ limit: 100 });
const topLevel = items.filter((item) => item.path.split('/').filter(Boolean).length === 1);

const cmsUrl = import.meta.env.TAPROOT_API_URL ?? 'http://localhost:4321';
---

<SiteLayout title="Home">
  <h1>Riverbend College</h1>
  <p>
    A demo site running on Taproot. Nothing here is stored in this app — every page is fetched from
    the CMS over HTTP at request time, so editing a page in the{' '}
    <a href={`${cmsUrl}/admin`}>admin</a> changes what you see here immediately, with no rebuild and
    no deploy of this site.
  </p>

  {
    topLevel.length === 0 ? (
      <p>
        Nothing published yet, or this site cannot reach the CMS. Check that the studio is running
        and that <code>TAPROOT_API_URL</code> points at it.
      </p>
    ) : (
      <nav aria-labelledby="sections">
        <h2 id="sections">Sections</h2>
        <ul>
          {topLevel.map((item) => (
            <li>
              <a href={item.path}>{item.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</SiteLayout>
