{
  "name": "@taprootcms/studio-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Taproot CMS deployment: admin panel, REST API, delivery API, and the scheduler",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "db:migrate": "node --experimental-strip-types ./scripts/migrate.ts",
    "db:migrate:remote": "node --experimental-strip-types ./scripts/migrate.ts --remote",
    "db:seed": "node --experimental-strip-types ./scripts/seed.ts",
    "db:reset": "node --experimental-strip-types ./scripts/reset.ts",
    "deploy": "astro build && wrangler deploy",
    "db:reindex": "node --experimental-strip-types ./scripts/reindex.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/node": "^11.0.3",
    "@taprootcms/core": "*",
    "@taprootcms/studio": "*",
    "astro": "^7.1.4"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
