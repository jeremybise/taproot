{
  "name": "taproot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A DB-backed, Astro-native CMS",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@taproot/web",
    "build": "npm run build --workspace=@taproot/core && npm run build --workspace=@taproot/web",
    "build:core": "npm run build --workspace=@taproot/core",
    "db:migrate": "npm run db:migrate --workspace=@taproot/web",
    "db:migrate:remote": "npm run db:migrate:remote --workspace=@taproot/web",
    "db:seed": "npm run db:seed --workspace=@taproot/web",
    "db:reset": "npm run db:reset --workspace=@taproot/web",
    "preview": "npm run preview --workspace=@taproot/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "a11y": "node scripts/a11y-audit.mjs && node scripts/a11y-contrast.mjs",
    "a11y:axe": "node scripts/a11y-audit.mjs",
    "a11y:contrast": "node scripts/a11y-contrast.mjs",
    "deploy": "npm run deploy --workspace=@taproot/web"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true,
    "fsevents@2.3.3": true
  }
}
