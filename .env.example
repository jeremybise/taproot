# The CMS server's configuration. Copy to apps/studio/.env — `cp .env.example apps/studio/.env` —
# then run `npm run db:seed`.
#
# The reference consumer has its own, much smaller, file: see apps/web/.env.example. It holds no
# database and needs only a URL and an API key.
#
# Every value below has a working default for local development. Nothing here needs editing to get
# `npm run dev` running.

# --- Local development -------------------------------------------------------

NODE_ENV=development

# Email and password sign-in is on by default, in development and in production alike — it is the
# primary way in. Set TAPROOT_PASSWORD_AUTH=0 only for a deployment that wants OAuth exclusively,
# and configure a provider below if you do, or there will be no way to sign in at all.
# Seeded development account: admin@example.com / taproot
# TAPROOT_PASSWORD_AUTH=0

# Where the local SQLite file lives, relative to apps/studio. Created automatically.
TAPROOT_SQLITE_PATH=./data/taproot.sqlite

# Used to build OAuth redirect URIs. Must match the origin the site is served from.
TAPROOT_ORIGIN=http://localhost:4321

# Where the site that reads this content lives.
#
# Used for preview links: the admin's "Preview page" button mints a short-lived token and redirects
# to this origin carrying it. Without it Taproot does not know where to send an editor, and says so
# rather than redirecting to a 404 on its own origin.
TAPROOT_SITE_URL=http://localhost:4323

# Where to tell that site to clear its cache, and the secret to prove the request came from here.
#
# Cloudflare scopes cache purging to the Worker that owns the cache, so purging *this* deployment's
# cached JSON cannot touch the HTML the site rendered from it. This callback is the only thing that
# can. Without it a published page reaches visitors when the site's own `s-maxage` lapses, which is
# a day rather than a minute.
#
# **Both or neither.** A URL with no secret is treated as no configuration at all rather than as a
# broken setup, so a half-finished deployment behaves exactly like an unconfigured one. The secret
# must match `TAPROOT_PURGE_SECRET` on the site; the URL is a full URL, so the site may mount the
# handler wherever it likes — `/_taproot/purge` is only the convention.
#
# Deliberately separate from `TAPROOT_SITE_URL` above: that names where a preview link points, and
# this names an endpoint that accepts an authenticated write. Deriving one from the other would turn
# on a write surface as a side effect of configuring a link.
#
# Unset locally: `npm run dev` caches nothing, so there is nothing to purge.
# TAPROOT_SITE_PURGE_URL=http://localhost:4323/_taproot/purge
# TAPROOT_SITE_PURGE_SECRET=

# Local uploads. In production the R2 binding takes over and these are ignored.
TAPROOT_UPLOAD_DIR=./public/uploads
TAPROOT_MEDIA_URL=/uploads


# --- OAuth (production) ------------------------------------------------------
# Configure at least one provider before deploying; the app refuses to boot in production with no
# sign-in method available. Redirect URI is:
#   https://your-domain/api/taproot/auth/callback/<provider>

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common


# --- Scheduled publishing ----------------------------------------------------
# Not needed on Cloudflare. There the sweep is a cron trigger on the Worker itself — see
# `triggers.crons` in apps/studio/wrangler.jsonc and the `scheduled` export in apps/studio/src/worker.ts —
# and nothing crosses the network, so there is nothing to authenticate.
#
# Set it only to let an *external* scheduler call POST /api/taproot/scheduler/run, which it sends as
# `authorization: Bearer <secret>`. Scheduling itself works with neither: a page is visible to
# visitors from its scheduled moment whether or not any sweep has run.

# TAPROOT_CRON_SECRET=


# --- Outgoing email ----------------------------------------------------------
# Taproot sends exactly one message: the self-service password reset link. With nothing set here it
# writes that message to the server log instead, which is what keeps `npm run dev` free of an
# external service — and the "Forgot your password?" link is hidden, because a link that posts into
# a log nobody reads is worse than no link.
#
# No vendor is built in. Point this at your own endpoint and forward it to whichever sender you
# already use; the body is flat JSON: { from, to, subject, text, html }.

# TAPROOT_MAIL_WEBHOOK_URL=https://hooks.example.edu/taproot-mail
# TAPROOT_MAIL_WEBHOOK_TOKEN=
# TAPROOT_MAIL_FROM=cms@example.edu


# --- Remote D1 migrations ----------------------------------------------------
# Only needed for `npm run db:migrate:remote`, which runs on this machine and talks to
# Cloudflare's REST API — so these belong here even when deploying to production. They are
# not `wrangler secret put` values, and the deployed Worker never reads them.
# TAPROOT_CF_D1_ID is the database_id already in wrangler.jsonc; the token is a custom token
# carrying Account > D1 > Edit. See DEPLOYMENT.md for the click path.
# Keep TAPROOT_CF_API_TOKEN out of version control.

# TAPROOT_CF_ACCOUNT_ID=
# TAPROOT_CF_D1_ID=
# TAPROOT_CF_API_TOKEN=


# --- Postgres (optional) -----------------------------------------------------
# Setting this switches the data layer to Postgres and requires `npm install pg`.
# Wired but not the tested target in Phase 0 — SQLite and D1 are.

# DATABASE_URL=postgresql://user:password@localhost:5432/taproot
