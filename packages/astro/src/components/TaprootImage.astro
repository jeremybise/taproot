---
import {
  coverPosition,
  cropFrame,
  cropStamp,
  mediaVariantUrl,
  resolveCrop,
  scaleSizes,
  variantWidthsFor,
  type DeliveryMedia,
  type MediaVariantFormat,
} from '@taprootcms/core/pure';

/**
 * An image rendered at a target aspect ratio, honouring its stored focal point and crop.
 *
 * The delivery half of the hotspot editor. For two phases the editor stored a focal point that
 * nothing read, because the demo templates centre-cropped — an editor could place a face carefully
 * and watch the site cut it out.
 *
 * **This takes a delivered asset, not a database row.** The version that lived in the studio reached
 * for `Astro.locals.taproot` to turn a storage key into a URL, which a consumer on another origin
 * has no access to — and never should, since that is the database handle. The delivery API resolves
 * it to an absolute URL instead, which is what `DeliveryMedia.url` is.
 *
 * The maths is core's, unchanged and already tested across every combination of source orientation,
 * target ratio, and hotspot position. Sharing it rather than reimplementing it here is what keeps a
 * consumer's rendering identical to the admin's preview frames — a preview that disagreed with the
 * page is exactly the failure this component exists to prevent.
 */
interface Props {
  /**
   * An asset from a delivery response's `media` map.
   *
   * Passed in rather than fetched by id because the response already contains it: the map is keyed
   * by the id sitting in the field's value, so a gallery costs one lookup per image and no requests.
   */
  asset: DeliveryMedia;
  /**
   * Width ÷ height. `16 / 9`, `1`, `1200 / 630`. **Omit it when the box has no ratio to give.**
   *
   * With a ratio this component owns its wrapper, resolves the crop rectangle against it, and
   * guarantees the box and the rectangle agree — which is the precondition the whole crop
   * calculation rests on.
   *
   * Without one it renders a **bare `<img>` for the caller to place**, and the only thing that
   * survives is the focal point, applied as `object-position`. That is not a lesser mode, it is the
   * honest answer for a container whose shape is decided at runtime: a page-title band is `min-h`
   * plus however tall the heading and breadcrumbs turn out to be, and a call-to-action is padding
   * plus its copy, so both change shape with the viewport *and* with the content. Forcing a ratio
   * on either would letterbox the photograph or push the text out of its own section.
   *
   * The reason this mode has to exist here rather than in each site's own helper is that the three
   * call sites which reached for a plain `<img>` to escape the ratio gave up every *other* thing
   * this component does on the way out — measured on production as a 170 KB original arriving as
   * the LCP element where a WebP candidate was 76 KB. Skipping the crop is a good reason to skip
   * the crop; it was never a reason to skip the resize.
   */
  ratio?: number;
  /**
   * Overrides the asset's own alt text.
   *
   * An empty string is meaningful and passed through: it marks the image decorative, which is
   * correct when an adjacent heading already carries the meaning. That is why this is not defaulted
   * with `??` on the way in.
   */
  alt?: string;
  loading?: 'lazy' | 'eager';
  /**
   * Priority hint for the fetch, for the one image on a page that is worth raising.
   *
   * Here because `loading="eager"` alone is not the same request: eager decides *whether* the image
   * is deferred, `fetchpriority` decides where it sits in the queue once it is not. A hero that is
   * the LCP element wants both, and a consumer that reached for a plain `<img>` to keep the second
   * one would be giving up the crop to get it — which is how a component ends up used for
   * everything except the image that matters most.
   *
   * Undefined rather than `'auto'` by default: `auto` is the browser's own behaviour, and emitting
   * it on every image states a preference nobody expressed.
   */
  fetchpriority?: 'high' | 'low' | 'auto';
  /**
   * How wide this image's **container** is at each breakpoint — an ordinary `sizes` list.
   *
   * Describe the box you placed, not the `<img>` inside it. Under a `'css'` crop the element is
   * deliberately larger than its container (it is scaled up so the crop rectangle fills the frame),
   * and this component knows that factor while the caller should not have to: `sizes` is rescaled on
   * the way out. Getting it the other way round is how responsive images end up one breakpoint too
   * soft on exactly the layouts that needed them.
   *
   * The default assumes full width, which is right for a hero and **wrong for anything small** —
   * a 96px icon left on `100vw` will fetch the largest candidate on the ladder. Passing something
   * like `"(min-width: 1024px) 50vw, 100vw"`, or a flat `"96px"`, is the single highest-value thing
   * a caller can do here.
   */
  sizes?: string;
  /**
   * Override the offered widths. Pass `[]` to emit no `srcset` at all.
   *
   * The default is the shared ladder, filtered to the source's own width so nothing is upscaled.
   */
  widths?: number[];
  /**
   * Which encodings to offer.
   *
   * `'auto'` is the default and emits **AVIF with a WebP fallback**, through a `<picture>` whose
   * sources each name exactly one format. AVIF measured 22–25% under WebP on every asset tested
   * here, and WebP behind it means nothing is lost on a browser that cannot decode it — which is
   * the whole reason this is not simply a changed default. Naming a single format explicitly
   * (`'webp'`, `'avif'`, …) emits one `<img>` and no `<picture>`; `'original'` keeps whatever was
   * uploaded, and still resizes.
   *
   * **This is not the `f=auto` URL parameter that `imageVariants.ts` rejects, and the difference is
   * the whole point.** That would have meant one URL whose bytes depend on a request header, stored
   * in a shared cache that honours `Vary` for `Accept-Encoding` alone — the first visitor's format
   * served to everyone behind them. Here every candidate URL carries its own `f=`, so every one is
   * its own cache key and nothing varies by header; the *browser* picks from `type` attributes it
   * can see, before it makes a request at all.
   */
  format?: MediaVariantFormat | 'original' | 'auto';
  /**
   * Where the crop happens. Meaningless without a `ratio`, since there is no rectangle to resolve.
   *
   * `'css'` is the default and ships the whole frame, scaling the `<img>` up so the resolved
   * rectangle fills the box. It is correct on any deployment, including one that cannot transform
   * images at all, which is why it is the default.
   *
   * `'server'` asks the media route for the rectangle itself. Every delivered pixel is a visible
   * pixel, so a heavily cropped image stops paying for the part nobody sees — a 3.5:1 photo in a
   * 4:3 well throws away about two thirds of what `'css'` downloads, and is *also* softer for it,
   * because the ladder tops out at the source's width however much of it survives the crop.
   *
   * Needs a deployment whose media route can transform. It does not *break* without one — the
   * image renders with `object-fit: cover` and the hotspot, so a failed transform degrades to
   * approximately-right framing rather than the wrong picture — but the crop stops being exact.
   */
  crop?: 'css' | 'server';
  /**
   * Classes for the element this renders.
   *
   * With a `ratio` that is the **wrapper**, because the wrapper is the box and the `<img>` inside it
   * is positioned by arithmetic this component owns. Without one there is no wrapper and these land
   * on the `<img>` itself, which is what lets a caller supply `object-cover` or `object-contain` —
   * a decision this component deliberately does not make in that mode.
   */
  class?: string;
}

const {
  asset,
  ratio,
  alt,
  loading = 'lazy',
  fetchpriority,
  sizes = '100vw',
  widths,
  format = 'auto',
  crop = 'css',
  class: className,
} = Astro.props;

/**
 * `resolveCrop` wants the stored column names; the delivered shape nests them.
 *
 * Adapted here rather than changing the core function, which the admin's preview calls with rows
 * straight out of the database. One of the two has to bend, and it should be the newer shape.
 */
const source = {
  width: asset.width,
  height: asset.height,
  hotspot_x: asset.hotspot?.x ?? null,
  hotspot_y: asset.hotspot?.y ?? null,
  crop_top: asset.crop?.top ?? null,
  crop_right: asset.crop?.right ?? null,
  crop_bottom: asset.crop?.bottom ?? null,
  crop_left: asset.crop?.left ?? null,
};

/** A ratio is what lets this component own a box; without one the caller already owns it. */
const framed = typeof ratio === 'number' && Number.isFinite(ratio) && ratio > 0;

const rect = framed ? resolveCrop(source, ratio as number) : undefined;
const serverCropped = framed && crop === 'server';

/**
 * Responsive candidates, and the one piece of arithmetic that makes them correct.
 *
 * A `w` descriptor is the candidate's real width, and the browser compares it against the width the
 * `<img>` **element** will occupy — which under a `'css'` crop is not the container. The element is
 * blown up by `1 / rect.width` so the crop rectangle fills the frame, so a box laid out at 640 CSS
 * px holds an `<img>` laid out at `640 × scale`. Handing the browser the container's `sizes`
 * unmodified would have it shop for a 640px image and paint it across an element wider than that:
 * every cropped image on the site one rung too soft, on exactly the layouts where the crop was doing
 * the most work. So the caller describes the container, which is what they can see, and the factor
 * is applied here, where it is known.
 *
 * Unframed and server-cropped both land on 1 — in the first case because the element *is* the
 * container, in the second because the delivered file already is the rectangle.
 */
const scale = !framed || serverCropped || (rect as { width: number }).width <= 0
  ? 1
  : 1 / (rect as { width: number }).width;

/**
 * The ladder is capped by what the delivered file actually contains.
 *
 * Under `'css'`, and with no ratio at all, a candidate is a width of the whole source, so the
 * source's width is the ceiling. Under `'server'` it is a width of the **crop**, which is narrower —
 * asking for 1536 of a rectangle only 800 source pixels wide is an upscale the resizer will decline,
 * leaving candidates the browser can pick and gain nothing from.
 */
const ladderCeiling =
  serverCropped && asset.width !== null
    ? Math.round(asset.width * (rect as { width: number }).width)
    : asset.width;

const candidateWidths = widths ?? variantWidthsFor(ladderCeiling);
const variantRatio = serverCropped ? ratio : undefined;

/**
 * The crop the URL was built against, so a moved focal point moves the address.
 *
 * Only under `'server'`, where the delivered bytes *are* the rectangle. Under `'css'` the whole
 * frame is shipped and the crop is applied here, so the same URL stays correct however the hotspot
 * moves — stamping it would re-mint every uncropped image on the site to fix nothing. `cropStamp`
 * carries the full argument; the short version is that the media route sends `immutable` for a year
 * on a response whose content depends on columns an editor edits.
 */
const variantStamp = serverCropped ? cropStamp(source) : undefined;

/**
 * The format actually written into each URL, and the optional upgrade offered above it.
 *
 * `'original'` sends no `f=` at all, which is a request to resize and re-encode in the source's own
 * type. That reads as the conservative choice and was for a long time the *least* optimised one:
 * the media route's binding rejects an output naming no format, and `resizeImage` catches every
 * failure and serves the stored bytes — so `'original'` quietly opted out of the resize as well.
 * Fixed in core rather than worked around here, because a hand-built `?w=` URL had the same hole.
 */
const upgradeFormat: MediaVariantFormat | undefined = format === 'auto' ? 'avif' : undefined;
const baseFormat: MediaVariantFormat | undefined =
  format === 'auto' ? 'webp' : format === 'original' ? undefined : format;

const srcsetFor = (variantFormat: MediaVariantFormat | undefined) =>
  candidateWidths.length > 0
    ? candidateWidths
        .map(
          (width) =>
            `${mediaVariantUrl(asset.url, { width, ratio: variantRatio, format: variantFormat, stamp: variantStamp })} ${width}w`,
        )
        .join(', ')
    : undefined;

const srcset = srcsetFor(baseFormat);
const upgradeSrcset = upgradeFormat ? srcsetFor(upgradeFormat) : undefined;

/**
 * `src` is the largest candidate rather than `asset.url`: any browser old enough to ignore `srcset`
 * would otherwise be the only one still downloading the full-size original.
 */
const src = srcset
  ? mediaVariantUrl(asset.url, {
      width: candidateWidths[candidateWidths.length - 1],
      ratio: variantRatio,
      format: baseFormat,
      stamp: variantStamp,
    })
  : asset.url;

/**
 * `sizes` describes the container; under `'css'` the browser chooses against an element blown up by
 * `1 / rect.width`, so `scaleSizes` bridges the two. It lives in core because it is string
 * arithmetic with an edge case that already shipped wrong — a `calc()` length split on its last
 * space, scaling only its final term into valid CSS computing the wrong number. Untestable inside
 * an `.astro` file; pinned by six cases beside it.
 *
 * Under `'server'`, and with no ratio, the element *is* the container, so there is nothing to bridge
 * and the caller's `sizes` is emitted exactly as written.
 */
const elementSizes = scaleSizes(sizes, scale);
const emittedSizes = srcset ? elementSizes : undefined;

/**
 * `cover` plus the focal point, which is the fallback rather than the mechanism.
 *
 * When the transform happened, the delivered image already has the box's ratio and `cover` is a
 * no-op — the picture is exactly the resolved rectangle. When it did not happen, for any of the
 * reasons `resizeImage` swallows, the original arrives instead and this frames it on its hotspot.
 * So a deployment that cannot transform gets an approximate crop rather than a wrong one, which is
 * what makes this mode safe to offer at all.
 *
 * Unframed, it is the only spatial statement available and core's `coverPosition` says why: a crop
 * cannot be expressed by `object-position`, so the region the editor kept is centred and a hotspot
 * outranks that centre. **No `object-fit` is set in that mode** — `cover` and `contain` are both
 * right for different callers, and a component that cannot see the box must not choose.
 */
const frame =
  framed && !serverCropped
    ? cropFrame(rect as Parameters<typeof cropFrame>[0])
    : `object-position:${coverPosition(source)}`;

/**
 * Alt text comes from the library, where it is authored once and reused everywhere the asset
 * appears — unless the call site overrides it. `null` alt text is an asset nobody has described
 * yet, and an empty string is the least-wrong rendering: a filename read aloud is worse than
 * silence.
 */
const altText = alt ?? asset.alt ?? '';
---

{
  /*
   * Two shapes, and the split is which side owns the box.
   *
   * Framed: the wrapper carries the ratio and the `<img>` is positioned inside it by the resolved
   * rectangle, so the caller's classes belong on the wrapper. Unframed: there is no box to own, so
   * this is a bare `<img>` the caller places, and the classes belong on it.
   *
   * `<picture>` is `display: contents` in both, so adding it changed no layout anywhere. It exists
   * only to let the browser choose an encoding from `type`, and an inline box left in flow around
   * an absolutely-positioned `<img>` would still contribute a line box to whatever contains it.
   */
  framed ? (
    <div
      class:list={['taproot-image', className]}
      data-crop={serverCropped ? 'server' : undefined}
      style={`--taproot-image-ratio:${ratio}`}
    >
      <picture style="display:contents">
        {upgradeSrcset && <source type="image/avif" srcset={upgradeSrcset} sizes={emittedSizes} />}
        <img
          src={src}
          srcset={srcset}
          sizes={emittedSizes}
          alt={altText}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
          style={frame}
        />
      </picture>
    </div>
  ) : (
    <picture style="display:contents">
      {upgradeSrcset && <source type="image/avif" srcset={upgradeSrcset} sizes={emittedSizes} />}
      <img
        class={className}
        src={src}
        srcset={srcset}
        sizes={emittedSizes}
        alt={altText}
        /*
         * Intrinsic dimensions, so the row does not reflow when the image lands. The framed branch
         * needs none: its wrapper carries `aspect-ratio`, which reserves the space already.
         */
        width={asset.width ?? undefined}
        height={asset.height ?? undefined}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        style={frame}
      />
    </picture>
  )
}

<style>
  .taproot-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--taproot-image-ratio);
  }

  /*
    Positioned and sized entirely by the inline style above, which is the resolved rectangle.
    `max-width: none` because a site-wide `img { max-width: 100% }` — which nearly every stylesheet
    has — would otherwise clamp the scaled-up image back to the container and undo the crop.
  */
  .taproot-image img {
    position: absolute;
    max-width: none;
  }

  /*
    Server-cropped: the delivered file already *is* the rectangle, so the element simply fills the
    box. `object-fit: cover` is the safety net rather than the mechanism — it is a no-op while the
    ratios agree, and the only thing standing between a transform that did not happen and a visibly
    wrong picture. The inline style supplies `object-position`.
  */
  .taproot-image[data-crop='server'] img {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
