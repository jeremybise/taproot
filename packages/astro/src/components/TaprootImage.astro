---
import {
  cropFrame,
  mediaVariantUrl,
  resolveCrop,
  scaleSizes,
  variantWidthsFor,
  type DeliveryMedia,
  type MediaVariantFormat,
} from '@taprootcms/core/pure';

/**
 * An image rendered at a target aspect ratio, honouring its stored focal point and crop.
 *
 * The delivery half of the hotspot editor. For two phases the editor stored a focal point that
 * nothing read, because the demo templates centre-cropped — an editor could place a face carefully
 * and watch the site cut it out.
 *
 * **This takes a delivered asset, not a database row.** The version that lived in the studio reached
 * for `Astro.locals.taproot` to turn a storage key into a URL, which a consumer on another origin
 * has no access to — and never should, since that is the database handle. The delivery API resolves
 * it to an absolute URL instead, which is what `DeliveryMedia.url` is.
 *
 * The maths is core's, unchanged and already tested across every combination of source orientation,
 * target ratio, and hotspot position. Sharing it rather than reimplementing it here is what keeps a
 * consumer's rendering identical to the admin's preview frames — a preview that disagreed with the
 * page is exactly the failure this component exists to prevent.
 */
interface Props {
  /**
   * An asset from a delivery response's `media` map.
   *
   * Passed in rather than fetched by id because the response already contains it: the map is keyed
   * by the id sitting in the field's value, so a gallery costs one lookup per image and no requests.
   */
  asset: DeliveryMedia;
  /** Width ÷ height. `16 / 9`, `1`, `1200 / 630`. */
  ratio: number;
  /**
   * Overrides the asset's own alt text.
   *
   * An empty string is meaningful and passed through: it marks the image decorative, which is
   * correct when an adjacent heading already carries the meaning. That is why this is not defaulted
   * with `??` on the way in.
   */
  alt?: string;
  loading?: 'lazy' | 'eager';
  /**
   * Priority hint for the fetch, for the one image on a page that is worth raising.
   *
   * Here because `loading="eager"` alone is not the same request: eager decides *whether* the image
   * is deferred, `fetchpriority` decides where it sits in the queue once it is not. A hero that is
   * the LCP element wants both, and a consumer that reached for a plain `<img>` to keep the second
   * one would be giving up the crop to get it — which is how a component ends up used for
   * everything except the image that matters most.
   *
   * Undefined rather than `'auto'` by default: `auto` is the browser's own behaviour, and emitting
   * it on every image states a preference nobody expressed.
   */
  fetchpriority?: 'high' | 'low' | 'auto';
  /**
   * How wide this image's **container** is at each breakpoint — an ordinary `sizes` list.
   *
   * Describe the box you placed, not the `<img>` inside it. The element is deliberately larger than
   * its container (it is scaled up so the crop rectangle fills the frame), and this component knows
   * that factor while the caller should not have to: `sizes` is rescaled on the way out. Getting it
   * the other way round is how responsive images end up one breakpoint too soft on exactly the
   * layouts that needed them.
   *
   * The default assumes full width, which is right for a hero and too generous for a half-width
   * card — passing something like `"(min-width: 1024px) 50vw, 100vw"` is the single highest-value
   * thing a caller can do here.
   */
  sizes?: string;
  /**
   * Override the offered widths. Pass `[]` to emit no `srcset` at all.
   *
   * The default is the shared ladder, filtered to the source's own width so nothing is upscaled.
   */
  widths?: number[];
  /**
   * Re-encode to this format. `'original'` keeps whatever was uploaded.
   *
   * WebP by default because it is universally supported and typically halves a photograph, and
   * because the alternative — `'original'` — means a PNG screenshot an editor dragged in is served
   * to every visitor as a PNG. A deployment that cannot transform ignores the parameter and serves
   * the original, so this is never a correctness risk, only a size one.
   */
  format?: MediaVariantFormat | 'original';
  class?: string;
}

const {
  asset,
  ratio,
  alt,
  loading = 'lazy',
  fetchpriority,
  sizes = '100vw',
  widths,
  format = 'webp',
  class: className,
} = Astro.props;

/**
 * `resolveCrop` wants the stored column names; the delivered shape nests them.
 *
 * Adapted here rather than changing the core function, which the admin's preview calls with rows
 * straight out of the database. One of the two has to bend, and it should be the newer shape.
 */
const rect = resolveCrop(
  {
    width: asset.width,
    height: asset.height,
    hotspot_x: asset.hotspot?.x ?? null,
    hotspot_y: asset.hotspot?.y ?? null,
    crop_top: asset.crop?.top ?? null,
    crop_right: asset.crop?.right ?? null,
    crop_bottom: asset.crop?.bottom ?? null,
    crop_left: asset.crop?.left ?? null,
  },
  ratio,
);

const frame = cropFrame(rect);

/**
 * Responsive candidates, and the one piece of arithmetic that makes them correct.
 *
 * A `w` descriptor is the candidate's real width, and the browser compares it against the width the
 * `<img>` **element** will occupy — which here is not the container. The element is blown up by
 * `1 / rect.width` so the crop rectangle fills the frame, so a box laid out at 640 CSS px holds an
 * `<img>` laid out at `640 × scale`. Handing the browser the container's `sizes` unmodified would
 * have it shop for a 640px image and paint it across an element wider than that: every cropped
 * image on the site one rung too soft, on exactly the layouts where the crop was doing the most
 * work. So the caller describes the container, which is what they can see, and the factor is
 * applied here, where it is known.
 *
 * `src` is the largest candidate rather than `asset.url`: any browser old enough to ignore `srcset`
 * would otherwise be the only one still downloading the full-size original.
 */
const scale = rect.width > 0 ? 1 / rect.width : 1;
const candidateWidths = widths ?? variantWidthsFor(asset.width);
const variantFormat = format === 'original' ? undefined : format;

const srcset =
  candidateWidths.length > 0
    ? candidateWidths
        .map(
          (width) => `${mediaVariantUrl(asset.url, { width, format: variantFormat })} ${width}w`,
        )
        .join(', ')
    : undefined;

const src = srcset
  ? mediaVariantUrl(asset.url, {
      width: candidateWidths[candidateWidths.length - 1],
      format: variantFormat,
    })
  : asset.url;

/**
 * `sizes` describes the container; the browser chooses against the element. `scaleSizes` bridges
 * the two, and lives in core rather than here because it is string arithmetic with an edge case
 * that already shipped wrong — a `calc()` length was split on its last space and only its final
 * term scaled, which is valid CSS computing the wrong number. Untestable inside an `.astro` file;
 * pinned by six cases beside it.
 */
const elementSizes = scaleSizes(sizes, scale);

/**
 * Alt text comes from the library, where it is authored once and reused everywhere the asset
 * appears — unless the call site overrides it. `null` alt text is an asset nobody has described
 * yet, and an empty string is the least-wrong rendering: a filename read aloud is worse than
 * silence.
 */
const altText = alt ?? asset.alt ?? '';
---

<div class:list={['taproot-image', className]} style={`--taproot-image-ratio:${ratio}`}>
  <img
    src={src}
    srcset={srcset}
    sizes={srcset ? elementSizes : undefined}
    alt={altText}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    style={frame}
  />
</div>

<style>
  .taproot-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--taproot-image-ratio);
  }

  /*
    Positioned and sized entirely by the inline style above, which is the resolved rectangle.
    `max-width: none` because a site-wide `img { max-width: 100% }` — which nearly every stylesheet
    has — would otherwise clamp the scaled-up image back to the container and undo the crop.
  */
  .taproot-image img {
    position: absolute;
    max-width: none;
  }
</style>
