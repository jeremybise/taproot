---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getConfiguredProviders } from '@taproot/core';
import { getTaproot, loginRedirect, canManageUsers } from '../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;

const providers = getConfiguredProviders(taproot.auth);

const users = canManageUsers(user)
  ? await taproot.db.db.selectFrom('users').selectAll().orderBy('created_at').execute()
  : [];

const environment = [
  { label: 'Database driver', value: taproot.db.driver },
  { label: 'Media storage', value: taproot.storage.name },
  { label: 'OAuth providers', value: providers.length > 0 ? providers.join(', ') : 'none' },
  {
    label: 'Development sign-in',
    value: taproot.auth.devCredentialsEnabled ? 'enabled (local only)' : 'disabled',
  },
  { label: 'Secure cookies', value: taproot.auth.secureCookies ? 'yes' : 'no (local http)' },
];
---

<AdminLayout title="Settings" user={user} breadcrumbs={[{ label: 'Settings' }]}>
  <h1 class="mb-6 text-2xl font-semibold tracking-tight">Settings</h1>

  <section aria-labelledby="env-heading" class="mb-10">
    <h2 id="env-heading" class="mb-3 text-base font-semibold">Environment</h2>
    <dl class="divide-y divide-border overflow-hidden rounded-lg border border-border">
      {
        environment.map((row) => (
          <div class="flex flex-wrap justify-between gap-2 bg-surface-raised px-4 py-2.5 text-sm">
            <dt class="text-content-muted">{row.label}</dt>
            <dd class="font-mono text-xs">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    canManageUsers(user) && (
      <section aria-labelledby="users-heading" class="mb-10">
        <h2 id="users-heading" class="mb-3 text-base font-semibold">Users</h2>
        <div class="overflow-x-auto rounded-lg border border-border">
          <table class="w-full text-left text-sm">
            <caption class="sr-only-focusable">Users with access to this site</caption>
            <thead class="bg-surface-sunken text-xs uppercase tracking-wide text-content-subtle">
              <tr>
                <th scope="col" class="px-4 py-2.5 font-medium">
                  Name
                </th>
                <th scope="col" class="px-4 py-2.5 font-medium">
                  Email
                </th>
                <th scope="col" class="px-4 py-2.5 font-medium">
                  Role
                </th>
                <th scope="col" class="px-4 py-2.5 font-medium">
                  Active
                </th>
              </tr>
            </thead>
            <tbody>
              {users.map((row) => (
                <tr class="border-t border-border">
                  <th scope="row" class="px-4 py-2.5 font-medium">
                    {row.name}
                  </th>
                  <td class="px-4 py-2.5 text-content-muted">{row.email}</td>
                  <td class="px-4 py-2.5 capitalize">{row.role}</td>
                  <td class="px-4 py-2.5">{row.is_active ? 'Yes' : 'No'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 max-w-prose text-sm text-content-subtle">
          Role editing, invitations, and the scoped permission model — where a role is narrowed to a
          content type, a department, or specific items — arrive in Phase 3. Phase
          0 uses a single global role per user.
        </p>
      </section>
    )
  }

  <section aria-labelledby="account-heading">
    <h2 id="account-heading" class="mb-3 text-base font-semibold">Your account</h2>
    <dl class="divide-y divide-border overflow-hidden rounded-lg border border-border">
      <div class="flex flex-wrap justify-between gap-2 bg-surface-raised px-4 py-2.5 text-sm">
        <dt class="text-content-muted">Name</dt>
        <dd>{user.name}</dd>
      </div>
      <div class="flex flex-wrap justify-between gap-2 bg-surface-raised px-4 py-2.5 text-sm">
        <dt class="text-content-muted">Email</dt>
        <dd>{user.email}</dd>
      </div>
      <div class="flex flex-wrap justify-between gap-2 bg-surface-raised px-4 py-2.5 text-sm">
        <dt class="text-content-muted">Role</dt>
        <dd class="capitalize">{user.role}</dd>
      </div>
      <div class="flex flex-wrap justify-between gap-2 bg-surface-raised px-4 py-2.5 text-sm">
        <dt class="text-content-muted">Two-factor authentication</dt>
        <dd class="text-content-subtle">Enrolment UI arrives in Phase 1</dd>
      </div>
    </dl>
  </section>
</AdminLayout>
