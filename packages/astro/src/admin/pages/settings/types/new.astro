---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { contentTypeInputSchema, createContentType, slugify } from '@taproot/core';
import { getTaproot, loginRedirect, canManageSchema } from '../../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;
if (!canManageSchema(user)) return Astro.redirect('/admin');

let error: string | null = null;

// Handled as a plain form post rather than client-side fetch: this screen has no interactive
// state worth shipping JavaScript for, and it keeps working if the island fails to hydrate.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();

  const parsed = contentTypeInputSchema.safeParse({
    name,
    name_plural: String(form.get('name_plural') ?? '').trim() || `${name}s`,
    api_id: String(form.get('api_id') ?? '').trim() || slugify(name).replace(/-/g, '_'),
    kind: String(form.get('kind') ?? 'collection'),
    description: String(form.get('description') ?? '').trim() || null,
    url_prefix: String(form.get('url_prefix') ?? '').trim() || null,
    icon: null,
    title_field: null,
  });

  if (!parsed.success) {
    error = parsed.error.issues.map((issue) => `${issue.path.join('.')}: ${issue.message}`).join('; ');
  } else {
    try {
      const created = await createContentType(taproot.db.db, parsed.data);
      return Astro.redirect(`/admin/settings/types/${created.id}?created=1`);
    } catch (cause) {
      error = cause instanceof Error ? cause.message : 'Could not create the content type.';
    }
  }
}

const kinds = [
  {
    value: 'page',
    label: 'Page',
    hint: 'Nests under a parent page. URLs mirror the hierarchy, e.g. /admissions/how-to-apply.',
  },
  {
    value: 'collection',
    label: 'Collection',
    hint: 'A flat list with a shared URL prefix, e.g. /events/spring-open-house.',
  },
  {
    value: 'singleton',
    label: 'Singleton',
    hint: 'Exactly one item that is only ever edited — a weather banner, footer details.',
  },
];
---

<AdminLayout
  title="New content type"
  user={user}
  breadcrumbs={[
    { label: 'Settings', href: '/admin/settings' },
    { label: 'Content types', href: '/admin/settings/types' },
    { label: 'New' },
  ]}
>
  <h1 class="mb-6 text-2xl font-semibold tracking-tight">New content type</h1>

  <div role="alert" aria-live="assertive">
    {
      error && (
        <p class="mb-6 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">{error}</p>
      )
    }
  </div>

  <form method="post" class="max-w-2xl space-y-6">
    <div>
      <label for="name" class="block text-sm font-medium">Name</label>
      <p id="name-hint" class="mt-0.5 text-xs text-content-subtle">
        Singular, as it appears in the admin — "Page", "Event", "Staff Profile".
      </p>
      <input
        id="name"
        name="name"
        required
        maxlength="120"
        aria-describedby="name-hint"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      />
    </div>

    <div>
      <label for="name_plural" class="block text-sm font-medium">
        Plural name <span class="font-normal text-content-subtle">(optional)</span>
      </label>
      <input
        id="name_plural"
        name="name_plural"
        maxlength="120"
        placeholder="Defaults to the name with an “s”"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      />
    </div>

    <div>
      <label for="api_id" class="block text-sm font-medium">
        API id <span class="font-normal text-content-subtle">(optional)</span>
      </label>
      <p id="api-hint" class="mt-0.5 text-xs text-content-subtle">
        The machine name used in code and the API. Cannot be changed later. Derived from the name if
        left blank.
      </p>
      <input
        id="api_id"
        name="api_id"
        pattern="[a-z][a-z0-9_]*"
        maxlength="64"
        aria-describedby="api-hint"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 font-mono text-sm"
      />
    </div>

    <fieldset>
      <legend class="text-sm font-medium">Kind</legend>
      <div class="mt-2 space-y-2">
        {
          kinds.map((kind, index) => (
            <div class="flex gap-3 rounded-md border border-border bg-surface-raised px-3 py-2.5">
              <input
                id={`kind-${kind.value}`}
                type="radio"
                name="kind"
                value={kind.value}
                checked={index === 1}
                class="mt-1"
                aria-describedby={`kind-${kind.value}-hint`}
              />
              <div>
                <label for={`kind-${kind.value}`} class="text-sm font-medium">
                  {kind.label}
                </label>
                <p id={`kind-${kind.value}-hint`} class="text-xs text-content-subtle">
                  {kind.hint}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </fieldset>

    <div>
      <label for="url_prefix" class="block text-sm font-medium">
        URL prefix <span class="font-normal text-content-subtle">(collections only)</span>
      </label>
      <input
        id="url_prefix"
        name="url_prefix"
        pattern="[a-z0-9]+(-[a-z0-9]+)*"
        placeholder="events"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 font-mono text-sm"
      />
    </div>

    <div>
      <label for="description" class="block text-sm font-medium">
        Description <span class="font-normal text-content-subtle">(optional)</span>
      </label>
      <textarea
        id="description"
        name="description"
        rows="2"
        maxlength="500"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      ></textarea>
    </div>

    <div class="flex gap-3">
      <button
        type="submit"
        class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
      >
        Create content type
      </button>
      <a
        href="/admin/settings/types"
        class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium transition-colors hover:bg-surface-sunken"
      >
        Cancel
      </a>
    </div>
  </form>
</AdminLayout>
