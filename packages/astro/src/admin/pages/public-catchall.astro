---
import { getItemByPath, getRedirect, normalizePath } from '@taproot/core';
import { getTaproot } from '../../runtime/guards.js';

/**
 * An optional, minimal public renderer.
 *
 * Only injected when `taproot({ publicRoutes: true })` is set. Most sites want their own
 * `[...path].astro` so they control templates per content type — `apps/web` does exactly that and
 * is the better example to copy.
 */
const taproot = getTaproot(Astro.locals);
const path = normalizePath(`/${Astro.params.path ?? ''}`);

const item = await getItemByPath(taproot.db.db, path);

if (!item) {
  // Fall back to the redirect table before giving up, so moved pages keep working.
  const redirect = await getRedirect(taproot.db.db, path);
  if (redirect) return Astro.redirect(redirect.to, redirect.status as 301);
  return new Response('Not found', { status: 404 });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{item.seo.metaTitle ?? item.title}</title>
    {item.seo.metaDescription && <meta name="description" content={item.seo.metaDescription} />}
  </head>
  <body>
    <main>
      <h1>{item.title}</h1>
      {
        Object.entries(item.data).map(([key, value]) => (
          <section>
            <h2>{key}</h2>
            <p>{typeof value === 'string' ? value : JSON.stringify(value)}</p>
          </section>
        ))
      }
    </main>
  </body>
</html>
