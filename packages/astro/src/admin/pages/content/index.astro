---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Timestamp from '../../components/Timestamp.astro';
import { countItemsByStatus, listContentTypes, listItems } from '@taproot/core';
import { parseStatusFilter, statusFilterOptions } from '../../status.js';
import { getTaproot, loginRedirect, canEditContent } from '../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;

const params = Astro.url.searchParams;
const typeFilter = params.get('type') ?? '';
const search = params.get('q') ?? '';
// Anything unrecognised is dropped rather than passed through, so a hand-edited URL narrows the
// list to nothing instead of reaching the query with a status that cannot exist.
const statusFilter = parseStatusFilter(params.get('status'));

const contentTypes = await listContentTypes(taproot.db.db);

const facetFilters = {
  contentTypeId: typeFilter || undefined,
  search: search || undefined,
};

const [{ items, total }, statusCounts] = await Promise.all([
  listItems(taproot.db.db, { ...facetFilters, status: statusFilter, limit: 100 }),
  countItemsByStatus(taproot.db.db, facetFilters),
]);

const statusOptions = statusFilterOptions(statusCounts, statusFilter);
// The "All statuses" count comes from the same facet query, so it stays consistent with the
// per-status numbers beside it even though `total` above is narrowed by the status filter.
const statusTotal = Object.values(statusCounts).reduce((sum, n) => sum + n, 0);
const typeNames = new Map(contentTypes.map((type) => [type.id, type.name]));
const filtered = Boolean(search || typeFilter || statusFilter);
---

<AdminLayout title="Content" user={user} breadcrumbs={[{ label: 'Content' }]}>
  <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Content</h1>
      <p class="mt-1 text-sm text-content-muted">
        {total} {total === 1 ? 'item' : 'items'}{filtered ? ' matching this filter' : ''}
      </p>
    </div>
    {
      canEditContent(user) && contentTypes.length > 0 && (
        <a
          href="/admin/content/new"
          class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
        >
          New content item
        </a>
      )
    }
  </header>

  <form method="get" class="mb-6 flex flex-wrap items-end gap-3">
    <div class="min-w-48 flex-1">
      <label for="q" class="block text-sm font-medium">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        value={search}
        placeholder="Title or path"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      />
    </div>

    <div>
      <label for="type" class="block text-sm font-medium">Content type</label>
      <select
        id="type"
        name="type"
        class="mt-1.5 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      >
        <option value="">All types</option>
        {
          contentTypes.map((type) => (
            <option value={type.id} selected={type.id === typeFilter}>
              {type.name}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="status" class="block text-sm font-medium">Status</label>
      <select
        id="status"
        name="status"
        class="mt-1.5 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      >
        {/*
          Counts ignore the status filter but honour the others, so each number answers "what
          would I get if I switched to this?" rather than restating the row count already on
          screen.
        */}
        <option value="">All statuses ({statusTotal})</option>
        {
          statusOptions.map((option) => (
            <option value={option.status} selected={option.status === statusFilter}>
              {option.label} ({option.count})
            </option>
          ))
        }
      </select>
    </div>

    <button
      type="submit"
      class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium transition-colors hover:bg-surface-sunken"
    >
      Filter
    </button>
  </form>

  {
    contentTypes.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-content-muted">
        Create a content type before adding content.
      </p>
    ) : items.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-content-muted">
        {filtered ? 'No content matches that filter.' : 'No content items yet.'}
      </p>
    ) : (
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="w-full text-left text-sm">
          <caption class="sr-only-focusable">Content items, ordered by path</caption>
          <thead class="bg-surface-sunken text-xs uppercase tracking-wide text-content-subtle">
            <tr>
              <th scope="col" class="px-4 py-2.5 font-medium">Title</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Type</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Path</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Status</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Updated</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Created</th>
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr class="border-t border-border">
                <th scope="row" class="px-4 py-2.5 font-medium">
                  {/* Indentation communicates hierarchy visually; the path column carries it
                      non-visually so the tree is not conveyed by appearance alone. */}
                  <span style={`padding-left:${item.depth * 1.25}rem`} class="inline-block">
                    <a href={`/admin/content/${item.id}`} class="hover:underline">
                      {item.title}
                    </a>
                  </span>
                </th>
                <td class="px-4 py-2.5 text-content-muted">
                  {typeNames.get(item.content_type_id) ?? '—'}
                </td>
                <td class="px-4 py-2.5 font-mono text-xs text-content-muted">{item.path}</td>
                <td class="px-4 py-2.5">
                  <StatusBadge status={item.status} />
                </td>
                <td class="px-4 py-2.5 text-content-muted">
                  <Timestamp value={item.updated_at} />
                </td>
                <td class="px-4 py-2.5 text-content-muted">
                  <Timestamp value={item.created_at} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
