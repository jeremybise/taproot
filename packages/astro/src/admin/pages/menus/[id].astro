---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  getMenu,
  listItems,
  listMenuItems,
  listTaxonomies,
  listTerms,
  resolveMenu,
  type ResolvedMenuItem,
} from '@taproot/core';
import { getTaproot, loginRedirect, canManageSchema } from '../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;
if (!canManageSchema(user)) return Astro.redirect('/admin');

const menu = await getMenu(taproot.db.db, Astro.params.id!);
if (!menu) return new Response('Menu not found', { status: 404 });

const rows = await listMenuItems(taproot.db.db, menu.id);

/**
 * Resolved with `publishedOnly: false` so entries pointing at a draft or a deleted page are still
 * listed. Hiding them here would leave a broken menu with no screen that admits it exists.
 */
const resolved = await resolveMenu(taproot.db.db, menu.api_id, { publishedOnly: false });

function flattenResolved(nodes: ResolvedMenuItem[]): ResolvedMenuItem[] {
  return nodes.flatMap((node) => [node, ...flattenResolved(node.children)]);
}
const resolvedById = new Map(flattenResolved(resolved).map((node) => [node.id, node]));

// Candidate link targets. Capped: a picker listing thousands of pages is unusable anyway, and the
// menus that matter are built from a site's top-level structure.
const { items: pages } = await listItems(taproot.db.db, { limit: 200 });
const taxonomies = await listTaxonomies(taproot.db.db);
const termChoices = (
  await Promise.all(
    taxonomies.map(async (taxonomy) =>
      (await listTerms(taproot.db.db, taxonomy.id)).map((term) => ({
        id: term.id,
        label: `${taxonomy.name}: ${term.name}`,
      })),
    ),
  )
).flat();

// Ordered for display: parents before their own children.
function ordered(parentId: string | null, depth = 0): { row: (typeof rows)[number]; depth: number }[] {
  return rows
    .filter((row) => row.parent_id === parentId)
    .sort((a, b) => a.position - b.position)
    .flatMap((row) => [{ row, depth }, ...ordered(row.id, depth + 1)]);
}
const displayRows = ordered(null);

const brokenCount = displayRows.filter(
  (entry) => resolvedById.get(entry.row.id)?.brokenReason === 'deleted',
).length;

const created = Astro.url.searchParams.get('created');
const added = Astro.url.searchParams.get('added');
const updated = Astro.url.searchParams.get('updated');
const deleted = Astro.url.searchParams.get('deleted');
const error = Astro.url.searchParams.get('error');

const flash = created
  ? 'Menu created. Add its first item below.'
  : added
    ? 'Item added.'
    : updated
      ? 'Item saved.'
      : deleted
        ? 'Item removed.'
        : null;

const inputClass =
  'mt-1 w-full rounded-md border border-border-strong bg-surface px-3 py-1.5 text-sm';
---

<AdminLayout
  title={menu.name}
  user={user}
  breadcrumbs={[{ label: 'Menus', href: '/admin/menus' }, { label: menu.name }]}
  flash={flash}
>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">{menu.name}</h1>
    <p class="mt-1 max-w-prose text-sm text-content-muted">
      <code class="font-mono text-xs">{menu.api_id}</code> ·
      {` ${displayRows.length} ${displayRows.length === 1 ? 'item' : 'items'}`}
    </p>
  </header>

  <div role="alert" aria-live="assertive">
    {
      error && (
        <p class="mb-6 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
          {error}
        </p>
      )
    }
  </div>

  {
    brokenCount > 0 && (
      <p class="mb-6 rounded-md border border-warning bg-warning-subtle px-4 py-3 text-sm">
        <strong class="font-semibold">
          {brokenCount} {brokenCount === 1 ? 'item points' : 'items point'} at deleted content.
        </strong>{' '}
        Visitors never see these, but they stay listed here so they can be re-pointed or removed.
      </p>
    )
  }

  <!--
    Three separate add forms rather than one form that shows and hides fields by target type.
    Each is a fieldset with its own legend, so the grouping is announced rather than implied by
    layout, and no field is present-but-irrelevant. It also works with no JavaScript at all.
  -->
  <section aria-labelledby="add-heading" class="mb-8">
    <h2 id="add-heading" class="mb-3 text-base font-semibold">Add an item</h2>

    <div class="grid gap-4 lg:grid-cols-3">
      {
        [
          {
            key: 'item',
            legend: 'Link to a page',
            hint: 'Follows the page if it moves, and disappears from the site if it is unpublished.',
          },
          {
            key: 'term',
            legend: 'Link to a term',
            hint: 'Points at a term archive listing everything filed under it.',
          },
          {
            key: 'url',
            legend: 'Link to an address',
            hint: 'Anything external, or a path this CMS does not manage.',
          },
        ].map(({ key, legend, hint }) => (
          <form
            method="post"
            action={`/api/taproot/menus/${menu.id}/items`}
            class="rounded-lg border border-border bg-surface-raised p-4"
          >
            <input type="hidden" name="targetType" value={key} />
            <fieldset>
              <legend class="text-sm font-medium">{legend}</legend>
              <p id={`${key}-hint`} class="mt-0.5 mb-2 text-xs text-content-subtle">
                {hint}
              </p>

              {key === 'item' && (
                <div>
                  <label for="add-item-page" class="block text-xs font-medium">
                    Page
                  </label>
                  <select
                    id="add-item-page"
                    name="contentItemId"
                    required
                    aria-describedby="item-hint"
                    class={inputClass}
                  >
                    {pages.map((page) => (
                      <option value={page.id}>
                        {page.title} ({page.path})
                      </option>
                    ))}
                  </select>
                </div>
              )}

              {key === 'term' && (
                <div>
                  <label for="add-term" class="block text-xs font-medium">
                    Term
                  </label>
                  <select
                    id="add-term"
                    name="termId"
                    required
                    aria-describedby="term-hint"
                    class={inputClass}
                  >
                    {termChoices.length === 0 && <option value="">No terms exist yet</option>}
                    {termChoices.map((term) => (
                      <option value={term.id}>{term.label}</option>
                    ))}
                  </select>
                </div>
              )}

              {key === 'url' && (
                <div>
                  <label for="add-url" class="block text-xs font-medium">
                    Address
                  </label>
                  <input
                    id="add-url"
                    name="url"
                    type="text"
                    required
                    placeholder="https://example.edu"
                    aria-describedby="url-hint"
                    class={inputClass}
                  />
                </div>
              )}

              <div class="mt-2">
                <label for={`add-label-${key}`} class="block text-xs font-medium">
                  Label {key !== 'url' && <span class="text-content-subtle">(optional)</span>}
                </label>
                <input
                  id={`add-label-${key}`}
                  name="label"
                  maxlength="120"
                  required={key === 'url'}
                  class={inputClass}
                />
              </div>

              <div class="mt-2">
                <label for={`add-parent-${key}`} class="block text-xs font-medium">
                  Nested under
                </label>
                <select id={`add-parent-${key}`} name="parentId" class={inputClass}>
                  <option value="">Top level</option>
                  {displayRows.map(({ row, depth }) => (
                    <option value={row.id}>
                      {`${'— '.repeat(depth)}${resolvedById.get(row.id)?.label ?? 'Untitled'}`}
                    </option>
                  ))}
                </select>
              </div>

              <button
                type="submit"
                class="mt-3 w-full rounded-md bg-accent px-3 py-1.5 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
              >
                Add
              </button>
            </fieldset>
          </form>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="items-heading">
    <h2 id="items-heading" class="mb-3 text-base font-semibold">Items</h2>

    {
      displayRows.length === 0 ? (
        <p class="rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-content-muted">
          This menu has no items yet.
        </p>
      ) : (
        <ul class="space-y-2">
          {displayRows.map(({ row, depth }) => {
            const node = resolvedById.get(row.id);
            return (
              <li style={`margin-left:${depth * 1.5}rem`}>
                <div class="rounded-lg border border-border bg-surface-raised px-4 py-3">
                  <form
                    method="post"
                    action={`/api/taproot/menu-items/${row.id}`}
                    class="flex flex-wrap items-end gap-3"
                  >
                    <input type="hidden" name="targetType" value={row.target_type} />
                    <input type="hidden" name="contentItemId" value={row.content_item_id ?? ''} />
                    <input type="hidden" name="termId" value={row.term_id ?? ''} />
                    <input type="hidden" name="url" value={row.url ?? ''} />

                    <div class="min-w-40 flex-1">
                      {/*
                        The item's own label goes in the field label as screen-reader text.
                        Without it, a menu of a dozen entries announces "Label" a dozen times with
                        nothing to tell them apart.
                      */}
                      <label for={`label-${row.id}`} class="block text-xs font-medium">
                        Label
                        <span class="sr-only-focusable"> for {node?.label ?? 'this item'}</span>
                      </label>
                      <input
                        id={`label-${row.id}`}
                        name="label"
                        value={row.label ?? ''}
                        placeholder={node?.label ?? ''}
                        maxlength="120"
                        class={inputClass}
                      />
                    </div>

                    <div class="min-w-40 flex-1">
                      <label for={`parent-${row.id}`} class="block text-xs font-medium">
                        Nested under
                        <span class="sr-only-focusable"> for {node?.label ?? 'this item'}</span>
                      </label>
                      <select id={`parent-${row.id}`} name="parentId" class={inputClass}>
                        <option value="" selected={row.parent_id === null}>
                          Top level
                        </option>
                        {displayRows
                          .filter((candidate) => candidate.row.id !== row.id)
                          .map((candidate) => (
                            <option
                              value={candidate.row.id}
                              selected={row.parent_id === candidate.row.id}
                            >
                              {`${'— '.repeat(candidate.depth)}${
                                resolvedById.get(candidate.row.id)?.label ?? 'Untitled'
                              }`}
                            </option>
                          ))}
                      </select>
                    </div>

                    <button
                      type="submit"
                      class="rounded-md border border-border-strong px-3 py-1.5 text-sm font-medium transition-colors hover:bg-surface-sunken"
                    >
                      Save<span class="sr-only-focusable"> {node?.label ?? 'this item'}</span>
                    </button>
                  </form>

                  <div class="mt-2 flex flex-wrap items-center gap-3 text-xs">
                    <span class="rounded-full border border-border px-2 py-0.5 capitalize text-content-subtle">
                      {row.target_type === 'item'
                        ? 'Page'
                        : row.target_type === 'term'
                          ? 'Term'
                          : 'Address'}
                    </span>

                    {node?.brokenReason === 'deleted' ? (
                      <span class="text-warning">
                        Target was deleted — hidden from visitors
                      </span>
                    ) : node?.brokenReason === 'unpublished' ? (
                      <span class="text-content-subtle">
                        Target is not published — hidden from visitors
                      </span>
                    ) : (
                      <code class="font-mono text-content-subtle">{node?.href}</code>
                    )}

                    <form method="post" action={`/api/taproot/menu-items/${row.id}`}>
                      <input type="hidden" name="_method" value="delete" />
                      <button type="submit" class="text-danger transition-colors hover:underline">
                        Remove<span class="sr-only-focusable"> {node?.label ?? 'this item'}</span>
                      </button>
                    </form>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <p class="mt-8 max-w-prose text-sm text-content-subtle">
    Removing an item removes anything nested under it — a dropdown's contents have no meaning
    without the thing they hang off. Reordering within a level is a later increment; the "nested
    under" control already does every move between levels.
  </p>
</AdminLayout>
