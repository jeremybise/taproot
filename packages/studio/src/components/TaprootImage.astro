---
import { cropFrame, resolveCrop, type MediaCropSource } from '@taproot/core';
import { getTaproot } from '../runtime/guards.js';

/**
 * An image rendered at a target aspect ratio, honouring its stored focal point and crop.
 *
 * This is the delivery half of the hotspot editor. For two phases the editor stored a focal point
 * and a crop that nothing read: the demo templates used `object-fit: cover`, which centre-crops,
 * so an editor could carefully place a face and watch the site cut it out. `resolveCrop` was
 * called only by the editor's own preview frames.
 *
 * The maths is core's, unchanged and already tested across every combination of source
 * orientation, target ratio, and hotspot position. This component is the wrapper that turns the
 * rectangle into markup — and it owns the wrapper deliberately, because `cropFrame` only avoids
 * distorting the image if the box carries the same aspect ratio the rectangle was resolved for.
 *
 * A Cloudflare Image Resizing URL is the natural next step and belongs with the image-transform
 * endpoint in the standalone-server phase: it cannot be exercised under `npm run dev`, which runs
 * on Node, and passing the same rectangle to a CDN is a change of `src` rather than of shape.
 */
interface Props {
  /**
   * The asset. Everything needed to resolve a crop plus what it takes to render.
   *
   * Passed in rather than fetched by id so a caller rendering a gallery keeps its single batched
   * query — `where id in (...)` once beats one lookup per image.
   */
  asset: MediaCropSource & {
    storage_key: string;
    alt_text?: string | null;
    mime_type?: string | null;
  };
  /** Width ÷ height. `16 / 9`, `1`, `1200 / 630`. */
  ratio: number;
  /**
   * Overrides the asset's own alt text.
   *
   * An empty string is meaningful and passed through: it marks the image decorative, which is
   * correct when an adjacent heading already carries the meaning. That is why this is not defaulted
   * with `??` on the way in.
   */
  alt?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { asset, ratio, alt, loading = 'lazy', class: className } = Astro.props;

const taproot = getTaproot(Astro.locals);
const src = taproot.storage.publicUrl(asset.storage_key);

const frame = cropFrame(resolveCrop(asset, ratio));

/**
 * Alt text comes from the library, where it is authored once and reused everywhere the asset
 * appears — unless the call site overrides it. `null` alt text is an asset nobody has described
 * yet, and an empty string is the least-wrong rendering: a filename read aloud is worse than
 * silence.
 */
const altText = alt ?? asset.alt_text ?? '';
---

<div class:list={['taproot-image', className]} style={`--taproot-image-ratio:${ratio}`}>
  <img src={src} alt={altText} loading={loading} decoding="async" style={frame} />
</div>

<style>
  .taproot-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--taproot-image-ratio);
  }

  /*
    Positioned and sized entirely by the inline style above, which is the resolved rectangle.
    `max-width: none` because a site-wide `img { max-width: 100% }` — which nearly every stylesheet
    has — would otherwise clamp the scaled-up image back to the container and undo the crop.
  */
  .taproot-image img {
    position: absolute;
    max-width: none;
  }
</style>
