---
import '../admin.css';
import { MIN_PASSWORD_LENGTH, resolvePasswordResetToken } from '@taprootcms/core';
import { getTaproot } from '../../runtime/guards.js';
import { resolveTheme, themeAttribute, THEME_COOKIE_NAME } from '../theme.js';

/**
 * Set a password from a one-time link.
 *
 * Unauthenticated, and safely so: the token is the authentication. It is resolved here before the
 * form renders so an expired or spent link says so plainly rather than inviting someone to type a
 * password that will be refused.
 */
const taproot = getTaproot(Astro.locals);

const token = Astro.url.searchParams.get('token') ?? '';
const error = Astro.url.searchParams.get('error');
const user = token ? await resolvePasswordResetToken(taproot.db.db, token) : undefined;
const canRequestAnother = taproot.auth.passwordAuthEnabled && taproot.mail.delivers;

const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE_NAME)?.value);
---

<html lang="en" data-theme={themeAttribute(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Set your password · Taproot</title>
  </head>
  <body class="min-h-screen bg-surface-sunken text-content">
    <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6 py-12">
      <div class="rounded-xl border border-border bg-surface-raised p-8 shadow-sm">
        <h1 class="flex items-center gap-2 text-xl font-semibold tracking-tight">
          <span aria-hidden="true" class="text-accent">◆</span>
          Set your password
        </h1>

        {
          !user ? (
            <>
              <p class="mt-4 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
                This link is not valid. It may have expired, already been used, or been replaced by
                a newer one.{' '}
                {/*
                  Where the site can send mail, the person is one click from fixing this
                  themselves; where it cannot, telling them to request one leads to a page that
                  redirects straight back here.
                */}
                {canRequestAnother ? (
                  <a href="/admin/forgot-password" class="font-medium underline underline-offset-2">
                    Request another
                  </a>
                ) : (
                  'Ask an administrator to send another'
                )}.
              </p>
              <a
                href="/admin/login"
                class="mt-5 inline-block text-sm font-medium underline-offset-2 hover:underline"
              >
                Back to sign in
              </a>
            </>
          ) : (
            <>
              <p class="mt-2 text-sm text-content-muted">
                Choose a password for <strong>{user.email}</strong>. You will be signed in
                afterwards, and any other sessions for this account are ended.
              </p>

              <div role="alert" aria-live="assertive">
                {error && (
                  <p class="mt-5 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
                    {error}
                  </p>
                )}
              </div>

              <form method="post" action="/api/taproot/auth/set-password" class="mt-6 space-y-4">
                <input type="hidden" name="token" value={token} />

                {/*
                  A hidden, filled-in username field so a password manager knows which account it
                  is saving for. Without it, managers commonly save the entry with no username and
                  fail to offer it at the login form afterwards.
                */}
                <input type="hidden" name="email" value={user.email} autocomplete="username" />

                <div>
                  <label for="password" class="block text-sm font-medium">
                    New password
                  </label>
                  <input
                    id="password"
                    name="password"
                    type="password"
                    required
                    minlength={MIN_PASSWORD_LENGTH}
                    autocomplete="new-password"
                    autofocus
                    aria-describedby="password-hint"
                    class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
                  />
                  <p id="password-hint" class="mt-1.5 text-xs text-content-subtle">
                    At least {MIN_PASSWORD_LENGTH} characters.
                  </p>
                </div>

                <div>
                  <label for="confirm" class="block text-sm font-medium">
                    Confirm password
                  </label>
                  <input
                    id="confirm"
                    name="confirm"
                    type="password"
                    required
                    minlength={MIN_PASSWORD_LENGTH}
                    autocomplete="new-password"
                    class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
                  />
                </div>

                <button
                  type="submit"
                  class="w-full rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
                >
                  Set password and sign in
                </button>
              </form>
            </>
          )
        }
      </div>
    </main>
  </body>
</html>
