---
import '../admin.css';
import { getTaproot } from '../../runtime/guards.js';
import { resolveTheme, themeAttribute, THEME_COOKIE_NAME } from '../theme.js';
import { adminBranding } from '../branding.js';
import BrandHead from '../components/BrandHead.astro';
import BrandMark from '../components/BrandMark.astro';

/**
 * Ask for a reset link.
 *
 * Reachable only when the deployment can actually send one — with no mailer configured the link to
 * here is not rendered on the login page and this redirects, because a form that quietly posts into
 * a server log is worse than a page that says an administrator has to help.
 */
const taproot = getTaproot(Astro.locals);

if (taproot.user) return Astro.redirect('/admin');
if (!taproot.auth.passwordAuthEnabled || !taproot.mail.delivers) {
  return Astro.redirect('/admin/login');
}

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');

const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE_NAME)?.value);
const branding = await adminBranding(taproot.db.db, taproot.storage);
---

<html lang="en" data-theme={themeAttribute(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <BrandHead branding={branding} title={`Reset your password · ${branding.resolvedTitle}`} />
  </head>
  <body class="min-h-screen bg-surface-sunken text-content">
    <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6 py-12">
      <div class="rounded-xl border border-border bg-surface-raised p-8 shadow-sm">
        <h1 class="flex items-center gap-2 text-xl font-semibold tracking-tight">
          <BrandMark branding={branding} size="h-6" />
          Reset your password
        </h1>

        {
          sent ? (
            /*
              Says "if" rather than "we sent", and names no account. The wording is the whole
              anti-enumeration measure on this screen — an unknown address reaches exactly this
              page, with exactly this text, having caused no mail to be sent.
            */
            <>
              <p
                role="status"
                class="mt-5 rounded-md border border-success bg-success-subtle px-4 py-3 text-sm"
              >
                If that address belongs to an account here, a reset link is on its way. It works
                once and expires in two days.
              </p>
              <p class="mt-4 text-sm text-content-muted">
                Nothing arrived? Check the spam folder, then ask an administrator — they can
                generate a link directly.
              </p>
              <a
                href="/admin/login"
                class="mt-5 inline-block text-sm font-medium underline-offset-2 hover:underline"
              >
                Back to sign in
              </a>
            </>
          ) : (
            <>
              <p class="mt-2 text-sm text-content-muted">
                Enter the address you sign in with and we will send a link for choosing a new
                password.
              </p>

              <div role="alert" aria-live="assertive">
                {error && (
                  <p class="mt-5 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
                    {error}
                  </p>
                )}
              </div>

              <form
                method="post"
                action="/api/taproot/auth/forgot-password"
                class="mt-6 space-y-4"
              >
                <div>
                  <label for="email" class="block text-sm font-medium">
                    Email
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="username"
                    autofocus
                    class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
                  />
                </div>

                <button
                  type="submit"
                  class="w-full rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
                >
                  Send a reset link
                </button>
              </form>

              <a
                href="/admin/login"
                class="mt-5 inline-block text-sm font-medium underline-offset-2 hover:underline"
              >
                Back to sign in
              </a>
            </>
          )
        }
      </div>
    </main>
  </body>
</html>
