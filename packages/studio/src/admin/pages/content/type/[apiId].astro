---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import TruncationNotice from '../../../components/TruncationNotice.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import Timestamp from '../../../components/Timestamp.astro';
import {
  ITEM_SORT_LABELS,
  countItemsByStatus,
  getContentTypeByApiId,
  fieldValueText,
  listItemSummaries,
  loadItemData,
  resolveListColumns,
  resolveListSort,
  summaryLabel,
  termIdsForBranch,
} from '@taprootcms/core';
import { mediaOptionsByIds } from '../../../mediaOptions.js';
import { taxonomyFilterOptions } from '../../../termOptions.js';
import { parseStatusFilter, statusFilterOptions } from '../../../status.js';
import { getTaproot, loginRedirect, canEditContent } from '../../../../runtime/guards.js';

/**
 * One content type's items.
 *
 * A separate route from `/admin/content` rather than a query parameter on it: each type is its own
 * sidebar destination, so it needs its own URL to be linkable, bookmarkable, and markable with
 * `aria-current`. `/content/type/{api_id}` rather than `/content/{api_id}` because
 * `/content/{id}` already means a content item, and one segment cannot mean both.
 */
const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;

const contentType = await getContentTypeByApiId(taproot.db.db, Astro.params.apiId!);
if (!contentType) return new Response('Content type not found', { status: 404 });

// A singleton has exactly one item and no list worth showing; its sidebar entry opens the editor.
if (contentType.kind === 'singleton') {
  return Astro.redirect(`/admin/singleton/${contentType.api_id}`);
}

const search = Astro.url.searchParams.get('q') ?? '';
const statusFilter = parseStatusFilter(Astro.url.searchParams.get('status'));

const termFilter = Astro.url.searchParams.get('term') ?? '';

/**
 * Only the taxonomies this type can actually carry.
 *
 * `/admin/content` offers every taxonomy because it lists everything; here, offering a term no
 * item of this type could ever hold would be a filter guaranteed to return nothing.
 */
const typeTaxonomyIds = new Set(
  contentType.fields
    .filter((field) => field.type === 'taxonomy')
    .map((field) => {
      try {
        return (JSON.parse(field.config) as { taxonomyId?: string | null }).taxonomyId ?? null;
      } catch {
        return null;
      }
    })
    .filter((id): id is string => Boolean(id)),
);

const termGroups = typeTaxonomyIds.size
  ? (await taxonomyFilterOptions(taproot.db.db)).filter((group) => typeTaxonomyIds.has(group.id))
  : [];

// The branch, not just the term — see the same expansion on /admin/content.
const termIds = termFilter ? await termIdsForBranch(taproot.db.db, termFilter) : undefined;

const facetFilters = { contentTypeId: contentType.id, search: search || undefined, termIds };

/**
 * The columns and order this type asks for, resolved against the fields that exist *now*.
 *
 * A key naming a deleted field is dropped and a sort naming one falls back to `path`, both in core
 * — see `listColumns.ts`. Neither is an error: the preference is edited on one screen and the fields
 * on another, so they go out of step as a matter of course.
 */
const columns = resolveListColumns(contentType, contentType.fields);
const listSort = resolveListSort(contentType, contentType.fields);

const [{ items, total }, statusCounts] = await Promise.all([
  listItemSummaries(taproot.db.db, {
    ...facetFilters,
    status: statusFilter,
    limit: 200,
    ...listSort,
  }),
  countItemsByStatus(taproot.db.db, facetFilters),
]);

/**
 * Stored values for this page of rows, loaded when anything on screen needs them.
 *
 * Needed by the summary template and by any field column, so it is fetched once for both rather
 * than twice — and **once for the page rather than once per row**, which is the rule
 * `resolveDelivery` follows for its own lookups. A type with no template and only built-in columns
 * costs exactly what it did before: nothing.
 */
const fieldColumns = columns.filter((column) => column.field);
const needsData = Boolean(contentType.summary_template) || fieldColumns.length > 0;

const itemData = needsData
  ? await loadItemData(taproot.db.db, items.map((item) => item.id))
  : null;

const summaryData = contentType.summary_template ? itemData : null;

/**
 * Thumbnails for any `media` column, in one query for the whole page.
 *
 * A media value is an id, and `content_item_values` carries text, numbers and dates — so this is the
 * one column type that cannot come from the value index and has to be resolved from `data`.
 */
const thumbnailFields = columns.filter((column) => column.thumbnail).map((column) => column.field!);
const thumbnailIds = new Set<string>();
if (itemData && thumbnailFields.length > 0) {
  for (const values of itemData.values()) {
    for (const field of thumbnailFields) {
      const value = values[field.api_id];
      // A media field stores a bare id when single and an ordered array when it allows several; a
      // column shows the first either way, since a row has space for one picture.
      const first = Array.isArray(value) ? value[0] : value;
      if (typeof first === 'string' && first) thumbnailIds.add(first);
    }
  }
}

const thumbnails = new Map(
  thumbnailIds.size > 0
    ? (await mediaOptionsByIds(taproot.db.db, taproot.storage, [...thumbnailIds])).map((asset) => [
        asset.id,
        asset,
      ])
    : [],
);

/** One cell's text, or an image when the column is a thumbnail. */
function cellText(item: (typeof items)[number], column: (typeof columns)[number]): string {
  const values = itemData?.get(item.id) ?? {};
  return fieldValueText(column.field ?? undefined, values[column.field!.api_id]);
}

function cellImage(item: (typeof items)[number], column: (typeof columns)[number]) {
  const values = itemData?.get(item.id) ?? {};
  const value = values[column.field!.api_id];
  const first = Array.isArray(value) ? value[0] : value;
  return typeof first === 'string' ? (thumbnails.get(first) ?? null) : null;
}

const labelFor = (item: (typeof items)[number]) =>
  summaryData
    ? summaryLabel(contentType.summary_template, contentType.fields, summaryData.get(item.id) ?? {}, item.title)
    : item.title;

/**
 * What the table's caption says it is ordered by.
 *
 * Named rather than left as "path" for every list: the caption is the only place a screen-reader
 * user is told the order, and saying "path" on a list actually sorted by start date is worse than
 * saying nothing. Reads the *resolved* sort, so a preference that fell back reports the fallback.
 */
const sortCaption = (() => {
  if (!listSort.sortField) return ITEM_SORT_LABELS[listSort.sort].toLowerCase();

  const field = contentType.fields.find((f) => f.api_id === listSort.sortField!.apiId);
  const descending = listSort.sort === 'field_desc';

  /*
   * Worded by the field's kind rather than reusing `ITEM_SORT_LABELS`.
   *
   * Those two labels are deliberately generic — "Soonest first" — because the query field's control
   * does not know what it is ordering by. Here we do, and "Position, soonest first" on a text field
   * is simply wrong. The caption is the only place a screen-reader user is told the order, so it is
   * worth getting right rather than reusing a string that happens to exist.
   */
  const direction =
    listSort.sortField.kind === 'date'
      ? descending
        ? 'latest first'
        : 'soonest first'
      : listSort.sortField.kind === 'number'
        ? descending
          ? 'highest first'
          : 'lowest first'
        : descending
          ? 'Z to A'
          : 'A to Z';

  return `${field?.label ?? 'a field'}, ${direction}`;
})();

const statusOptions = statusFilterOptions(statusCounts, statusFilter);
const statusTotal = Object.values(statusCounts).reduce((sum, n) => sum + n, 0);
const filtered = Boolean(search || statusFilter || termFilter);
const isHierarchical = contentType.kind === 'page';
const plural = contentType.name_plural.toLowerCase();
---

<AdminLayout
  title={contentType.name_plural}
  user={user}
  breadcrumbs={[{ label: contentType.name_plural }]}
>
  <PageHeader
    title={contentType.name_plural}
    meta={`${total} ${total === 1 ? 'item' : 'items'}${filtered ? ' matching this filter' : ''}`}
  >
    {
      canEditContent(user) && (
        <a
          slot="actions"
          href={`/admin/content/new?type=${contentType.id}`}
          class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
        >
          New {contentType.name.toLowerCase()}
        </a>
      )
    }
  </PageHeader>

  {/* Below the sticky bar, not in it: a type's description is prose and can run to a paragraph. */}
  {
    contentType.description && (
      <p class="mb-6 max-w-prose text-sm text-content-muted">{contentType.description}</p>
    )
  }

  <form method="get" class="mb-6 flex flex-wrap items-end gap-3">
    <div class="min-w-48 flex-1 sm:max-w-sm">
      <label for="q" class="block text-sm font-medium">
        Search {plural}
      </label>
      <input
        id="q"
        name="q"
        type="search"
        value={search}
        placeholder="Title or path"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      />
    </div>

    {
      termGroups.length > 0 && (
        <div>
          <label for="term" class="block text-sm font-medium">
            Tagged
          </label>
          <select
            id="term"
            name="term"
            class="mt-1.5 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
          >
            <option value="">Any term</option>
            {termGroups.map((group) => (
              <optgroup label={group.name}>
                {group.terms.map((term) => (
                  <option value={term.id} selected={term.id === termFilter}>
                    {' '.repeat(term.depth * 2)}
                    {term.name}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
      )
    }

    <div>
      <label for="status" class="block text-sm font-medium">Status</label>
      <select
        id="status"
        name="status"
        class="mt-1.5 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      >
        {/*
          Counts honour the search but ignore the status filter, so each number answers "what
          would I get if I switched to this?" rather than restating the rows already on screen.
        */}
        <option value="">All statuses ({statusTotal})</option>
        {
          statusOptions.map((option) => (
            <option value={option.status} selected={option.status === statusFilter}>
              {option.label} ({option.count})
            </option>
          ))
        }
      </select>
    </div>

    <button
      type="submit"
      class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium transition-colors hover:bg-surface-sunken"
    >
      Filter
    </button>
  </form>

  {
    items.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-content-muted">
        {filtered ? `No ${plural} match that filter.` : `No ${plural} yet.`}
      </p>
    ) : (
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="w-full text-left text-sm">
          <caption class="sr-only-focusable">
            {contentType.name_plural}, ordered by {sortCaption}
          </caption>
          <thead class="bg-surface-sunken text-xs uppercase tracking-wide text-content-subtle">
            <tr>
              {columns.map((column) => (
                <th scope="col" class="px-4 py-2.5 font-medium">
                  {column.label}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr class="border-t border-border">
                {columns.map((column) =>
                  column.key === 'title' ? (
                    <th scope="row" class="px-4 py-2.5 font-medium">
                      {/*
                        Indentation shows the tree visually; the path column carries the same
                        information non-visually, so hierarchy is never conveyed by appearance
                        alone. Flat types get no indent because there is none to convey.
                      */}
                      <span
                        style={isHierarchical ? `padding-left:${item.depth * 1.25}rem` : undefined}
                        class="inline-block"
                      >
                        <a href={`/admin/content/${item.id}`} class="hover:underline">
                          {labelFor(item)}
                        </a>
                      </span>
                    </th>
                  ) : column.key === 'path' ? (
                    <td class="px-4 py-2.5 font-mono text-xs text-content-muted">{item.path}</td>
                  ) : column.key === 'status' ? (
                    <td class="px-4 py-2.5">
                      <StatusBadge status={item.status} />
                    </td>
                  ) : column.key === 'updated' ? (
                    <td class="px-4 py-2.5 text-content-muted">
                      <Timestamp value={item.updated_at} />
                    </td>
                  ) : column.key === 'created' ? (
                    <td class="px-4 py-2.5 text-content-muted">
                      <Timestamp value={item.created_at} />
                    </td>
                  ) : column.thumbnail ? (
                    <td class="px-4 py-2">
                      {/*
                        `alt=""` because the row's title is right beside it and already names the
                        item — a thumbnail that announced the asset's own alt text would make a
                        screen reader read the row twice (WCAG 1.1.1). A row with no image keeps an
                        empty cell rather than collapsing, so the columns stay aligned.
                      */}
                      {cellImage(item, column) ? (
                        <img
                          src={cellImage(item, column)!.url}
                          alt=""
                          loading="lazy"
                          width="56"
                          height="40"
                          class="h-10 w-14 rounded border border-border bg-surface-sunken object-cover"
                        />
                      ) : (
                        <span class="sr-only-focusable">No image</span>
                      )}
                    </td>
                  ) : (
                    <td class="px-4 py-2.5 text-content-muted">
                      <span class="line-clamp-2">{cellText(item, column)}</span>
                    </td>
                  ),
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <TruncationNotice shown={items.length} total={total} noun="item" />
</AdminLayout>
