---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ItemEditor from '../../islands/ItemEditor.tsx';
import RevisionHistory from '../../components/RevisionHistory.astro';
import ReferencedBy from '../../components/ReferencedBy.astro';
import DangerZone from '../../components/DangerZone.astro';
import Sheet from '../../components/Sheet.astro';
import { termOptionsForFields } from '../../termOptions.js';
import { relationTargetsForFields } from '../../relationOptions.js';
import {
  blockTypeOptionsForFields,
  reusableBlockOptionsForFields,
} from '../../blockTypeOptions.js';
import { findImage, mediaOptions, referencedMediaOptions } from '../../mediaOptions.js';
import ReleaseBadge from '../../components/ReleaseBadge.astro';
import {
  getContentType,
  getItem,
  getRelease,
  getStagedItem,
  itemDeleteImpact,
  kindHasPublicPath,
  listItems,
  openReleasesForItem,
  previewSiteUrl,
  releasesAvailableFor,
} from '@taprootcms/core';
import { resolvePreviewPane, PREVIEW_PANE_COOKIE_NAME } from '../../previewPane.js';
import {
  getTaproot,
  loginRedirect,
  canEditContent,
  canPublishContent,
  canStageToRelease,
} from '../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;
if (!canEditContent(user)) return Astro.redirect('/admin');

const item = await getItem(taproot.db.db, Astro.params.id!);
if (!item) return new Response('Content item not found', { status: 404 });

const contentType = await getContentType(taproot.db.db, item.content_type_id);
if (!contentType) return new Response('Content type not found', { status: 404 });

let parents: { id: string; title: string; path: string }[] = [];
if (contentType.kind === 'page') {
  const { items } = await listItems(taproot.db.db, { contentTypeId: contentType.id, limit: 200 });
  // An item cannot be its own parent, and cannot be moved under its own descendants — the server
  // rejects that too, but filtering here keeps the invalid option out of the menu entirely.
  parents = items
    .filter((candidate) => candidate.id !== item.id && !candidate.path.startsWith(`${item.path}/`))
    .map((candidate) => ({ id: candidate.id, title: candidate.title, path: candidate.path }));
}

/**
 * Release mode: `?release=` swaps which version of this item the editor is editing.
 *
 * One screen rather than a second editor under `/admin/releases/…/items/…`. The fields, the media
 * picker, the block editor, and the SEO panel are identical either way — a parallel screen would be
 * a copy of all of it, differing in one endpoint and drifting from the day it was written. What
 * changes is the source of `initial` and where a save goes, both of which are props.
 */
const requestedReleaseId = Astro.url.searchParams.get('release');
const release = requestedReleaseId
  ? await getRelease(taproot.db.db, requestedReleaseId)
  : undefined;

const staged =
  release && release.status !== 'published'
    ? await getStagedItem(taproot.db.db, release.id, item.id)
    : undefined;

/**
 * A `?release=` naming something this item is not in falls back to editing the live page.
 *
 * The alternative — 404 — would be right if the URL were wrong, but the common way to reach this
 * state is having the item removed from the release in another tab, where the useful outcome is the
 * editor they were going to need anyway.
 */
const releaseMode = release && staged ? { id: release.id, name: release.name } : null;

// Which unpublished releases already hold this item, and which open ones could. Both are read for
// every editor because both are shown: the first as a banner, the second as the "Add to" control.
const [inReleases, addableReleases] = canStageToRelease(user)
  ? await Promise.all([
      openReleasesForItem(taproot.db.db, item.id),
      releasesAvailableFor(taproot.db.db, item.id),
    ])
  : [[], []];

const termsByTaxonomy = await termOptionsForFields(taproot.db.db, contentType.fields);

const relationTargets = await relationTargetsForFields(
  taproot.db.db,
  contentType.fields,
  // The staged version's own data, in release mode, so a relation stored only in the staged copy
  // still resolves to a title rather than a raw uuid.
  staged ? staged.data : item.data,
);

const blockTypes = await blockTypeOptionsForFields(taproot.db.db, contentType.fields);
const reusableBlocks = await reusableBlockOptionsForFields(taproot.db.db, contentType.fields);

// The whole library, not just images: a `media` field can accept documents, and the SEO panel
// narrows to images through the picker's accept list rather than by getting a narrower query.
const media = await mediaOptions(taproot.db.db, taproot.storage);
const defaultOgImage = findImage(media, contentType.default_og_image_id);

// For the accessibility panel: the staged data in release mode, matching `relationTargets` above —
// the version being edited is the version whose images should be checked.
const referencedMedia = await referencedMediaOptions(
  taproot.db.db,
  taproot.storage,
  contentType.fields,
  staged ? staged.data : item.data,
  { blockTypes, reusableBlocks },
);

/**
 * Deleting is an editor's action, and a singleton has no delete at all — its whole contract is
 * that exactly one exists, so removing it would leave the sidebar entry pointing at nothing until
 * someone visited it again.
 */
const canDelete = canPublishContent(user) && contentType.kind !== 'singleton';
const deleteImpact = canDelete
  ? await itemDeleteImpact(taproot.db.db, item.id)
  : { blockers: [], warnings: [] };

/**
 * The live preview pane, offered only where there is a page to point it at.
 *
 * `kindHasPublicPath` rather than `kind !== 'singleton'` written out a second time — the preview
 * link in the header gates on the same function, and two copies is how the two end up disagreeing.
 * A singleton's `/__singleton/{api_id}` would in fact render, because the delivery route resolves
 * the *token* rather than the path, which is precisely why this has to be refused rather than left
 * to look like it works.
 *
 * `siteConfigured` is passed rather than the URL itself: the pane needs to know whether to render
 * the configuration message, and the origin it frames comes back from the mint endpoint, which is
 * the one place that decides it.
 */
const previewPane = kindHasPublicPath(contentType.kind)
  ? {
      open: resolvePreviewPane(Astro.cookies.get(PREVIEW_PANE_COOKIE_NAME)?.value) === 'open',
      siteConfigured: Boolean(previewSiteUrl(process.env)),
    }
  : null;

const saved = Astro.url.searchParams.get('saved') === '1';
const updated = Astro.url.searchParams.get('updated') === '1';
const restored = Astro.url.searchParams.get('restored');

const error = Astro.url.searchParams.get('error');

const stagedFlash = Astro.url.searchParams.get('staged');

const flash = error
  ? error
  : saved
  ? 'Content item created.'
  : stagedFlash
    ? `Added to ${stagedFlash}. Edit the staged version from there, or from the banner above.`
    : updated
      ? releaseMode
        ? 'Saved to the release. The live page is unchanged.'
        : 'Changes saved.'
      : restored
        ? `Restored revision ${restored}. The restore was recorded as a new revision.`
        : null;
---

<AdminLayout
  title={item.title}
  user={user}
  breadcrumbs={[{ label: 'Content', href: '/admin/content' }, { label: item.title }]}
  flash={flash}
>
  {/*
    Plain, not `PageHeader`. This screen's floating bar is the island's — it has to carry Save, and
    Save is React state a server-rendered header cannot drive. Two sticky bars on one screen is
    worse than a title that scrolls away.
  */}
  <header class="mb-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">{item.title}</h1>
      <p class="mt-1 text-sm text-content-muted">
        {contentType.name} ·
        {
          item.status === 'published' ? (
            <a href={item.path} class="break-all font-mono hover:underline">
              {item.path}
            </a>
          ) : (
            <code class="break-all font-mono">{item.path}</code>
          )
        }
      </p>
    </div>

  </header>

  {
    /*
      The releases this item is waiting in, shown to everyone who can stage.

      An editor who opens a live page and starts typing has no other way to learn that the same page
      has a rewritten version queued for next Tuesday — and the two would silently fight, because a
      release overwrites whatever the live page says when it publishes.
    */
    inReleases.length > 0 && (
      <section
        aria-labelledby="release-banner"
        class="mb-6 rounded-lg border border-status-scheduled bg-status-scheduled-subtle px-4 py-3"
      >
        <h2 id="release-banner" class="text-sm font-semibold">
          {releaseMode ? 'Editing a staged version' : 'This item is staged in a release'}
        </h2>
        <ul class="mt-2 space-y-1.5 text-sm">
          {inReleases.map((entry) => (
            <li class="flex flex-wrap items-center gap-2">
              <ReleaseBadge status={entry.status} />
              <a href={`/admin/releases/${entry.id}`} class="font-medium underline-offset-2 hover:underline">
                {entry.name}
              </a>
              {releaseMode?.id === entry.id ? (
                <span class="text-content-muted">— the version you are editing</span>
              ) : (
                <a
                  href={`/admin/content/${item.id}?release=${entry.id}`}
                  class="text-content-muted underline-offset-2 hover:underline"
                >
                  Edit its staged version
                </a>
              )}
            </li>
          ))}
        </ul>
        {!releaseMode && (
          <p class="mt-2 text-xs text-content-muted">
            Changes you make here go live immediately if this page is published. The staged version
            replaces them when its release publishes.
          </p>
        )}
      </section>
    )
  }

  <ItemEditor
    client:load
    itemId={item.id}
    contentTypeId={contentType.id}
    contentTypeName={contentType.name}
    fields={contentType.fields}
    release={releaseMode}
    initial={{
      title: staged?.title ?? item.title,
      slug: staged?.slug ?? item.slug,
      status: item.status,
      publishAt: item.publish_at,
      parentId: item.parent_id,
      data: staged?.data ?? item.data,
      seo: staged?.seo ?? item.seo,
    }}
    parents={parents}
    termsByTaxonomy={termsByTaxonomy}
    relationTargets={relationTargets}
    blockTypes={blockTypes}
    reusableBlocks={reusableBlocks}
    canPublish={canPublishContent(user)}
    releases={{
      addable: addableReleases,
      canCreate: canPublishContent(user),
    }}
    actions={{
      previewable: Boolean(previewPane),
      showReferences: true,
      showDelete: canDelete,
    }}
    isHierarchical={contentType.kind === 'page'}
    media={media}
    referencedMedia={referencedMedia}
    defaultOgImage={defaultOgImage}
    path={item.path}
    origin={Astro.url.origin}
    preview={previewPane}
  />

  {/*
    The three panels, now in sheets rather than stacked below the form.

    Their contents are unchanged and still server-rendered: `Sheet` is a native `<dialog>`, so the
    restore and delete forms inside remain real POSTs that work before hydration. That is the whole
    reason this is not a React dialog — see the component.

    Rendered whether or not they are open, which is what keeps the markup in the page for the
    accessibility audit to see and what makes each trigger's target resolve.
  */}
  <Sheet
    id="sheet-history"
    title="Revision history"
    description="Every save, and what changed. Restoring writes a new revision rather than rewinding."
  >
    <RevisionHistory
      db={taproot.db.db}
      itemId={item.id}
      fields={contentType.fields}
      canEdit={canEditContent(user)}
    />
  </Sheet>

  <Sheet
    id="sheet-references"
    title="What links here"
    description="Content pointing at this item through a relation field."
  >
    <ReferencedBy db={taproot.db.db} itemId={item.id} />
  </Sheet>

  {
    canDelete && (
      <Sheet id="sheet-delete" title="Delete this item">
        <DangerZone
          noun="content item"
          confirmToken={item.slug}
          action={`/api/taproot/items/${item.id}`}
          blockers={deleteImpact.blockers}
          warnings={deleteImpact.warnings}
          blockedIntro="This item cannot be deleted yet:"
          allowedIntro="Deleting this item removes its content and its revision history. This cannot be undone."
        />
      </Sheet>
    )
  }
</AdminLayout>
