---
import { getContentTypeByApiId } from '@taprootcms/core';
import { getTaproot, loginRedirect, canEditContent } from '../../../runtime/guards.js';

/**
 * A singleton's sidebar entry.
 *
 * Resolves to the one item's editor, or to the form that creates it. The indirection buys a stable
 * URL: linking the sidebar straight at an item id would mean the link cannot be built until the
 * item exists, and would break if it were ever deleted and recreated.
 *
 * Either way an editor clicks "Weather Banner" and gets a form, rather than an empty list and a
 * "create the one allowed item" step that exists only to satisfy the data model. That is the
 * property worth keeping, and it does not require the row to exist first.
 */
const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;

const contentType = await getContentTypeByApiId(taproot.db.db, Astro.params.apiId!);
if (!contentType) return new Response('Content type not found', { status: 404 });
if (contentType.kind !== 'singleton') {
  return Astro.redirect(`/admin/content/type/${contentType.api_id}`);
}

const existing = await taproot.db.db
  .selectFrom('content_items')
  .select('id')
  .where('content_type_id', '=', contentType.id)
  .executeTakeFirst();

if (existing) return Astro.redirect(`/admin/content/${existing.id}`);

// Nothing to show and nothing this reader may create — better than an editor form they cannot use.
if (!canEditContent(user)) {
  return new Response('This singleton has not been created yet.', { status: 404 });
}

/**
 * The row is written by the create form, not by this screen.
 *
 * This used to call `createItem` with no `data` at all, which works only for a type whose fields
 * are every one of them optional — `validateItemData` enforces `required` on create like any other
 * write path. Add one required field to a singleton and its own sidebar link answers 500, from a
 * route with no form on it, so there is no way to reach the item from the UI at all. That is the
 * state `assertNotLastAdmin` and the first-run setup screen both exist to prevent.
 *
 * Same rule a reusable block already follows: a library row is only ever written validated, so
 * creating one collects its content first and there is no "empty entry, fill it in later" path.
 * Relaxing validation instead would mean a second caller of `requireComplete: false`, which is
 * reserved for preview snapshots precisely because they are never read back as content.
 */
return Astro.redirect(`/admin/content/new?type=${contentType.id}`);
---
