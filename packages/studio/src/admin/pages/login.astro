---
import '../admin.css';
import { countUsers, getConfiguredProviders } from '@taprootcms/core';
import { getTaproot } from '../../runtime/guards.js';
import { resolveTheme, themeAttribute, THEME_COOKIE_NAME } from '../theme.js';
import { adminBranding } from '../branding.js';
import BrandHead from '../components/BrandHead.astro';
import BrandMark from '../components/BrandMark.astro';

const taproot = getTaproot(Astro.locals);

// Already signed in — no reason to show the form again.
if (taproot.user) return Astro.redirect('/admin');

/**
 * A brand new install has nobody to sign in as, so the login form is a dead end.
 *
 * Checked here rather than only on `/setup` because this is where an operator arrives — the
 * deployment docs, the dev server banner, and every stale bookmark point at `/admin`, which
 * bounces here when signed out.
 */
if (taproot.auth.passwordAuthEnabled && (await countUsers(taproot.db.db)) === 0) {
  return Astro.redirect('/admin/setup');
}

const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/admin';
const providers = getConfiguredProviders(taproot.auth);
const passwordAuth = taproot.auth.passwordAuthEnabled;
const canEmailReset = passwordAuth && taproot.mail.delivers;
const isDevelopment = import.meta.env.DEV;

const providerLabels: Record<string, string> = {
  google: 'Google',
  github: 'GitHub',
  microsoft: 'Microsoft',
};

// Only ever redirect to a path on this site.
const safeNext = next.startsWith('/') && !next.startsWith('//') ? next : '/admin';

// The login screen honours the choice too, so signing out does not flip the theme back.
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE_NAME)?.value);
const branding = await adminBranding(taproot.db.db, taproot.storage);
---

<html lang="en" data-theme={themeAttribute(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <BrandHead branding={branding} title={`Sign in · ${branding.resolvedTitle}`} />
  </head>
  <body class="min-h-screen bg-surface-sunken text-content">
    <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6 py-12">
      <div class="rounded-xl border border-border bg-surface-raised p-8 shadow-sm">
        <h1 class="flex items-center gap-2 text-xl font-semibold tracking-tight">
          <BrandMark branding={branding} size="h-6" />
          Sign in to {branding.resolvedTitle}
        </h1>

        <!-- Errors are announced, not just shown. -->
        <div role="alert" aria-live="assertive">
          {
            error && (
              <p class="mt-5 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
                {error}
              </p>
            )
          }
        </div>

        {
          /*
            The password form comes first, and OAuth below it. That ordering is the whole change:
            password sign-in used to be the fallback shown only in development, and is now the
            method a campus deployment is expected to use.
          */
          passwordAuth && (
            <>
              <form method="post" action="/api/taproot/auth/login" class="mt-6 space-y-4">
                <input type="hidden" name="redirectTo" value={safeNext} />

                <div>
                  <label for="email" class="block text-sm font-medium">
                    Email
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="username"
                    autofocus
                    class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
                  />
                </div>

                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <label for="password" class="block text-sm font-medium">
                      Password
                    </label>
                    {/*
                      Offered only when the site can actually send the link. A "forgot password"
                      link on a deployment with no mailer leads to a form whose success message is
                      a lie — the link would go to a server log nobody reading it can see. Where it
                      is absent, an administrator generating one is still the route, and that is
                      what the flow was before this existed.
                    */}
                    {canEmailReset && (
                      <a
                        href="/admin/forgot-password"
                        class="text-xs text-content-muted underline-offset-2 hover:underline"
                      >
                        Forgot your password?
                      </a>
                    )}
                  </div>
                  <input
                    id="password"
                    name="password"
                    type="password"
                    required
                    autocomplete="current-password"
                    class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
                  />
                </div>

                <button
                  type="submit"
                  class="w-full rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
                >
                  Sign in
                </button>
              </form>

              {isDevelopment && (
                /*
                  Development only, and gated on the build rather than on a config flag, so the
                  seeded credentials cannot be printed by a deployed instance that happens to share
                  a setting with a laptop.
                */
                <p class="mt-5 rounded-md border border-border bg-surface-sunken px-3 py-2.5 text-xs text-content-muted">
                  Seeded development account: <code class="font-mono">admin@example.com</code> /
                  <code class="font-mono">taproot</code>
                </p>
              )}
            </>
          )
        }

        {
          passwordAuth && providers.length > 0 && (
            <div class="my-6 flex items-center gap-3" aria-hidden="true">
              <span class="h-px flex-1 bg-border" />
              <span class="text-xs uppercase tracking-wide text-content-subtle">or</span>
              <span class="h-px flex-1 bg-border" />
            </div>
          )
        }

        {
          providers.length > 0 && (
            <ul class="mt-6 space-y-2">
              {providers.map((provider) => (
                <li>
                  <a
                    href={`/api/taproot/auth/${provider}`}
                    class="block w-full rounded-md border border-border-strong px-4 py-2.5 text-center text-sm font-medium transition-colors hover:bg-surface-sunken"
                  >
                    Continue with {providerLabels[provider] ?? provider}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {
          providers.length === 0 && !passwordAuth && (
            <p class="mt-6 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
              No sign-in method is configured. Unset
              <code class="font-mono">TAPROOT_PASSWORD_AUTH</code> to allow email and password, or
              configure an OAuth provider — see <code class="font-mono">DEPLOYMENT.md</code>.
            </p>
          )
        }
      </div>
    </main>
  </body>
</html>
