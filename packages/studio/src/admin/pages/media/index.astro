---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listMedia, needsAltText } from '@taproot/core';
import { getTaproot, loginRedirect, canUploadMedia } from '../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;

/**
 * Through `listMedia` rather than a query of its own.
 *
 * The picker has searched the library since it was built and this screen never did — the same
 * service, the same filename-and-alt-text match, reached from one place and not the other. A
 * library you can only scroll is a library you cannot use past its first hundred assets, which is
 * exactly where the picker's search was already earning its keep.
 */
const search = Astro.url.searchParams.get('q')?.trim() ?? '';
const { media: assets, total } = await listMedia(taproot.db.db, {
  search: search || undefined,
  limit: 100,
});

const withUrls = assets.map((asset) => ({
  ...asset,
  url: taproot.storage.publicUrl(asset.storage_key),
  isImage: asset.mime_type.startsWith('image/'),
  // Through `needsAltText` rather than `!alt_text`, which is also true of the empty string — and
  // the empty string is how an image is marked decorative.
  undescribed: needsAltText({ mimeType: asset.mime_type, altText: asset.alt_text }),
}));

const missingAlt = withUrls.filter((asset) => asset.undescribed).length;

// The upload form posts to the API, which redirects back here with one of these.
const uploaded = Astro.url.searchParams.get('uploaded');
const uploadError = Astro.url.searchParams.get('error');
---

<AdminLayout
  title="Media"
  user={user}
  breadcrumbs={[{ label: 'Media' }]}
  flash={uploaded ? `Uploaded ${uploaded}.` : null}
>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Media</h1>
    <p class="mt-1 text-sm text-content-muted">
      {total} {total === 1 ? 'asset' : 'assets'}{search ? ` matching “${search}”` : ''} · stored
      via the <code class="font-mono">{taproot.storage.name}</code> adapter
    </p>
  </header>

  <form method="get" class="mb-6 flex flex-wrap items-end gap-3">
    <div class="min-w-56">
      <label for="q" class="block text-sm font-medium">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        value={search}
        placeholder="Filename or alt text"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      />
    </div>
    <button
      type="submit"
      class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium transition-colors hover:bg-surface-sunken"
    >
      Search
    </button>
    {
      search && (
        <a
          href="/admin/media"
          class="rounded-md px-3 py-2 text-sm font-medium text-content-muted transition-colors hover:bg-surface-sunken"
        >
          Clear
        </a>
      )
    }
  </form>

  <div role="alert" aria-live="assertive">
    {
      uploadError && (
        <p class="mb-6 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
          {uploadError}
        </p>
      )
    }
  </div>

  {
    missingAlt > 0 && (
      <p class="mb-6 rounded-md border border-warning bg-warning-subtle px-4 py-3 text-sm">
        <strong class="font-semibold">
          {missingAlt} {missingAlt === 1 ? 'image is' : 'images are'} missing alt text.
        </strong>{' '}
        A screen reader announces nothing useful for them, which is a WCAG 1.1.1 failure on every
        page they appear on. Open one to describe it — or to mark it decorative, if it carries no
        information of its own. The{' '}
        <a href="/admin/accessibility" class="underline">
          accessibility report
        </a>{' '}
        lists them alongside everything else worth fixing.
      </p>
    )
  }

  {
    canUploadMedia(user) && (
      <form
        method="post"
        action="/api/taproot/media"
        enctype="multipart/form-data"
        class="mb-8 max-w-xl space-y-4 rounded-lg border border-border bg-surface-raised p-5"
      >
        <h2 class="text-base font-semibold">Upload an asset</h2>

        <div>
          <label for="file" class="block text-sm font-medium">
            File
          </label>
          <input
            id="file"
            name="file"
            type="file"
            required
            class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
          />
        </div>

        <div>
          <label for="alt" class="block text-sm font-medium">
            Alt text
          </label>
          <p id="alt-hint" class="mt-0.5 text-xs text-content-subtle">
            Describe what the image conveys. Leave blank only if it is purely decorative.
          </p>
          <input
            id="alt"
            name="alt"
            aria-describedby="alt-hint"
            class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
          />
        </div>

        <button
          type="submit"
          class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
        >
          Upload
        </button>
      </form>
    )
  }

  {
    withUrls.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-content-muted">
        No media uploaded yet.
      </p>
    ) : (
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {withUrls.map((asset) => (
          <li class="overflow-hidden rounded-lg border border-border bg-surface-raised transition-colors hover:border-border-strong">
            {/*
              The whole card is one link rather than a link on the filename with a separate
              thumbnail: two controls to the same place would double every entry in a screen
              reader's link list, and the image is the part a pointer user aims at.
            */}
            <a href={`/admin/media/${asset.id}`} class="block">
              <div class="flex aspect-4/3 items-center justify-center bg-surface-sunken">
                {asset.isImage ? (
                  /* Decorative in this grid: the filename below is the accessible name, so
                     repeating it as alt would make screen readers announce it twice. */
                  <img src={asset.url} alt="" class="h-full w-full object-cover" loading="lazy" />
                ) : (
                  <span class="text-xs text-content-subtle">{asset.mime_type}</span>
                )}
              </div>
              <div class="px-3 py-2.5">
                <p class="truncate text-sm font-medium" title={asset.filename}>
                  {asset.filename}
                </p>
                <p class="mt-0.5 text-xs text-content-subtle">
                  {(asset.size_bytes / 1024).toFixed(0)} KB
                  {asset.width && asset.height && ` · ${asset.width}×${asset.height}`}
                </p>
                {asset.undescribed && <p class="mt-1 text-xs text-warning">Missing alt text</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-8 max-w-prose text-sm text-content-subtle">
    Open an asset to set its focal point and crop, and to see how it lands in every shape the site
    uses it in.
  </p>
</AdminLayout>
