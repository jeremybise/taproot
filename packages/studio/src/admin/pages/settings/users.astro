---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Timestamp from '../../components/Timestamp.astro';
import { countUserSessions, listUsers, twoFactorStatus } from '@taprootcms/core';
import { getTaproot, loginRedirect, canManageUsers } from '../../../runtime/guards.js';
import {
  SETUP_LINK_COOKIE,
  clearSetupLinkCookie,
  readSetupLink,
} from '../../../api/users/linkCookie.js';

/**
 * Users and access.
 *
 * A read-only table until email/password became the primary sign-in method, at which point "there
 * is no way to add a second person" stopped being a Phase 3 gap and became the thing standing
 * between this and a one-account CMS.
 *
 * An admin never chooses somebody else's password. Creating a user mints a one-time link, and the
 * person sets their own — so no administrator knows a colleague's password, and there is no
 * temporary password to store or send.
 */
const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;
if (!canManageUsers(user)) return Astro.redirect('/admin/settings');

const users = await listUsers(taproot.db.db);

/**
 * Enough state for an admin to know what is actually wrong before acting.
 *
 * "I cannot get in" has several causes that look identical from the outside — deactivated, no
 * password set, a second factor they can no longer satisfy — and an admin guessing between them
 * will pick the biggest hammer. Showing which it is turns the recovery actions below into a
 * choice rather than a coin toss.
 */
const state = new Map<string, { twoFactor: boolean; sessions: number; hasPassword: boolean }>();
for (const row of users) {
  const credential = await taproot.db.db
    .selectFrom('user_credentials')
    .select('user_id')
    .where('user_id', '=', row.id)
    .executeTakeFirst();

  state.set(row.id, {
    twoFactor: (await twoFactorStatus(taproot.db.db, row.id)).enabled,
    sessions: await countUserSessions(taproot.db.db, row.id),
    hasPassword: Boolean(credential),
  });
}

/**
 * A link generated by the previous request, handed over in a short-lived cookie.
 *
 * Not in the query string: a URL lands in browser history, in `Referer` headers, and in access
 * logs, which is a poor home for a credential that grants control of an account for two days. Read
 * once and cleared in this same response.
 */
const setupLink = readSetupLink(Astro.cookies.get(SETUP_LINK_COOKIE)?.value);
if (setupLink) {
  Astro.response.headers.append(
    'set-cookie',
    clearSetupLinkCookie({ secure: taproot.auth.secureCookies }),
  );
}

const linkUrl = setupLink
  ? new URL(`/admin/set-password?token=${setupLink.token}`, Astro.url.origin).toString()
  : null;

const created = Astro.url.searchParams.get('created');
const updated = Astro.url.searchParams.get('updated');
const error = Astro.url.searchParams.get('error');

const flash = error
  ? error
  : created
    ? `${created} added.`
    : updated
      ? `${updated} updated.`
      : null;

const ROLES = [
  { value: 'viewer', label: 'Viewer', hint: 'Reads the admin. Changes nothing.' },
  { value: 'contributor', label: 'Contributor', hint: 'Writes drafts and submits for review.' },
  { value: 'editor', label: 'Editor', hint: 'Publishes, and deletes content.' },
  { value: 'admin', label: 'Admin', hint: 'Also edits the content model and manages people.' },
];
---

<AdminLayout
  title="Users & access"
  user={user}
  breadcrumbs={[{ label: 'Settings', href: '/admin/settings' }, { label: 'Users & access' }]}
  flash={flash}
>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Users &amp; access</h1>
    <p class="mt-1 max-w-prose text-sm text-content-muted">
      Roles are site-wide: a role applies everywhere rather than to particular content.
    </p>
  </header>

  {
    linkUrl && (
      /*
        Shown once. There is no way to see it again — the token is stored only as a hash — which is
        the point, and worth saying out loud so nobody navigates away expecting to come back to it.
      */
      <section
        aria-labelledby="link-heading"
        class="mb-8 rounded-lg border border-accent bg-accent-subtle p-4"
      >
        <h2 id="link-heading" class="text-base font-semibold">
          Set-password link for {setupLink!.email}
        </h2>
        <p class="mt-1 text-sm">
          Send this to them. It works once, expires <Timestamp value={setupLink!.expiresAt} />, and
          is not shown again — generate a new one if it goes astray.
        </p>
        <label for="setup-link" class="sr-only-focusable">
          Set-password link for {setupLink!.email}
        </label>
        <input
          id="setup-link"
          readonly
          value={linkUrl}
          class="mt-3 w-full rounded-md border border-border-strong bg-surface px-3 py-2 font-mono text-xs"
        />
      </section>
    )
  }

  <section aria-labelledby="add-heading" class="mb-8 rounded-lg border border-border p-4">
    <h2 id="add-heading" class="text-base font-semibold">Add someone</h2>
    <p class="mt-1 text-sm text-content-muted">
      You will get a one-time link to send them. They choose their own password.
    </p>

    <form method="post" action="/api/taproot/users" class="mt-3 flex flex-wrap items-end gap-3">
      <div class="min-w-48 flex-1">
        <label for="name" class="block text-sm font-medium">Name</label>
        <input
          id="name"
          name="name"
          required
          class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
        />
      </div>

      <div class="min-w-56 flex-1">
        <label for="email" class="block text-sm font-medium">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
        />
      </div>

      <div>
        <label for="role" class="block text-sm font-medium">Role</label>
        <select
          id="role"
          name="role"
          class="mt-1.5 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
        >
          {
            ROLES.map((role) => (
              <option value={role.value} selected={role.value === 'contributor'}>
                {role.label}
              </option>
            ))
          }
        </select>
      </div>

      <button
        type="submit"
        class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
      >
        Add user
      </button>
    </form>

    <ul class="mt-4 space-y-1 text-xs text-content-subtle">
      {
        ROLES.map((role) => (
          <li>
            <strong class="font-medium text-content">{role.label}</strong> — {role.hint}
          </li>
        ))
      }
    </ul>
  </section>

  <div class="overflow-x-auto rounded-lg border border-border">
    <table class="w-full text-left text-sm">
      <caption class="sr-only-focusable">Everyone with an account</caption>
      <thead class="bg-surface-sunken text-xs uppercase tracking-wide text-content-subtle">
        <tr>
          <th scope="col" class="px-4 py-2.5 font-medium">Name</th>
          <th scope="col" class="px-4 py-2.5 font-medium">Email</th>
          <th scope="col" class="px-4 py-2.5 font-medium">Role</th>
          <th scope="col" class="px-4 py-2.5 font-medium">Sign-in</th>
          <th scope="col" class="px-4 py-2.5 font-medium">Added</th>
          <th scope="col" class="px-4 py-2.5 font-medium">
            <span class="sr-only-focusable">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          users.map((row) => (
            <tr class={`border-t border-border ${row.is_active ? '' : 'opacity-60'}`}>
              <th scope="row" class="px-4 py-2.5 font-normal">
                {row.name}
                {row.id === user.id && (
                  <span class="ml-2 rounded-full border border-border px-2 py-0.5 text-xs text-content-muted">
                    You
                  </span>
                )}
                {!row.is_active && (
                  <span class="ml-2 rounded-full border border-status-archived bg-status-archived-subtle px-2 py-0.5 text-xs">
                    Deactivated
                  </span>
                )}
              </th>
              <td class="px-4 py-2.5 text-content-muted">{row.email}</td>
              <td class="px-4 py-2.5">
                <form
                  method="post"
                  action={`/api/taproot/users/${row.id}`}
                  class="flex items-center gap-2"
                >
                  <input type="hidden" name="action" value="role" />
                  <label for={`role-${row.id}`} class="sr-only-focusable">
                    Role for {row.name}
                  </label>
                  <select
                    id={`role-${row.id}`}
                    name="role"
                    class="rounded-md border border-border-strong bg-surface px-2 py-1 text-sm"
                  >
                    {ROLES.map((role) => (
                      <option value={role.value} selected={role.value === row.role}>
                        {role.label}
                      </option>
                    ))}
                  </select>
                  <button
                    type="submit"
                    class="rounded-md border border-border-strong px-2 py-1 text-xs font-medium transition-colors hover:bg-surface-sunken"
                  >
                    Save
                    <span class="sr-only-focusable"> role for {row.name}</span>
                  </button>
                </form>
              </td>
              <td class="px-4 py-2.5 text-xs text-content-muted">
                {/*
                  The three states that look identical from the outside when someone says "I
                  cannot get in". Naming which it is turns the actions beside it into a choice
                  rather than a guess.
                */}
                <span class="block">
                  {state.get(row.id)!.hasPassword ? 'Password set' : 'No password yet'}
                </span>
                <span class="block">
                  {state.get(row.id)!.twoFactor ? 'Two-factor on' : 'Two-factor off'}
                </span>
                <span class="block">
                  {state.get(row.id)!.sessions === 0
                    ? 'Not signed in'
                    : `${state.get(row.id)!.sessions} active session${
                        state.get(row.id)!.sessions === 1 ? '' : 's'
                      }`}
                </span>
              </td>
              <td class="px-4 py-2.5 text-content-muted">
                <Timestamp value={row.created_at} />
              </td>
              <td class="px-4 py-2.5 text-right">
                <div class="flex flex-wrap justify-end gap-1">
                  <form method="post" action={`/api/taproot/users/${row.id}`}>
                    <input type="hidden" name="action" value="reset" />
                    <button
                      type="submit"
                      class="rounded-md border border-border-strong px-3 py-1 text-sm font-medium transition-colors hover:bg-surface-sunken"
                    >
                      Set-password link
                      <span class="sr-only-focusable"> for {row.name}</span>
                    </button>
                  </form>

                  {/*
                    Only offered when there is something to clear, and never on yourself — your own
                    goes through the account screen, which asks for your password. Offering it here
                    would route around that check.
                  */}
                  {state.get(row.id)!.twoFactor && row.id !== user.id && (
                    <form method="post" action={`/api/taproot/users/${row.id}`}>
                      <input type="hidden" name="action" value="clear-two-factor" />
                      <button
                        type="submit"
                        class="rounded-md border border-border-strong px-3 py-1 text-sm font-medium transition-colors hover:bg-surface-sunken"
                      >
                        Clear two-factor
                        <span class="sr-only-focusable"> for {row.name}</span>
                      </button>
                    </form>
                  )}

                  {state.get(row.id)!.sessions > 0 && (
                    <form method="post" action={`/api/taproot/users/${row.id}`}>
                      <input type="hidden" name="action" value="sign-out" />
                      <button
                        type="submit"
                        class="rounded-md border border-border-strong px-3 py-1 text-sm font-medium transition-colors hover:bg-surface-sunken"
                      >
                        {row.id === user.id ? 'Sign out elsewhere' : 'Sign out'}
                        <span class="sr-only-focusable"> {row.name}</span>
                      </button>
                    </form>
                  )}

                  <form method="post" action={`/api/taproot/users/${row.id}`}>
                    <input
                      type="hidden"
                      name="action"
                      value={row.is_active ? 'deactivate' : 'activate'}
                    />
                    <button
                      type="submit"
                      class={`rounded-md px-3 py-1 text-sm font-medium transition-colors hover:bg-surface-sunken ${
                        row.is_active ? 'text-danger' : ''
                      }`}
                    >
                      {row.is_active ? 'Deactivate' : 'Reactivate'}
                      <span class="sr-only-focusable"> {row.name}</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-4 max-w-prose text-sm text-content-subtle">
    Accounts are deactivated rather than deleted, so the revision history keeps saying who wrote
    what. Deactivating ends that person’s sessions immediately and refuses their password.
  </p>

  <p class="mt-2 max-w-prose text-sm text-content-subtle">
    <strong class="font-medium text-content">Clear two-factor</strong> is for someone who has lost
    both their phone and their recovery codes — it takes a protection off their account, so be sure
    who you are talking to. <strong class="font-medium text-content">Sign out</strong> ends their
    sessions without touching the account, which is what a lost laptop needs rather than
    deactivation.
  </p>
</AdminLayout>
