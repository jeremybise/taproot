---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { listContentTypes } from '@taprootcms/core';
import { getTaproot, loginRedirect, canManageSchema } from '../../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;
if (!canManageSchema(user)) return Astro.redirect('/admin');

const contentTypes = await listContentTypes(taproot.db.db);

const counts = await taproot.db.db
  .selectFrom('fields')
  .select(['content_type_id'])
  .select((eb) => eb.fn.countAll<number>().as('n'))
  .groupBy('content_type_id')
  .execute();

const fieldCount = new Map(counts.map((row) => [row.content_type_id, Number(row.n)]));

const kindLabels: Record<string, string> = {
  page: 'Page — nests under a parent',
  collection: 'Collection — flat, type-prefixed URL',
  singleton: 'Singleton — exactly one item',
};

const moved = Astro.url.searchParams.get('moved');
const deleted = Astro.url.searchParams.get('deleted');
const error = Astro.url.searchParams.get('error');
---

<AdminLayout
  title="Content types"
  user={user}
  breadcrumbs={[{ label: 'Settings', href: '/admin/settings' }, { label: 'Content types' }]}
  flash={deleted ? `Deleted the ${deleted} content type.` : moved ? `Moved ${moved}.` : null}
>
  <PageHeader title="Content types">
    <a
      slot="actions"
      href="/admin/settings/types/new"
      class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-content transition-colors hover:bg-accent-hover"
    >
      New content type
    </a>
  </PageHeader>

  <p class="mb-6 max-w-prose text-sm text-content-muted">
    A content type defines the fields its content items have. This order is the order they appear in
    the sidebar, so put whatever gets edited most at the top.
  </p>

  <div role="alert" aria-live="assertive">
    {
      error && (
        <p class="mb-6 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
          {error}
        </p>
      )
    }
  </div>

  {
    contentTypes.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-content-muted">
        No content types yet.
      </p>
    ) : (
      <ol class="space-y-2">
        {contentTypes.map((type, index) => (
          <li class="flex items-stretch gap-2">
            <a
              href={`/admin/settings/types/${type.id}`}
              class="flex-1 rounded-lg border border-border bg-surface-raised px-4 py-3 transition-colors hover:border-border-strong"
            >
              <span class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-medium">{type.name}</span>
                <code class="font-mono text-xs text-content-subtle">{type.api_id}</code>
              </span>
              <span class="mt-1 block text-sm text-content-muted">
                {kindLabels[type.kind]} · {fieldCount.get(type.id) ?? 0}
                {(fieldCount.get(type.id) ?? 0) === 1 ? ' field' : ' fields'}
              </span>
            </a>

            {/*
              Plain form submits rather than a drag-and-drop island. This list is flat and short,
              so buttons do the whole job with no JavaScript — and the name in each button's
              accessible label is what stops a column of identical "Move up" controls.
            */}
            <div class="flex flex-col justify-center gap-1">
              <form method="post" action="/api/taproot/content-types/reorder">
                <input type="hidden" name="id" value={type.id} />
                <input type="hidden" name="direction" value="up" />
                <button
                  type="submit"
                  disabled={index === 0}
                  class="rounded-md border border-border-strong px-2 py-1 text-sm transition-colors hover:bg-surface-sunken disabled:opacity-40"
                >
                  <span aria-hidden="true">↑</span>
                  <span class="sr-only-focusable">Move {type.name} up</span>
                </button>
              </form>
              <form method="post" action="/api/taproot/content-types/reorder">
                <input type="hidden" name="id" value={type.id} />
                <input type="hidden" name="direction" value="down" />
                <button
                  type="submit"
                  disabled={index === contentTypes.length - 1}
                  class="rounded-md border border-border-strong px-2 py-1 text-sm transition-colors hover:bg-surface-sunken disabled:opacity-40"
                >
                  <span aria-hidden="true">↓</span>
                  <span class="sr-only-focusable">Move {type.name} down</span>
                </button>
              </form>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</AdminLayout>
