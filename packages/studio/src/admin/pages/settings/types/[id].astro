---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import FieldBuilder from '../../../islands/FieldBuilder.tsx';
import ContentTypeSettings from '../../../islands/ContentTypeSettings.tsx';
import DeleteContentType from '../../../components/DeleteContentType.astro';
import { imageOptions } from '../../../mediaOptions.js';
import {
  bookRootBlockers,
  contentTypeDeleteBlockers,
  getContentType,
  listBlockTypes,
  listContentTypes,
  listTaxonomies,
} from '@taprootcms/core';
import { getTaproot, loginRedirect, canManageSchema } from '../../../../runtime/guards.js';

const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;
if (!canManageSchema(user)) return Astro.redirect('/admin');

const contentType = await getContentType(taproot.db.db, Astro.params.id!);
if (!contentType) return new Response('Content type not found', { status: 404 });

// All types, so the relation field's target picker has something to choose from.
const contentTypes = await listContentTypes(taproot.db.db);
// Likewise for the taxonomy field's source picker.
const taxonomies = await listTaxonomies(taproot.db.db);
// And for the block field's allowed-blocks picker.
const blockTypes = await listBlockTypes(taproot.db.db);
// And for this type's default social card.
const images = await imageOptions(taproot.db.db, taproot.storage);

/**
 * What would break if this type became a book, computed before anybody ticks the box.
 *
 * Ticking it applies a rule to content written weeks earlier: every existing item of this type
 * gains a subtree that then refuses reusable blocks and snippets. Unreported, the consequence lands
 * on somebody else entirely — an editor opens an unrelated page inside that subtree and is refused
 * by a rule they did not set and cannot see. Only asked for a `page`, since no other kind can be one.
 */
const bookConflicts =
  contentType.kind === 'page' ? await bookRootBlockers(taproot.db.db, contentType) : [];

const itemCountRow = await taproot.db.db
  .selectFrom('content_items')
  .select((eb) => eb.fn.countAll<number>().as('n'))
  .where('content_type_id', '=', contentType.id)
  .executeTakeFirst();
const itemCount = Number(itemCountRow?.n ?? 0);

// Asked of core rather than inferred from `itemCount`: a type with no items can still be held by a
// relation field on another type, and a screen that guessed would offer a delete that is refused.
const deleteBlockers = await contentTypeDeleteBlockers(taproot.db.db, contentType);

const created = Astro.url.searchParams.get('created') === '1';
const error = Astro.url.searchParams.get('error');

const kindLabels: Record<string, string> = {
  page: 'Page — nests under a parent',
  collection: 'Collection — flat, type-prefixed URL',
  singleton: 'Singleton — exactly one item',
};
---

<AdminLayout
  title={contentType.name}
  user={user}
  breadcrumbs={[
    { label: 'Settings', href: '/admin/settings' },
    { label: 'Content types', href: '/admin/settings/types' },
    { label: contentType.name },
  ]}
  flash={created ? `Created the ${contentType.name} content type. Add its fields below.` : null}
>
  <header class="mb-8">
    <h1 class="text-2xl font-semibold tracking-tight">{contentType.name}</h1>
    <dl class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-content-muted">
      <div class="flex gap-1.5">
        <dt>API id:</dt>
        <dd><code class="font-mono">{contentType.api_id}</code></dd>
      </div>
      <div class="flex gap-1.5">
        <dt>Kind:</dt>
        <dd>{kindLabels[contentType.kind]}</dd>
      </div>
      {
        contentType.url_prefix && (
          <div class="flex gap-1.5">
            <dt>URL prefix:</dt>
            <dd>
              <code class="font-mono">/{contentType.url_prefix}</code>
            </dd>
          </div>
        )
      }
      <div class="flex gap-1.5">
        <dt>Items:</dt>
        <dd>{itemCount}</dd>
      </div>
    </dl>
  </header>

  <div role="alert" aria-live="assertive">
    {
      error && (
        <p class="mb-6 rounded-md border border-danger bg-danger-subtle px-4 py-3 text-sm">
          {error}
        </p>
      )
    }
  </div>

  <!--
    Settings first: naming and describing the type is what you do when you land here, and the
    field list below can run long enough to bury it.
  -->
  <section aria-labelledby="settings-heading" class="mb-12 border-b border-border pb-8">
    <h2 id="settings-heading" class="mb-1 text-base font-semibold">Settings</h2>
    <p class="mb-4 max-w-prose text-sm text-content-muted">
      The API id and kind are fixed after creation — code references the first, and every existing
      item's URL was built from the second.
    </p>

    <ContentTypeSettings
      client:load
      contentType={contentType}
      fields={contentType.fields}
      images={images}
      bookConflicts={bookConflicts}
    />
  </section>

  <section aria-labelledby="fields-heading">
    <h2 id="fields-heading" class="mb-1 text-base font-semibold">Fields</h2>
    <p class="mb-4 max-w-prose text-sm text-content-muted">
      What editors fill in when they create a {contentType.name.toLowerCase()}.
    </p>

    <!--
      Hydrated on load rather than on visible: the builder is the primary interaction on this
      page, and deferring it would leave controls looking ready before they respond.
    -->
    <FieldBuilder
      client:load
      contentTypeId={contentType.id}
      initialFields={contentType.fields}
      contentTypes={contentTypes}
      taxonomies={taxonomies}
      blockTypes={blockTypes}
      itemCount={itemCount}
    />
  </section>

  <DeleteContentType contentType={contentType} blockers={deleteBlockers} />
</AdminLayout>
