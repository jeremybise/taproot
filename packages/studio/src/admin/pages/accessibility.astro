---
import AdminLayout from '../layouts/AdminLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import {
  A11Y_RULES,
  A11Y_RULE_META,
  auditContentItems,
  isA11yRule,
  listContentTypes,
  undescribedImages,
} from '@taprootcms/core';
import { getTaproot, loginRedirect, canEditContent } from '../../runtime/guards.js';

/**
 * The site-wide accessibility report.
 *
 * Under Content rather than Settings, because it is a view over the site's content rather than
 * configuration that shapes it — the same reason Releases sits there.
 *
 * It exists because the editor's panel, on its own, gives nobody a way through a backlog. A campus
 * site arrives with content already written, and "every page has a panel now" is not a plan for
 * fixing any of it.
 *
 * **Recomputed on every request, never stored.** Same reasoning as `releasePreflight`: a cached
 * list still accuses somebody an hour after they fixed it, and there is no invalidation that covers
 * "somebody edited the reusable block that page references".
 */
const taproot = getTaproot(Astro.locals);
if (!taproot.user) return Astro.redirect(loginRedirect(Astro.url));
const user = taproot.user;
if (!canEditContent(user)) return Astro.redirect('/admin');

const params = Astro.url.searchParams;
const typeFilter = params.get('type') ?? '';
const search = params.get('q') ?? '';
// Anything unrecognised is dropped rather than reaching the filter, matching the content list's
// treatment of a hand-edited status.
const rawRule = params.get('rule') ?? '';
const ruleFilter = isA11yRule(rawRule) ? rawRule : undefined;

/**
 * Published and scheduled by default, through the same `visibleToPublic` rule every other reader
 * uses. A draft nobody has finished is not yet a problem anybody has — but the toggle is here
 * because it becomes one the moment somebody publishes it.
 */
const includeUnpublished = params.get('all') === '1';

const page = Math.max(1, Number(params.get('page') ?? '1') || 1);
const perPage = 50;

const [contentTypes, report, undescribed] = await Promise.all([
  listContentTypes(taproot.db.db),
  auditContentItems(taproot.db.db, {
    contentTypeId: typeFilter || undefined,
    search: search || undefined,
    rule: ruleFilter,
    visibleOnly: !includeUnpublished,
    limit: perPage,
    offset: (page - 1) * perPage,
  }),
  undescribedImages(taproot.db.db),
]);

const scannedThrough = Math.min((page - 1) * perPage + report.scanned, report.totalItems);
const hasMore = (page - 1) * perPage + report.scanned < report.totalItems;

/** Keep every filter when moving between pages; only `page` changes. */
function pageHref(target: number): string {
  const next = new URLSearchParams(params);
  next.set('page', String(target));
  return `/admin/accessibility?${next.toString()}`;
}

const filtered = Boolean(search || typeFilter || ruleFilter || includeUnpublished);
---

<AdminLayout
  title="Accessibility"
  user={user}
  breadcrumbs={[{ label: 'Accessibility' }]}
>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Accessibility</h1>
    <p class="mt-1 max-w-prose text-sm text-content-muted">
      What a visitor using a screen reader would run into. Nothing here blocks publishing — it is a
      list of things worth fixing, not a gate.
    </p>
  </header>

  <form method="get" class="mb-6 flex flex-wrap items-end gap-3">
    <div class="min-w-48 flex-1">
      <label for="q" class="block text-sm font-medium">Search</label>
      <input
        id="q"
        name="q"
        type="search"
        value={search}
        placeholder="Title or path"
        class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      />
    </div>

    <div>
      <label for="type" class="block text-sm font-medium">Content type</label>
      <select
        id="type"
        name="type"
        class="mt-1.5 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      >
        <option value="">All types</option>
        {
          contentTypes.map((type) => (
            <option value={type.id} selected={type.id === typeFilter}>
              {type.name}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="rule" class="block text-sm font-medium">Issue</label>
      <select
        id="rule"
        name="rule"
        class="mt-1.5 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm"
      >
        <option value="">Anything</option>
        {
          A11Y_RULES.map((rule) => (
            <option value={rule} selected={rule === ruleFilter}>
              {A11Y_RULE_META[rule].label}
            </option>
          ))
        }
      </select>
    </div>

    <div class="flex items-center gap-2 pb-2.5">
      <input
        id="all"
        name="all"
        type="checkbox"
        value="1"
        checked={includeUnpublished}
        class="size-4 rounded border-border-strong"
      />
      <label for="all" class="text-sm font-medium">Include unpublished</label>
    </div>

    <button
      type="submit"
      class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium transition-colors hover:bg-surface-sunken"
    >
      Filter
    </button>

    {
      filtered && (
        <a
          href="/admin/accessibility"
          class="rounded-md px-3 py-2 text-sm font-medium text-content-muted transition-colors hover:bg-surface-sunken"
        >
          Clear
        </a>
      )
    }
  </form>

  {/*
    What was scanned, rather than a site-wide issue total.

    A true total means reading every row of `content_items` and walking each one's data to render a
    number, and a total that is quietly capped at some limit is worse than none — it would say
    "12 issues" about a site with hundreds. So the honest thing is on screen instead.
  */}
  <p class="mb-2 text-sm text-content-muted">
    Checked {scannedThrough} of {report.totalItems}
    {report.totalItems === 1 ? ' item' : ' items'}{filtered ? ' matching this filter' : ''}
    {
      report.items.length > 0 &&
        ` · ${report.errors} ${report.errors === 1 ? 'error' : 'errors'}, ${report.warnings} ${report.warnings === 1 ? 'warning' : 'warnings'} here`
    }
  </p>

  {/* What the chosen rule actually means, from the same table the filter's options come from. */}
  <p class="mb-6 max-w-prose text-sm text-content-subtle">
    {ruleFilter ? A11Y_RULE_META[ruleFilter].description : ''}
  </p>

  {
    report.items.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border px-4 py-10 text-center text-sm text-content-muted">
        {report.totalItems === 0
          ? 'No content matches this filter.'
          : 'Nothing to fix in the items checked.'}
      </p>
    ) : (
      <ul class="space-y-4">
        {report.items.map((entry) => (
          <li class="rounded-lg border border-border bg-surface-raised p-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="text-sm font-semibold">
                <a href={`/admin/content/${entry.item.id}`} class="underline-offset-2 hover:underline">
                  {entry.item.title}
                </a>
              </h2>
              <div class="flex items-center gap-2 text-xs text-content-subtle">
                <span>{entry.contentType.name}</span>
                <StatusBadge status={entry.item.status} />
              </div>
            </div>
            <p class="mt-0.5 font-mono text-xs text-content-subtle">{entry.item.path}</p>

            <ul class="mt-3 space-y-2">
              {entry.issues.map((issue) => (
                <li class="text-sm">
                  <p class="flex flex-wrap items-baseline gap-x-2">
                    <span
                      class={`inline-block rounded-full border px-2 py-0.5 text-xs font-medium ${
                        issue.severity === 'error'
                          ? 'border-danger bg-danger-subtle'
                          : 'border-warning bg-warning-subtle'
                      }`}
                    >
                      {/* The word as well as the colour — a bare swatch is a WCAG 1.4.1 failure. */}
                      {issue.severity === 'error' ? 'Error' : 'Warning'}
                    </span>
                    <span class="font-medium">{issue.location}</span>
                  </p>
                  <p class="mt-0.5 text-content-muted">{issue.message}</p>
                  {issue.inheritedFrom && (
                    <p class="mt-0.5 text-xs text-content-subtle">
                      From the reusable block{' '}
                      <a href={`/admin/blocks/${issue.inheritedFrom.id}`} class="underline">
                        {issue.inheritedFrom.name}
                      </a>
                      , so fixing it there fixes every page using it.
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )
  }

  {
    (page > 1 || hasMore) && (
      <nav aria-label="Pages" class="mt-6 flex items-center gap-3 text-sm">
        {page > 1 && (
          <a
            href={pageHref(page - 1)}
            class="rounded-md border border-border-strong px-3 py-2 font-medium transition-colors hover:bg-surface-sunken"
          >
            Previous
          </a>
        )}
        <span class="text-content-subtle">Page {page}</span>
        {hasMore && (
          <a
            href={pageHref(page + 1)}
            class="rounded-md border border-border-strong px-3 py-2 font-medium transition-colors hover:bg-surface-sunken"
          >
            Check the next {perPage}
          </a>
        )}
      </nav>
    )
  }

  {/*
    Images, separately, because this is the one question here that is a query rather than a scan —
    and the only one that catches a problem before it reaches a page. An image uploaded and not yet
    placed appears in no item's data, so the walk above cannot see it, and it will be undescribed
    on whatever page it eventually lands on.
  */}
  <section aria-labelledby="undescribed-heading" class="mt-10">
    <h2 id="undescribed-heading" class="text-base font-semibold">Images with no alt text</h2>

    {
      undescribed.total === 0 ? (
        <p class="mt-2 text-sm text-content-muted">
          Every image in the library is either described or marked decorative.
        </p>
      ) : (
        <>
          <p class="mt-1 max-w-prose text-sm text-content-muted">
            {undescribed.total} {undescribed.total === 1 ? 'image has' : 'images have'} no
            description and no decorative mark — including any not yet placed on a page. Open one to
            describe it, or to say it carries no information of its own.
          </p>
          <ul class="mt-3 space-y-1 text-sm">
            {undescribed.images.map((image) => (
              <li>
                <a href={`/admin/media/${image.id}`} class="underline-offset-2 hover:underline">
                  {image.filename}
                </a>
              </li>
            ))}
            {undescribed.total > undescribed.images.length && (
              <li class="text-content-subtle">
                and {undescribed.total - undescribed.images.length} more —{' '}
                <a href="/admin/media" class="underline">
                  the whole library
                </a>
              </li>
            )}
          </ul>
        </>
      )
    }
  </section>
</AdminLayout>
