---
import { ICON_PATHS, isIconName, type IconName } from './iconPaths.js';

/**
 * Icons for the server-rendered screens.
 *
 * The islands use `lucide-react`, which is a React component library and therefore unavailable in an
 * `.astro` file. The geometry here is the *same* Lucide geometry, generated into
 * [iconPaths.ts](./iconPaths.ts) by `scripts/build-icons.mjs`, so an icon in the sidebar and the same
 * icon inside a field control cannot drift into two different marks.
 *
 * This file used to carry five glyphs transcribed by hand, with a comment saying to keep the list
 * short because it was "not a general icon system". The sidebar and the Settings hub need about
 * twenty; that is past where hand transcription is a good trade, so the transcription was automated
 * rather than the list capped. Add a name to `ICONS` in the generator and re-run it.
 *
 * The five original names — `eye`, `history`, `link`, `trash`, `close` — are aliased to their Lucide
 * spellings below so no existing call site had to change.
 */
interface Props {
  /** A Lucide name from `iconPaths.ts`, or one of the five legacy short names. */
  name: string;
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;

/** The names this component answered to before it drew from Lucide's own vocabulary. */
const LEGACY: Record<string, IconName> = {
  eye: 'eye',
  history: 'history',
  link: 'link-2',
  trash: 'trash-2',
  close: 'x',
};

const resolved = LEGACY[name] ?? name;

/**
 * An unknown name draws nothing rather than throwing.
 *
 * `content_types.icon` holds a name chosen on another screen, possibly long ago, so this is a stored
 * value that can outlive the set it names — the same shape as a query field whose `dateFieldApiId`
 * no longer names a date field. It fails open: the label beside it still says what the link is, and
 * a missing decoration is not worth a 500 on every admin page.
 */
const shapes = isIconName(resolved) ? ICON_PATHS[resolved] : null;
---

{
  /*
    `aria-hidden` in every case, without exception.

    Each of these sits inside a control that carries its own accessible name — an `aria-label` on the
    button, or visible text beside it. An icon that also announced itself would make a screen reader
    read the same control twice, which is the usual way a decorative SVG becomes a defect. This is
    also why an icon may never be the only thing distinguishing one nav entry from another.
  */
  shapes && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {shapes.map((shape) => {
        const attrs = shape.attrs as Record<string, string>;
        if (shape.tag === 'circle') return <circle {...attrs} />;
        if (shape.tag === 'rect') return <rect {...attrs} />;
        if (shape.tag === 'line') return <line {...attrs} />;
        if (shape.tag === 'polyline') return <polyline {...attrs} />;
        if (shape.tag === 'polygon') return <polygon {...attrs} />;
        if (shape.tag === 'ellipse') return <ellipse {...attrs} />;
        return <path {...attrs} />;
      })}
    </svg>
  )
}
