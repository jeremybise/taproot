---
import type { ContentTypeRow } from '@taprootcms/core';
import DangerZone from './DangerZone.astro';

/**
 * The delete affordance for a content type or a block type.
 *
 * A thin wrapper over `DangerZone` now that content items and media assets have one too — this
 * keeps the two schema screens' wording, which is about content being left with no schema to
 * render it, without a second copy of the confirmation form.
 *
 * `blockers` comes from `contentTypeDeleteBlockers`, never from a count the page worked out for
 * itself — the guard and this screen have to agree about whether the delete would succeed.
 */
interface Props {
  contentType: ContentTypeRow;
  blockers: string[];
}

const { contentType, blockers } = Astro.props;
const noun = contentType.kind === 'block' ? 'block type' : 'content type';
---

<DangerZone
  noun={noun}
  confirmToken={contentType.api_id}
  action={`/api/taproot/content-types/${contentType.id}`}
  blockers={blockers}
  blockedIntro={`This ${noun} cannot be deleted yet. Deleting it would leave content behind with no schema to render it, so the following have to be cleared first:`}
  allowedIntro={`Nothing uses this ${noun}, so it can be deleted. Its fields go with it, and this cannot be undone.`}
/>
