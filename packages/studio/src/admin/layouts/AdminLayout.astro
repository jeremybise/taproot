---
import '../admin.css';
import { isNavigable, listContentTypes, type User } from '@taprootcms/core';
import { getTaproot, canEditContent, canManageSchema, canStageToRelease } from '../../runtime/guards.js';
import UserMenu from '../components/UserMenu.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import BrandHead from '../components/BrandHead.astro';
import { adminBranding } from '../branding.js';
import { resolveTheme, themeAttribute, THEME_COOKIE_NAME } from '../theme.js';
import {
  previewPaneAttribute,
  resolvePreviewPane,
  PREVIEW_PANE_COOKIE_NAME,
} from '../previewPane.js';

interface Props {
  title: string;
  user: User;
  /** Breadcrumb trail, most general first. The final entry is rendered as the current page. */
  breadcrumbs?: { label: string; href?: string }[];
  /** Announced to screen readers on load — used for save confirmations after a redirect. */
  flash?: string | null;
}

const { title, user, breadcrumbs = [], flash = null } = Astro.props;
const path = Astro.url.pathname;

/**
 * Resolved here rather than in a script, so `data-theme` is in the HTML the browser first parses.
 * A `localStorage` theme has to be applied by an inline blocking script, and the gap before it
 * runs is the flash of the wrong palette that every such implementation spends effort hiding.
 */
const theme = resolveTheme(Astro.cookies.get(THEME_COOKIE_NAME)?.value);

/**
 * Same mechanism, same reason: the item editor's container is wider when its live preview pane is
 * open, and a width chosen after hydration is a visible jump on every load. Read here rather than in
 * the editor page so `<html>` carries it before the first byte of CSS.
 */
const previewPane = resolvePreviewPane(Astro.cookies.get(PREVIEW_PANE_COOKIE_NAME)?.value);

// The query string comes too: switching theme from a filtered content list must not silently
// discard the filters.
const themeReturnPath = `${Astro.url.pathname}${Astro.url.search}`;

/**
 * The sidebar is built from the content types that exist, not from a fixed list.
 *
 * Each type is its own destination rather than a filter on one shared list, because that is how
 * editors think about them: Pages and Events are different places, not two settings of the same
 * screen. Their order is the site's own (`content_types.position`), since which one an editor
 * reaches first every day is a judgement about that site.
 *
 * Singletons are separated because they behave differently — there is no list to land on, so the
 * link opens the editor directly.
 */
const taproot = getTaproot(Astro.locals);
const contentTypes = await listContentTypes(taproot.db.db);

/**
 * What this CMS calls itself, and what colour it is.
 *
 * Read here for the same reason the theme cookie is: the accent has to be in the first HTML the
 * browser parses or the admin repaints from green to whatever the site chose, on every page.
 */
const branding = await adminBranding(taproot.db.db, taproot.storage);

/**
 * Types that asked to be left out are left out — of the sidebar, and of nothing else.
 *
 * A staff directory's people, a course subject reached through the page that lists it: real content
 * nobody navigates to by type, where an entry nobody clicks pushes the ones people use daily below
 * the fold. Every hidden type is still at **Content → All content**, still searchable, and still at
 * its own stable list URL — see `isNavigable` for why filtering anything *else* by this column would
 * be a delete that does not delete.
 */
const navigable = contentTypes.filter(isNavigable);

const listable = navigable.filter((type) => type.kind !== 'singleton');
const singletons = navigable.filter((type) => type.kind === 'singleton');

interface NavItem {
  href: string;
  label: string;
  exact?: boolean;
  /**
   * A Lucide name from `iconPaths.ts`, decoration only.
   *
   * Never the accessible name: the label beside it always says what the link is, so an unknown or
   * missing icon costs nothing but the mark. Fixed destinations get one here; a content type's comes
   * from `content_types.icon`, which the type's own settings screen writes.
   */
  icon?: string;
}

interface NavGroup {
  id: string;
  label: string;
  items: NavItem[];
}

const groups: NavGroup[] = [
  {
    id: 'nav-content',
    label: 'Content',
    items: [
      ...listable.map((type) => ({
        href: `/admin/content/type/${type.api_id}`,
        label: type.name_plural,
        /**
         * The column existed, was validated, and was read by nothing at all until now.
         *
         * `file-text` is the fallback rather than "no icon", so a sidebar is never a ragged mix of
         * marked and unmarked entries — which reads as breakage rather than as a default.
         */
        icon: type.icon ?? 'file-text',
      })),
      // Kept last: per-type lists are the way in, and searching across every type is the
      // occasional case rather than the default.
      { href: '/admin/content', label: 'All content', exact: true, icon: 'list' },
      /**
       * Under Content rather than Settings, because it reports on the site's content rather than
       * configuring anything. Editors and above: it lists items across every type, and a viewer
       * has nothing to do with a list of things to go and fix.
       */
      ...(canEditContent(user)
        ? [{ href: '/admin/accessibility', label: 'Accessibility', icon: 'accessibility' }]
        : []),
      /**
       * Releases sits under Content rather than Settings because it *is* content — a batch of
       * pending versions — and a contributor can see it. Staging is not publishing: putting an item
       * in a release reaches nobody until an editor publishes it, which is the same shape as
       * submitting for review. A viewer sees nothing here.
       */
      ...(canStageToRelease(user)
        ? [{ href: '/admin/releases', label: 'Releases', icon: 'rocket' }]
        : []),
    ],
  },
  ...(singletons.length > 0
    ? [
        {
          id: 'nav-singletons',
          label: 'Singletons',
          items: singletons.map((type) => ({
            href: `/admin/singleton/${type.api_id}`,
            label: type.name,
            icon: type.icon ?? 'file-text',
          })),
        },
      ]
    : []),
  {
    id: 'nav-library',
    label: 'Library',
    items: [
      { href: '/admin/media', label: 'Media', icon: 'image' },
      // Content, not configuration — an office's contact details rather than a setting — so it
      // lives beside Media rather than under Settings with the block *types*.
      { href: '/admin/blocks', label: 'Reusable blocks', icon: 'blocks' },
      // Beside reusable blocks because it is the same idea one size down: that shares a region of a
      // page, this shares a value inside a sentence. Both are content, which is why neither is
      // under Settings.
      { href: '/admin/snippets', label: 'Text snippets', icon: 'braces' },
      { href: '/admin/taxonomies', label: 'Taxonomies', icon: 'tags' },
      ...(canManageSchema(user)
        ? [{ href: '/admin/menus', label: 'Menus', icon: 'menu' }]
        : []),
    ],
  },
];

const isCurrent = (item: NavItem) =>
  item.exact ? path === item.href : path === item.href || path.startsWith(`${item.href}/`);

const navLinkClass = (current: boolean) =>
  [
    // `flex` rather than `block`, so an icon can sit beside the label without changing the hit area.
    // `min-w-0` on the label is what keeps a long content-type name truncating instead of widening
    // the sidebar — the same rule the menus screen's forms needed.
    'flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors',
    current
      ? 'bg-accent-subtle font-medium text-content'
      : 'text-content-muted hover:bg-surface-raised hover:text-content',
  ].join(' ');
---

<html lang="en" data-theme={themeAttribute(theme)} data-preview={previewPaneAttribute(previewPane)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <BrandHead branding={branding} title={`${title} · ${branding.resolvedTitle}`} />
  </head>
  <body class="min-h-screen bg-surface text-content">
    <!--
      A skip link is the cheapest large a11y win in an app with a persistent sidebar: without it,
      keyboard users tab through every nav item on every page before reaching the content.
    -->
    <a
      href="#main"
      class="sr-only-focusable absolute left-4 top-4 z-50 rounded-md bg-accent px-4 py-2 text-accent-content font-medium"
    >
      Skip to main content
    </a>

    <!--
      The drawer's backdrop. Only ever visible below `lg` with the drawer open; clicking it closes.
      Not focusable and `aria-hidden`, because Escape and the close path are the real affordances
      and a focusable backdrop is a tab stop that announces nothing.
    -->
    <div id="nav-backdrop" aria-hidden="true" class="taproot-nav-backdrop"></div>

    <div class="min-h-screen lg:flex">
      <!--
        Sidebar — and, below `lg`, the same element slid off-canvas as a drawer.

        **One element, not two.** A separate desktop sidebar plus a duplicate mobile drawer would
        put two `<nav aria-label="Main">` landmarks in the DOM, and `scripts/a11y-audit.mjs` loads
        no CSS — so `hidden lg:block` is invisible to it and axe's `landmark-unique` rule would fire
        on every route. It is also the "which copy did you edit" problem, which is the reason this
        codebase keeps one of things.

        **Not a `<dialog>`**, though that would hand us a focus trap for free. A dialog forced
        visible at desktop keeps its implicit `role="dialog"`, so the ordinary sidebar would
        announce itself as a dialog on every page; giving it `role="navigation"` fixes that and
        breaks the mobile reading, where the dialog role is what tells a screen-reader user they are
        in a modal Escape will close. `Sheet.astro` stays a native dialog because it is only ever a
        dialog. This is a sidebar that is sometimes a drawer, and the script below pays for the
        difference with `inert` and about thirty lines.

        A <header> rather than a <div>: it is the banner landmark, which is what puts the brand
        link and the account block inside a landmark. With a plain div, axe's `region` rule flags
        them — content outside any landmark is content a screen-reader user cannot jump to.
      -->
      <header
        data-reflow-ok="width is lg: only; below it the banner is a full-width bar"
        class="lg:w-60 lg:shrink-0 lg:border-r lg:border-border lg:bg-surface-sunken"
      >
        <!--
          The small-screen top bar, inside the banner rather than beside it.

          It was a top-level `<div>` for exactly one run of `npm run a11y`, which failed 29 routes on
          axe's `region` rule — content outside every landmark, which is content a screen-reader user
          cannot jump to. The comment on this element already warned about that. It cannot be a
          second `<header>` either: two banner landmarks is its own violation, and the audit sees
          both because it loads no CSS and `lg:hidden` means nothing to it. So the banner wraps both
          the bar and the panel, and only the panel slides.
        -->
        {/*
          `fixed`, not `sticky`, and the class carries the positioning — see `admin.css`.

          It was `sticky top-0` and scrolled away on every long page: a sticky element travels only
          within its containing block, and below `lg` this bar's parent is the banner, which is
          exactly as tall as the bar. Same shape as the bug the sidebar had. `#admin-content` gets
          matching top padding so nothing hides underneath it.
        */}
        <div class="taproot-topbar flex items-center gap-2 border-b border-border bg-surface px-4 py-2.5 lg:hidden">
          <button
            type="button"
            id="nav-toggle"
            aria-controls="admin-nav"
            aria-expanded="false"
            aria-label="Main menu"
            class="rounded-md border border-border-strong p-2 transition-colors hover:bg-surface-sunken"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M4 6h16" />
              <path d="M4 12h16" />
              <path d="M4 18h16" />
            </svg>
          </button>
          <a href="/admin" class="flex items-center gap-2 font-semibold tracking-tight">
            <BrandMark branding={branding} size="h-5" />
            {branding.resolvedTitle}
          </a>
        </div>

        <!--
          The sticky lives on *this* element, not on the inner column.

          It used to be on the child, which worked while that child was a direct flex item of the
          shell and therefore stretched to the whole page height. Wrapping it in this panel broke it
          silently: a sticky element can only travel inside its containing block, and this wrapper is
          exactly as tall as the child, so there was nowhere to go and the sidebar scrolled away on
          any long page.

          `lg:` only. Below it, `.taproot-nav` is `position: fixed`, which this must not fight.
        -->
        <div id="admin-nav" class="taproot-nav bg-surface-sunken lg:sticky lg:top-0 lg:h-dvh">
          <div class="flex h-full flex-col">
          <div class="px-5 py-5">
            <a href="/admin" class="flex items-center gap-2 text-lg font-semibold tracking-tight">
              <BrandMark branding={branding} />
              <span class="min-w-0 truncate">{branding.resolvedTitle}</span>
            </a>
          </div>

          <!--
            One navigation landmark containing labelled groups, rather than a landmark per group.
            Four landmarks would clutter a screen reader's landmark list; `aria-labelledby` on each
            list gets the grouping announced without that cost, and the headings are visible so the
            same structure is available to everyone.
          -->
          <nav aria-label="Main" class="flex-1 overflow-y-auto px-3 pb-4">
            <ul class="space-y-0.5">
              <li>
                <a
                  href="/admin"
                  aria-current={path === '/admin' ? 'page' : undefined}
                  class={navLinkClass(path === '/admin')}
                >
                  <Icon name="layout-dashboard" class="h-4 w-4 shrink-0" />
                  <span class="min-w-0 truncate">Dashboard</span>
                </a>
              </li>
            </ul>

            {
              groups.map((group) => (
                <div class="mt-5">
                  <h2
                    id={group.id}
                    class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-content-subtle"
                  >
                    {group.label}
                  </h2>
                  <ul aria-labelledby={group.id} class="space-y-0.5">
                    {group.items.map((item) => {
                      const current = isCurrent(item);
                      return (
                        <li>
                          <a
                            href={item.href}
                            aria-current={current ? 'page' : undefined}
                            class={navLinkClass(current)}
                          >
                            {item.icon && <Icon name={item.icon} class="h-4 w-4 shrink-0" />}
                            <span class="min-w-0 truncate">{item.label}</span>
                          </a>
                        </li>
                      );
                    })}
                    {group.items.length === 0 && (
                      <li class="px-3 py-2 text-sm text-content-subtle">Nothing yet</li>
                    )}
                  </ul>
                </div>
              ))
            }

            <ul class="mt-5 space-y-0.5">
              <li>
                <a
                  href="/admin/settings"
                  aria-current={path.startsWith('/admin/settings') ? 'page' : undefined}
                  class={navLinkClass(path.startsWith('/admin/settings'))}
                >
                  <Icon name="settings" class="h-4 w-4 shrink-0" />
                  <span class="min-w-0 truncate">Settings</span>
                </a>
              </li>
            </ul>
          </nav>

          <UserMenu user={user} theme={theme} themeReturnPath={themeReturnPath} path={path} />
          </div>
        </div>
      </header>

      <!-- Main ---------------------------------------------------------- -->
      <div id="admin-content" class="min-w-0 flex-1">
        <main id="main" class="mx-auto max-w-5xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
          {
            breadcrumbs.length > 0 && (
              <nav aria-label="Breadcrumb" class="mb-4">
                <ol class="flex flex-wrap items-center gap-1.5 text-sm text-content-muted">
                  {breadcrumbs.map((crumb, index) => {
                    const last = index === breadcrumbs.length - 1;
                    return (
                      <li class="flex items-center gap-1.5">
                        {index > 0 && <span aria-hidden="true">/</span>}
                        {crumb.href && !last ? (
                          <a href={crumb.href} class="hover:text-content hover:underline">
                            {crumb.label}
                          </a>
                        ) : (
                          <span aria-current={last ? 'page' : undefined} class="text-content">
                            {crumb.label}
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </nav>
            )
          }

          <!--
            Flash messages land in a live region so a save confirmation is announced after the
            post-redirect page load, not just shown visually.
          -->
          <div role="status" aria-live="polite">
            {
              flash && (
                <p class="mb-6 rounded-md border border-accent bg-accent-subtle px-4 py-3 text-sm">
                  {flash}
                </p>
              )
            }
          </div>

          <slot />
        </main>
      </div>
    </div>

    <script>
      /**
       * The navigation drawer, below `lg`.
       *
       * `data-nav` on `<html>` is the state — the third use of that pattern after `data-theme` and
       * `data-preview`, so the CSS reads the same way as the other two. **No cookie**, unlike those:
       * every link in this admin is a real page load, so a drawer that remembered being open would
       * reopen itself on arrival at the page you had just navigated to. Closing on navigation is
       * what a drawer is supposed to do, and here it is free.
       *
       * `inert` on the content column is the part that has to be hand-written and must not be
       * dropped. Without it, tabbing past the last nav link walks invisibly through the page behind
       * the drawer — the exact failure a modal `<dialog>` would have prevented for free, and the
       * price of not being able to use one here.
       */
      const toggle = document.getElementById('nav-toggle');
      const backdrop = document.getElementById('nav-backdrop');
      const content = document.getElementById('admin-content');
      const nav = document.getElementById('admin-nav');
      const root = document.documentElement;

      function setNav(open: boolean) {
        if (open) root.dataset.nav = 'open';
        else delete root.dataset.nav;

        toggle?.setAttribute('aria-expanded', String(open));
        // The top bar sits outside `#admin-content`, so the toggle stays reachable to close it.
        if (content) content.inert = open;

        if (open) {
          // Into the drawer rather than merely near it: opening a menu and landing nowhere is the
          // usual way a hand-built drawer fails a keyboard user.
          nav?.querySelector<HTMLElement>('a, button')?.focus();
        } else {
          toggle?.focus();
        }
      }

      toggle?.addEventListener('click', () => setNav(root.dataset.nav !== 'open'));
      backdrop?.addEventListener('click', () => setNav(false));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && root.dataset.nav === 'open') setNav(false);
      });

      /**
       * Dropped when the viewport grows past the breakpoint.
       *
       * The drawer's CSS stops applying at `lg`, so a stale `data-nav` would leave `inert` on the
       * content column of a perfectly ordinary desktop layout — every control dead, nothing on
       * screen explaining why.
       */
      const wide = window.matchMedia('(min-width: 64rem)');
      wide.addEventListener('change', (event) => {
        if (event.matches && root.dataset.nav === 'open') setNav(false);
      });
    </script>
  </body>
</html>
