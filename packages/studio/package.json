{
  "name": "@taproot/studio",
  "version": "0.0.0",
  "description": "The Taproot CMS server as an Astro integration: admin panel, REST API, and delivery API",
  "license": "MIT",
  "type": "module",
  "//": "This package intentionally ships TypeScript/Astro SOURCE rather than a build. Astro's injectRoute compiles .astro entrypoints out of node_modules through the host's Vite pipeline, which is how Starlight ships its routes. It is the *server* half of Taproot \u2014 a site reads content through @taproot/astro over HTTP and never installs this.",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./admin/*": "./src/admin/*",
    "./api/*": "./src/api/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@taproot/core": "*",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
